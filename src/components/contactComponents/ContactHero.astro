---
import { SITE_CONFIG } from "../../config/site.config";
import Breadcrumbs from "../commonComponents/Breadcrumbs.astro";
---

<div class="municipal-hero municipal-hero--contacto bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 text-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <Breadcrumbs
      items={[
        { href: "/", label: "Inicio" },
        { label: "Contacto" },
      ]}
      className="mb-6"
    />

    <div class="flex items-start gap-4">
      <div class="flex-shrink-0 bg-white/10 p-3.5" aria-hidden="true">
        <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </div>
      <div>
        <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight tracking-tight">Contáctanos</h1>
        <p class="mt-1.5 text-white/60 text-sm sm:text-base max-w-3xl">
          Escríbenos, llámanos o visítanos. Estamos para atender tus consultas, trámites y sugerencias.
        </p>
      </div>
    </div>

    <div class="mt-7 flex flex-wrap items-center gap-6 text-sm border-t border-white/10 pt-5">
      <span class="text-white/50">
        <strong class="text-white font-bold">Atención:</strong> Lun – Vie · 8 – 16 h
      </span>
      <span class="text-white/20">|</span>
      <span class="text-white/50">
        <strong class="text-white font-bold">Teléfono:</strong> {SITE_CONFIG.phone}
      </span>
      <span class="text-white/20">|</span>
      <span class="text-white/50">
        <strong class="text-white font-bold">Respuesta:</strong> 24 – 48 horas
      </span>
    </div>
  </div>
</div>
