---
import { MAIN_NAVIGATION } from '../../../config/navigation.ts';
import { SITE_CONFIG, SOCIAL_LINKS } from '../../../config/site.config.ts';
import { buildFirebasePublicConfig } from "../../api/firebaseConfig";
import noticias from '../../data/noticias.json';
import servicios from '../../data/services.json';
import turismo from '../../data/turismo.json';
import eventos from '../../data/events.json';

const navItems = MAIN_NAVIGATION;
const siteTitle = SITE_CONFIG.title ?? 'Ivochote';
const firebasePublicConfig = buildFirebasePublicConfig(import.meta.env);

interface SearchItem { title: string; description: string; href: string; category: string; }
const searchIndex: SearchItem[] = [
  ...(noticias as { title: string; excerpt?: string; slug: string }[]).map((n) => ({ title: n.title, description: n.excerpt ?? '', href: `/noticias/${n.slug}`, category: 'Noticias' })),
  ...(servicios as { title: string; description?: string; slug: string; id: string }[]).map((s) => ({ title: s.title, description: s.description ?? '', href: `/servicios/${s.slug ?? s.id}`, category: 'Servicios' })),
  ...(turismo as { name: string; description?: string; slug: string }[]).map((t) => ({ title: t.name, description: t.description ?? '', href: `/turismo/${t.slug}`, category: 'Turismo' })),
  ...(eventos as { title: string; description?: string; slug?: string; id: string }[]).map((e) => ({ title: e.title, description: e.description ?? '', href: `/eventos/${e.slug ?? e.id}`, category: 'Eventos' })),
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 is-solid">

<!-- ===== TOP BAR — Verde sólido con dirección + redes (oculto en móvil) ===== -->
<div id="top-bar" class="hidden sm:block bg-primary-600 text-white">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-9">
    <div class="flex items-center gap-2 text-[13px] font-normal truncate">
      <svg class="w-4 h-4 text-yellow-300 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>
      <span class="truncate">{SITE_CONFIG.address}</span>
    </div>
    <div class="hidden sm:flex items-center gap-0.5">
      <a href={`mailto:${SITE_CONFIG.email}`} aria-label="Correo electrónico" class="flex items-center justify-center w-9 h-9 text-white/80 hover:text-white transition-colors">
        <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </a>
      {SOCIAL_LINKS.facebook && (
        <a href={SOCIAL_LINKS.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex items-center justify-center w-9 h-9 text-white/80 hover:text-white transition-colors">
          <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/></svg>
        </a>
      )}
      {SOCIAL_LINKS.tiktok && (
        <a href={SOCIAL_LINKS.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="flex items-center justify-center w-9 h-9 text-white/80 hover:text-white transition-colors">
          <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1 0-5.78 2.92 2.92 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.64 6.33 6.33 0 0 0 9.37 22a6.33 6.33 0 0 0 6.38-6.36V9.25a8.16 8.16 0 0 0 4.84 1.58V7.38a4.85 4.85 0 0 1-1-.69z"/></svg>
        </a>
      )}
    </div>
  </div>
</div>

<!-- ===== NAVBAR — Semi-transparente verde oscuro sobre hero (estilo Megantoni) ===== -->
<nav id="main-nav" class="transition-all duration-300" role="navigation" aria-label="Navegación principal">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[68px] lg:h-[76px]">

      <!-- Logo + nombre institucional -->
      <a href="/" class="flex items-center gap-3 flex-shrink-0 group">
        <img
          src="/assets/images/brand/logoivo.png"
          alt={`${siteTitle} — Escudo institucional`}
          class="h-11 lg:h-[52px] w-auto object-contain transition-transform duration-200 group-hover:scale-[1.03]"
          loading="eager"
        />
        <div class="logo-divider border-l-2 pl-3 transition-colors duration-300">
          <p class="logo-sub text-[9px] lg:text-[10px] font-medium leading-tight tracking-wider uppercase transition-colors duration-300">Municipalidad del</p>
          <p class="logo-sub text-[9px] lg:text-[10px] font-medium leading-tight tracking-wider uppercase transition-colors duration-300">Centro Poblado</p>
          <p class="logo-main text-sm lg:text-[17px] font-extrabold leading-tight tracking-tight uppercase transition-colors duration-300">Ivochote</p>
        </div>
      </a>

      <!-- Desktop: links centrados + iconos derecha -->
      <div class="hidden lg:flex items-center gap-0.5">
        {navItems.map((item) => (
          item.children && item.children.length > 0 ? (
            <div class="nav-dropdown-wrapper relative" data-dropdown>
              <button
                type="button"
                data-href={item.href}
                class="nav-link desktop-link relative px-3 xl:px-4 py-2 text-[12px] font-extrabold uppercase tracking-[0.08em] transition-colors duration-300 flex items-center gap-1"
                aria-expanded="false"
                aria-haspopup="true"
              >
                {item.label}
                <svg class="dropdown-chevron w-3 h-3 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div class="nav-dropdown absolute top-full left-1/2 pt-2 opacity-0 invisible transition-all duration-300 ease-out pointer-events-none">
                <div class="bg-white shadow-xl shadow-black/10 min-w-[260px] overflow-hidden">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      data-href={child.href}
                      class="nav-link dropdown-item block px-5 py-3 text-[11px] font-bold text-black dropdown-stagger"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              data-href={item.href}
              class="nav-link desktop-link relative px-3 xl:px-4 py-2 text-[12px] font-extrabold uppercase tracking-[0.08em] transition-colors duration-300"
            >
              {item.label}
            </a>
          )
        ))}

        <!-- Separador -->
        <div class="nav-separator w-px h-6 mx-2 transition-colors duration-300"></div>

        <!-- Lupa de búsqueda -->
        <button id="search-toggle" type="button" aria-label="Buscar" class="nav-icon flex items-center justify-center w-9 h-9 rounded-full transition-all duration-200">
          <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
        </button>

        <!-- Icono usuario -->
        <a
          href="/login"
          aria-label="Acceso ciudadano"
          class="nav-icon flex items-center justify-center w-9 h-9 rounded-full transition-all duration-200"
        >
          <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/></svg>
        </a>

        <!-- Separador -->
        <div class="nav-separator w-px h-6 mx-1 transition-colors duration-300"></div>

        <!-- Portal de Transparencia Estándar (estilo Megantoni) -->
        <a href="/transparencia" class="pte-link flex items-center gap-2.5 ml-1 py-1.5 rounded-lg transition-all duration-300 group" aria-label="Portal de Transparencia Estándar">
          <span class="pte-text leading-tight text-right">
            <span class="block text-[10px] font-normal italic">Portal de</span>
            <span class="block text-[15px] font-extrabold leading-none tracking-tight">Transparencia</span>
            <span class="block text-[8px] font-normal tracking-[0.12em]">estándar</span>
          </span>
          <span class="pte-badge flex items-center justify-center w-9 h-9 rounded-full transition-all duration-300">
            <svg class="w-full h-full" viewBox="0 0 40 40" fill="none">
              <circle cx="20" cy="20" r="19" stroke="currentColor" stroke-width="2" fill="currentColor" fill-opacity="0.15"/>
              <text x="20" y="23" text-anchor="middle" font-size="12" font-weight="bold" font-style="italic" fill="currentColor">pte</text>
            </svg>
          </span>
        </a>
      </div>

      <!-- Mobile: lupa + usuario + hamburger -->
      <div class="flex lg:hidden items-center gap-0.5">
        <button id="search-toggle-mobile" type="button" aria-label="Buscar" class="nav-hamburger w-10 h-10 flex items-center justify-center rounded-lg transition-colors duration-300">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
        </button>
        <a
          href="/login"
          aria-label="Acceso ciudadano"
          class="nav-hamburger w-10 h-10 flex items-center justify-center rounded-lg transition-colors duration-300"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/></svg>
        </a>
        <button id="nav-toggle" aria-expanded="false" aria-controls="mobile-menu" class="nav-hamburger w-10 h-10 flex items-center justify-center rounded-lg focus:outline-none focus:ring-2 focus:ring-white/50 transition-colors duration-300">
          <span class="sr-only">Abrir menú</span>
          <div class="w-5 h-4 relative flex flex-col justify-between">
            <span class="hamburger-line block h-0.5 w-full bg-current rounded transition-all duration-300 origin-center"></span>
            <span class="hamburger-line block h-0.5 w-full bg-current rounded transition-all duration-300 origin-center"></span>
            <span class="hamburger-line block h-0.5 w-full bg-current rounded transition-all duration-300 origin-center"></span>
          </div>
        </button>
      </div>
    </div>
  </div>

  <!-- Barra de búsqueda expandible — reemplazada por overlay -->
</nav>

<!-- Search overlay fullscreen -->
<div id="search-overlay" class="fixed inset-0 z-[300] flex flex-col" style="opacity:0; pointer-events:none; transition: opacity 0.25s ease;" aria-modal="true" role="dialog" aria-label="Buscador">
  <!-- Fondo oscuro -->
  <div class="absolute inset-0 bg-black/75 backdrop-blur-sm"></div>
  <!-- Barra superior con logo y cerrar -->
  <div class="relative z-10 flex items-center justify-between h-[72px] px-5 sm:px-8 lg:px-12 bg-white/5">
    <span class="text-white font-bold text-lg tracking-wide">Buscar</span>
    <button id="search-close" type="button" aria-label="Cerrar búsqueda" class="flex items-center justify-center w-10 h-10 text-white/70 hover:text-white transition-colors">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>
  <!-- Input centrado -->
  <div class="relative z-10 flex-1 flex flex-col items-center justify-start pt-10 sm:pt-14 px-5 sm:px-8">
    <form id="search-form" class="w-full max-w-3xl" onsubmit="return false;">
      <div class="flex items-stretch shadow-2xl">
        <div class="relative flex-1">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
          <input
            id="search-input"
            type="search"
            placeholder="Buscar..."
            autocomplete="off"
            class="w-full h-14 sm:h-16 pl-12 pr-4 text-base sm:text-lg text-gray-900 bg-white placeholder-gray-400 border-0 focus:outline-none focus:ring-0"
          />
        </div>
        <button type="submit" class="px-6 sm:px-8 h-14 sm:h-16 bg-primary-600 hover:bg-primary-500 text-white text-sm sm:text-base font-bold uppercase tracking-wider transition-colors duration-200 flex items-center gap-2 flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
          <span class="hidden sm:inline">Buscar</span>
        </button>
      </div>
      <p class="mt-3 hidden sm:block text-white/50 text-sm text-center">Presiona <kbd class="px-1.5 py-0.5 text-xs bg-white/10 rounded text-white/70">Esc</kbd> para cerrar</p>
    </form>
    <!-- Resultados -->
    <div id="search-results" class="w-full max-w-3xl mt-4 overflow-y-auto max-h-[55vh] hidden"></div>
  </div>
</div>

<!-- Mobile menu — FUERA del nav, panel blanco sólido fullscreen -->
<div id="mobile-menu" class="lg:hidden fixed inset-0 z-[200] bg-white overflow-y-auto" style="transform: translateX(100%); transition: transform 0.3s ease-in-out;">
  <!-- Header con flecha atrás -->
  <div class="flex items-center h-16 px-5 border-b border-gray-100">
    <button id="mobile-close" type="button" aria-label="Cerrar menú" class="flex items-center justify-center w-10 h-10 text-primary-700 hover:text-primary-500 transition-colors">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7"/></svg>
    </button>
  </div>
  <!-- Links -->
  <nav class="px-5 pt-6 space-y-0">
    {navItems.map((item) => (
      item.children && item.children.length > 0 ? (
        <div class="mobile-accordion border-b border-gray-100" data-accordion>
          <button
            type="button"
            class="mobile-accordion-toggle flex items-center justify-between w-full py-4 text-[15px] sm:text-base font-bold uppercase tracking-wide text-primary-800 hover:text-primary-600 transition-colors duration-200"
            aria-expanded="false"
          >
            {item.label}
            <svg class="accordion-chevron w-4 h-4 text-primary-500 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="accordion-panel overflow-hidden" style="max-height: 0; transition: max-height 0.3s ease-in-out;">
            <div class="pb-3 pl-4 space-y-0.5">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  data-href={child.href}
                  class="nav-link mobile-sub-link flex items-center gap-2.5 py-2.5 text-[14px] font-medium text-primary-700 hover:text-primary-500 transition-colors duration-150"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-primary-300 flex-shrink-0"></span>
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <a
          href={item.href}
          data-href={item.href}
          class="nav-link mobile-link flex items-center justify-between py-4 border-b border-gray-100 text-[15px] sm:text-base font-bold uppercase tracking-wide text-primary-800 hover:text-primary-600 transition-colors duration-200"
        >
          {item.label}
          <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      )
    ))}
  </nav>
</div>

<!-- Auth overlay -->
<div
  id="auth-overlay"
  class="fixed inset-0 z-[320] hidden items-center justify-center p-4 sm:p-6"
  aria-modal="true"
  role="dialog"
  aria-labelledby="auth-title"
>
  <div class="absolute inset-0 bg-black/75 backdrop-blur-sm" data-auth-close="true"></div>
  <div id="auth-panel" class="relative w-full max-w-md border border-gray-200 bg-white shadow-2xl" tabindex="-1">
    <div class="flex items-center justify-between border-b border-gray-100 px-5 py-4 sm:px-6">
      <h2 id="auth-title" class="text-base sm:text-lg font-bold text-primary-900">Acceso Ciudadano</h2>
      <button
        id="auth-close"
        type="button"
        aria-label="Cerrar acceso ciudadano"
        class="inline-flex h-9 w-9 items-center justify-center text-gray-500 hover:text-gray-700 hover:bg-gray-100 transition-colors"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="space-y-4 px-5 py-5 sm:px-6">
      <div id="auth-user" class="hidden items-center gap-3 rounded-md bg-primary-50 p-3">
        <img id="auth-user-avatar" src="" alt="" class="h-10 w-10 flex-shrink-0 bg-primary-100 object-cover" />
        <div class="min-w-0">
          <p id="auth-user-name" class="truncate text-sm font-semibold text-primary-900"></p>
          <p id="auth-user-email" class="truncate text-xs text-primary-800/70"></p>
        </div>
      </div>

      <div id="auth-guest-panel" class="space-y-4">
        <div class="grid grid-cols-2 border border-gray-200">
          <button id="auth-mode-login" type="button" class="bg-primary-600 px-3 py-2 text-sm font-bold text-white">Iniciar sesión</button>
          <button id="auth-mode-register" type="button" class="bg-white px-3 py-2 text-sm font-bold text-primary-900">Registrarse</button>
        </div>

        <button
          id="auth-google-btn"
          type="button"
          class="w-full border border-gray-300 bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
        >
          Continuar con Google
        </button>

        <form id="auth-email-form" class="space-y-3" novalidate>
          <div id="auth-name-wrap" class="hidden">
            <label for="auth-name" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-gray-600">Nombre completo</label>
            <input
              id="auth-name"
              name="name"
              type="text"
              autocomplete="name"
              class="block w-full border border-gray-200 bg-gray-50 px-3 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-400"
              placeholder="Ejemplo: Juan Pérez Quispe"
            />
          </div>

          <div>
            <label for="auth-email" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-gray-600">Correo electrónico</label>
            <input
              id="auth-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              class="block w-full border border-gray-200 bg-gray-50 px-3 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-400"
              placeholder="nombre@correo.com"
            />
          </div>

          <div>
            <label for="auth-password" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-gray-600">Contraseña</label>
            <input
              id="auth-password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              minlength="8"
              class="block w-full border border-gray-200 bg-gray-50 px-3 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-400"
              placeholder="Mínimo 8 caracteres"
            />
          </div>

          <div id="auth-confirm-wrap" class="hidden">
            <label for="auth-confirm-password" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-gray-600">Confirmar contraseña</label>
            <input
              id="auth-confirm-password"
              name="confirmPassword"
              type="password"
              autocomplete="new-password"
              minlength="8"
              class="block w-full border border-gray-200 bg-gray-50 px-3 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-400"
              placeholder="Repite tu contraseña"
            />
          </div>

          <button
            id="auth-submit"
            type="submit"
            class="w-full bg-primary-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-primary-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
          >
            Iniciar sesión
          </button>
        </form>

        <button id="auth-reset-password" type="button" class="text-xs font-semibold text-primary-700 hover:text-primary-600">
          ¿Olvidaste tu contraseña?
        </button>
      </div>

      <button
        id="auth-signout"
        type="button"
        class="hidden w-full border border-gray-300 bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
      >
        Cerrar sesión
      </button>

      <p id="auth-status" class="text-sm text-gray-600">
        Inicia sesión con Google o con tu correo para personalizar tu experiencia.
      </p>
    </div>
  </div>
</div>

</header>

<script define:vars={{ searchIndex, firebasePublicConfig }}>
  window.__SEARCH_INDEX__ = searchIndex;
  window.__FIREBASE_CONFIG__ = firebasePublicConfig;
</script>

<script>
    (function () {
      try {
        var header = document.getElementById('site-header');
        var topBar = document.getElementById('top-bar');
        var toggle = document.getElementById('nav-toggle') as HTMLElement | null;
        var mobile = document.getElementById('mobile-menu') as HTMLElement | null;
        var lines = document.querySelectorAll<HTMLElement>('.hamburger-line');
        var hasHero = !!document.getElementById('hero-carousel');
        var mobileOpen = false;
        var topBarVisible = true;

        function setSolid() { if (header) header.classList.add('is-solid'); }
        function setTransparent() { if (header) header.classList.remove('is-solid'); }

        function applyContentPadding() {
          var c = document.getElementById('content');
          if (!c || hasHero) return;
          var sm = window.innerWidth >= 640;
          var lg = window.innerWidth >= 1024;
          c.style.paddingTop = ((lg ? 76 : 68) + (topBarVisible && sm ? 36 : 0)) + 'px';
        }

        function hideTopBar() {
          if (topBar) topBar.classList.add('top-bar-hidden');
          topBarVisible = false;
          applyContentPadding();
        }
        function showTopBar() {
          if (topBar) topBar.classList.remove('top-bar-hidden');
          topBarVisible = true;
          applyContentPadding();
        }

        var solidThreshold = 1;

        function updateNavState() {
          if (mobileOpen) { setSolid(); return; }
          if (!hasHero) {
            setSolid();
            if (window.scrollY > 80) { hideTopBar(); } else { showTopBar(); }
            return;
          }
          if (window.scrollY >= solidThreshold) { setSolid(); } else { setTransparent(); }
          if (window.scrollY > 80) { hideTopBar(); } else { showTopBar(); }
        }

        if (hasHero && window.scrollY < solidThreshold) { setTransparent(); }
        window.addEventListener('scroll', updateNavState, { passive: true });

        if (toggle && mobile) {
          var _toggle = toggle;
          var _mobile = mobile;
          var closeBtn = document.getElementById('mobile-close') as HTMLElement | null;

          function openMenu() {
            mobileOpen = true;
            _toggle.setAttribute('aria-expanded', 'true');
            _mobile.style.transform = 'translateX(0)';
            document.body.style.overflow = 'hidden';
            if (lines.length === 3) {
              lines[0].style.transform = 'translateY(7px) rotate(45deg)';
              lines[1].style.opacity = '0';
              lines[2].style.transform = 'translateY(-7px) rotate(-45deg)';
            }
            updateNavState();
          }

          function closeMenu() {
            mobileOpen = false;
            _toggle.setAttribute('aria-expanded', 'false');
            _mobile.style.transform = 'translateX(100%)';
            document.body.style.overflow = '';
            if (lines.length === 3) {
              lines[0].style.transform = '';
              lines[1].style.opacity = '1';
              lines[2].style.transform = '';
            }
            updateNavState();
          }

          _toggle.addEventListener('click', function () {
            if (mobileOpen) { closeMenu(); } else { openMenu(); }
          });

          if (closeBtn) {
            closeBtn.addEventListener('click', closeMenu);
          }

          /* Close on link click (only non-accordion links and sub-links) */
          _mobile.querySelectorAll('a').forEach(function(link) {
            link.addEventListener('click', closeMenu);
          });

          /* Mobile accordions */
          _mobile.querySelectorAll('[data-accordion]').forEach(function(acc) {
            var _btn = acc.querySelector('.mobile-accordion-toggle') as HTMLElement | null;
            var _panel = acc.querySelector('.accordion-panel') as HTMLElement | null;
            var _chevron = acc.querySelector('.accordion-chevron') as HTMLElement | null;
            if (!_btn || !_panel) return;
            var accBtn = _btn;
            var accPanel = _panel;
            var accChevron = _chevron;
            accBtn.addEventListener('click', function() {
              var isOpen = accBtn.getAttribute('aria-expanded') === 'true';
              /* Close all other accordions first */
              _mobile.querySelectorAll('[data-accordion]').forEach(function(other) {
                if (other === acc) return;
                var oBtn = other.querySelector('.mobile-accordion-toggle');
                var oPanel = other.querySelector('.accordion-panel') as HTMLElement | null;
                var oChevron = other.querySelector('.accordion-chevron') as HTMLElement | null;
                if (oBtn) oBtn.setAttribute('aria-expanded', 'false');
                if (oPanel) oPanel.style.maxHeight = '0';
                if (oChevron) oChevron.style.transform = '';
              });
              if (isOpen) {
                accBtn.setAttribute('aria-expanded', 'false');
                accPanel.style.maxHeight = '0';
                if (accChevron) accChevron.style.transform = '';
              } else {
                accBtn.setAttribute('aria-expanded', 'true');
                accPanel.style.maxHeight = accPanel.scrollHeight + 'px';
                if (accChevron) accChevron.style.transform = 'rotate(180deg)';
              }
            });
          });
        }

        /* Search overlay */
        var searchOverlay = document.getElementById('search-overlay');
        var searchInput = document.getElementById('search-input') as HTMLInputElement | null;
        var searchClose = document.getElementById('search-close');
        var searchResults = document.getElementById('search-results');
        var searchOpen = false;
        var authOverlay = document.getElementById('auth-overlay') as HTMLElement | null;
        var authPanel = document.getElementById('auth-panel') as HTMLElement | null;
        var authToggleDesktop = document.getElementById('auth-toggle') as HTMLButtonElement | null;
        var authToggleMobile = document.getElementById('auth-toggle-mobile') as HTMLButtonElement | null;
        var authCloseBtn = document.getElementById('auth-close') as HTMLButtonElement | null;
        var authGuestPanel = document.getElementById('auth-guest-panel');
        var authModeLoginBtn = document.getElementById('auth-mode-login') as HTMLButtonElement | null;
        var authModeRegisterBtn = document.getElementById('auth-mode-register') as HTMLButtonElement | null;
        var authEmailForm = document.getElementById('auth-email-form') as HTMLFormElement | null;
        var authNameWrap = document.getElementById('auth-name-wrap');
        var authNameInput = document.getElementById('auth-name') as HTMLInputElement | null;
        var authEmailInput = document.getElementById('auth-email') as HTMLInputElement | null;
        var authPasswordInput = document.getElementById('auth-password') as HTMLInputElement | null;
        var authConfirmWrap = document.getElementById('auth-confirm-wrap');
        var authConfirmInput = document.getElementById('auth-confirm-password') as HTMLInputElement | null;
        var authSubmitBtn = document.getElementById('auth-submit') as HTMLButtonElement | null;
        var authGoogleBtn = document.getElementById('auth-google-btn') as HTMLButtonElement | null;
        var authResetPasswordBtn = document.getElementById('auth-reset-password') as HTMLButtonElement | null;
        var authStatus = document.getElementById('auth-status');
        var authUser = document.getElementById('auth-user');
        var authUserName = document.getElementById('auth-user-name');
        var authUserEmail = document.getElementById('auth-user-email');
        var authUserAvatar = document.getElementById('auth-user-avatar') as HTMLImageElement | null;
        var authSignoutBtn = document.getElementById('auth-signout') as HTMLButtonElement | null;
        var firebaseConfigValue = (window as any).__FIREBASE_CONFIG__ || {};
        var authOpen = false;
        var authMode: 'login' | 'register' = 'login';
        var firebaseInitialized = false;
        var firebaseInitPromise: Promise<void> | null = null;
        var firebaseAuth: any = null;
        var firebaseAuthApi: any = null;
        var firebaseCurrentUser: any = null;

        /* Índice de búsqueda inyectado desde Astro */
        var INDEX: Array<{title:string;description:string;href:string;category:string}> = (window as any).__SEARCH_INDEX__ || [];

        function openSearch() {
          if (!searchOverlay) return;
          searchOpen = true;
          searchOverlay.style.opacity = '1';
          searchOverlay.style.pointerEvents = 'auto';
          document.body.style.overflow = 'hidden';
          setTimeout(function() { if (searchInput) searchInput.focus(); }, 50);
        }
        function closeSearch() {
          if (!searchOverlay) return;
          searchOpen = false;
          searchOverlay.style.opacity = '0';
          searchOverlay.style.pointerEvents = 'none';
          document.body.style.overflow = '';
          if (searchInput) searchInput.value = '';
          if (searchResults) {
            searchResults.replaceChildren();
            searchResults.classList.add('hidden');
          }
        }

        function hasFirebaseConfig(config: Record<string, string>): boolean {
          return Boolean(config.apiKey && config.authDomain && config.projectId && config.appId);
        }

        function setAuthStatus(message: string, tone: 'neutral' | 'success' | 'error' = 'neutral') {
          if (!authStatus) return;
          authStatus.textContent = message;
          if (tone === 'success') {
            authStatus.className = 'text-sm text-green-700';
            return;
          }
          if (tone === 'error') {
            authStatus.className = 'text-sm text-red-700';
            return;
          }
          authStatus.className = 'text-sm text-gray-600';
        }

        function extractFirebaseAuthCode(error: any): string {
          var candidates = [String(error?.code || ''), String(error?.message || '')];
          for (var i = 0; i < candidates.length; i += 1) {
            var match = candidates[i].toLowerCase().match(/auth\/[a-z0-9-]+/);
            if (match && match[0]) return match[0];
          }
          return '';
        }

        function normalizeFirebaseError(error: any): string {
          var code = extractFirebaseAuthCode(error);
          switch (code) {
            case 'auth/operation-not-allowed':
              return 'Correo/contraseña no está habilitado en Firebase Authentication.';
            case 'auth/configuration-not-found':
              return 'Firebase Authentication no está configurado en este proyecto.';
            case 'auth/invalid-api-key':
            case 'auth/api-key-not-valid':
              return 'La API key de Firebase es inválida o fue eliminada. Actualiza PUBLIC_FIREBASE_API_KEY con la clave Web correcta.';
            case 'auth/app-not-authorized':
            case 'auth/unauthorized-domain':
              return 'Dominio no autorizado. Agrega localhost en Authorized domains de Firebase.';
            case 'auth/invalid-credential':
            case 'auth/wrong-password':
            case 'auth/user-not-found':
              return 'Correo o contraseña incorrectos.';
            case 'auth/email-already-in-use':
              return 'Este correo ya está registrado.';
            case 'auth/invalid-email':
              return 'El correo electrónico no es válido.';
            case 'auth/weak-password':
              return 'La contraseña es muy débil. Usa al menos 8 caracteres.';
            case 'auth/popup-closed-by-user':
              return 'Se cerró la ventana de Google antes de completar el acceso.';
            case 'auth/popup-blocked':
            case 'auth/cancelled-popup-request':
              return 'El navegador bloqueó la ventana de Google. Habilita pop-ups o usa el acceso por redirección.';
            case 'auth/network-request-failed':
              return 'Sin conexión. Verifica tu internet e intenta nuevamente.';
            case 'auth/too-many-requests':
              return 'Demasiados intentos. Espera unos minutos e inténtalo otra vez.';
            default:
              return 'No se pudo completar la autenticación. Intenta nuevamente.';
          }
        }

        function setAuthLoading(isLoading: boolean) {
          if (authSubmitBtn) {
            authSubmitBtn.disabled = isLoading;
            authSubmitBtn.textContent = isLoading
              ? (authMode === 'register' ? 'Creando cuenta...' : 'Iniciando sesión...')
              : (authMode === 'register' ? 'Crear cuenta' : 'Iniciar sesión');
          }
          if (authGoogleBtn) {
            authGoogleBtn.disabled = isLoading;
            authGoogleBtn.textContent = isLoading ? 'Procesando...' : 'Continuar con Google';
          }
          if (authResetPasswordBtn) authResetPasswordBtn.disabled = isLoading;
        }

        function updateAuthToggleState(user: any | null) {
          [authToggleDesktop, authToggleMobile].forEach(function(btn) {
            if (!btn) return;
            btn.classList.toggle('is-authenticated', !!user);
            var userName = user?.displayName || user?.email || 'Usuario';
            var label = user ? ('Sesión activa: ' + userName) : 'Acceso ciudadano';
            btn.setAttribute('aria-label', label);
            btn.title = user ? userName : 'Acceso ciudadano';
          });
        }

        function setAuthMode(mode: 'login' | 'register') {
          authMode = mode;
          if (authModeLoginBtn && authModeRegisterBtn) {
            if (mode === 'register') {
              authModeRegisterBtn.className = 'bg-primary-600 px-3 py-2 text-sm font-bold text-white';
              authModeLoginBtn.className = 'bg-white px-3 py-2 text-sm font-bold text-primary-900';
            } else {
              authModeLoginBtn.className = 'bg-primary-600 px-3 py-2 text-sm font-bold text-white';
              authModeRegisterBtn.className = 'bg-white px-3 py-2 text-sm font-bold text-primary-900';
            }
          }
          if (authNameWrap) authNameWrap.classList.toggle('hidden', mode !== 'register');
          if (authConfirmWrap) authConfirmWrap.classList.toggle('hidden', mode !== 'register');
          if (authSubmitBtn) authSubmitBtn.textContent = mode === 'register' ? 'Crear cuenta' : 'Iniciar sesión';
          if (authPasswordInput) authPasswordInput.setAttribute('autocomplete', mode === 'register' ? 'new-password' : 'current-password');
          setAuthStatus(
            mode === 'register'
              ? 'Regístrate con tu correo o con Google.'
              : 'Inicia sesión con Google o con tu correo.',
            'neutral',
          );
        }

        function renderAuthPanel(user: any | null) {
          if (authUser && authUserName && authUserEmail && authUserAvatar) {
            if (user) {
              authUser.classList.remove('hidden');
              authUser.classList.add('flex');
              authUserName.textContent = user.displayName || user.email || 'Usuario';
              authUserEmail.textContent = user.email || '';
              authUserAvatar.src = user.photoURL || '/assets/images/brand/logoivo.png';
              authUserAvatar.alt = 'Foto de perfil de ' + (user.displayName || user.email || 'usuario');
            } else {
              authUser.classList.add('hidden');
              authUser.classList.remove('flex');
              authUserName.textContent = '';
              authUserEmail.textContent = '';
              authUserAvatar.src = '';
              authUserAvatar.alt = '';
            }
          }

          if (authGuestPanel) authGuestPanel.classList.toggle('hidden', !!user);
          if (authSignoutBtn) {
            authSignoutBtn.classList.toggle('hidden', !user);
          }
          updateAuthToggleState(user);
        }

        function initializeFirebaseAuth(): Promise<void> {
          if (firebaseInitialized) return Promise.resolve();
          if (firebaseInitPromise) return firebaseInitPromise;

          if (!hasFirebaseConfig(firebaseConfigValue)) {
            setAuthStatus(
              'Falta configurar Firebase en .env (PUBLIC_FIREBASE_API_KEY, AUTH_DOMAIN, PROJECT_ID y APP_ID).',
              'error',
            );
            return Promise.resolve();
          }

          firebaseInitPromise = Promise.all([
            import('firebase/app'),
            import('firebase/auth'),
          ])
            .then(function(modules) {
              var firebaseAppApi = modules[0];
              firebaseAuthApi = modules[1];
              var app = firebaseAppApi.getApps().length
                ? firebaseAppApi.getApp()
                : firebaseAppApi.initializeApp(firebaseConfigValue);
              firebaseAuth = firebaseAuthApi.getAuth(app);
              firebaseAuthApi.setPersistence(firebaseAuth, firebaseAuthApi.browserLocalPersistence).catch(function() {});
              firebaseAuthApi.onAuthStateChanged(firebaseAuth, function(user: any) {
                firebaseCurrentUser = user;
                renderAuthPanel(user);
                if (user) {
                  setAuthStatus('Sesión iniciada correctamente.', 'success');
                } else {
                  setAuthStatus('Inicia sesión con Google o con tu correo para personalizar tu experiencia.', 'neutral');
                }
              });
              firebaseInitialized = true;
            })
            .catch(function(error: any) {
              setAuthStatus(normalizeFirebaseError(error), 'error');
            })
            .finally(function() {
              firebaseInitPromise = null;
            });

          return firebaseInitPromise;
        }

        async function handleGoogleSignIn() {
          await initializeFirebaseAuth();
          if (!firebaseInitialized || !firebaseAuthApi || !firebaseAuth) return;
          var provider = new firebaseAuthApi.GoogleAuthProvider();
          provider.setCustomParameters({ prompt: 'select_account' });

          setAuthLoading(true);
          setAuthStatus('Abriendo Google...', 'neutral');
          try {
            await firebaseAuthApi.signInWithPopup(firebaseAuth, provider);
            setAuthStatus('Sesión iniciada con Google.', 'success');
          } catch (error) {
            var code = extractFirebaseAuthCode(error);
            if (code === 'auth/popup-blocked' || code === 'auth/cancelled-popup-request') {
              setAuthStatus('Popup bloqueado. Redirigiendo a Google...', 'neutral');
              try {
                await firebaseAuthApi.signInWithRedirect(firebaseAuth, provider);
                return;
              } catch (redirectError) {
                setAuthStatus(normalizeFirebaseError(redirectError), 'error');
                return;
              }
            }
            setAuthStatus(normalizeFirebaseError(error), 'error');
          } finally {
            setAuthLoading(false);
          }
        }

        async function handleEmailAuthSubmit(event: SubmitEvent) {
          event.preventDefault();
          await initializeFirebaseAuth();
          if (!firebaseInitialized || !firebaseAuthApi || !firebaseAuth) return;

          var email = (authEmailInput?.value || '').trim();
          var password = authPasswordInput?.value || '';
          var displayName = (authNameInput?.value || '').trim();
          var confirmPassword = authConfirmInput?.value || '';

          if (!email || !password) {
            setAuthStatus('Debes completar correo y contraseña.', 'error');
            return;
          }
          if (password.length < 8) {
            setAuthStatus('La contraseña debe tener al menos 8 caracteres.', 'error');
            return;
          }
          if (authMode === 'register') {
            if (displayName.length < 3) {
              setAuthStatus('Ingresa tu nombre completo (mínimo 3 caracteres).', 'error');
              return;
            }
            if (password !== confirmPassword) {
              setAuthStatus('Las contraseñas no coinciden.', 'error');
              return;
            }
          }

          setAuthLoading(true);
          setAuthStatus(authMode === 'register' ? 'Creando tu cuenta...' : 'Validando credenciales...', 'neutral');

          try {
            if (authMode === 'register') {
              var created = await firebaseAuthApi.createUserWithEmailAndPassword(firebaseAuth, email, password);
              if (displayName) {
                await firebaseAuthApi.updateProfile(created.user, { displayName: displayName });
              }
              await firebaseAuthApi.sendEmailVerification(created.user).catch(function() {});
              setAuthStatus('Cuenta creada. Revisa tu correo para verificarla.', 'success');
            } else {
              await firebaseAuthApi.signInWithEmailAndPassword(firebaseAuth, email, password);
              setAuthStatus('Sesión iniciada correctamente.', 'success');
            }
          } catch (error) {
            setAuthStatus(normalizeFirebaseError(error), 'error');
          } finally {
            setAuthLoading(false);
          }
        }

        async function handleResetPassword() {
          await initializeFirebaseAuth();
          if (!firebaseInitialized || !firebaseAuthApi || !firebaseAuth) return;
          var email = (authEmailInput?.value || '').trim();
          if (!email) {
            setAuthStatus('Ingresa tu correo para enviar la recuperación.', 'error');
            return;
          }
          setAuthLoading(true);
          try {
            await firebaseAuthApi.sendPasswordResetEmail(firebaseAuth, email);
            setAuthStatus('Te enviamos un correo para restablecer tu contraseña.', 'success');
          } catch (error) {
            setAuthStatus(normalizeFirebaseError(error), 'error');
          } finally {
            setAuthLoading(false);
          }
        }

        function openAuth() {
          if (!authOverlay) return;
          if (searchOpen) closeSearch();
          authOpen = true;
          authOverlay.classList.remove('hidden');
          authOverlay.classList.add('flex');
          document.body.style.overflow = 'hidden';
          setAuthMode(firebaseCurrentUser ? authMode : 'login');
          renderAuthPanel(firebaseCurrentUser);
          initializeFirebaseAuth();
          setTimeout(function() {
            if (authPanel) authPanel.focus();
          }, 20);
        }

        function closeAuth() {
          if (!authOverlay) return;
          authOpen = false;
          authOverlay.classList.add('hidden');
          authOverlay.classList.remove('flex');
          document.body.style.overflow = '';
        }

        function escapeHtml(text: string): string {
          return text
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
        }

        function sanitizePath(href: string): string {
          if (!href.startsWith('/')) return '/';
          return href.replace(/"/g, '%22');
        }

        function highlight(text: string, query: string): string {
          const safeText = escapeHtml(text);
          if (!query) return safeText;
          var escapedQuery = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          if (!escapedQuery) return safeText;
          var re = new RegExp('(' + escapedQuery + ')', 'gi');
          return safeText.replace(
            re,
            '<mark class="bg-primary-400/40 text-white rounded px-0.5">$1</mark>',
          );
        }

        function attachSearchResultListeners() {
          if (!searchResults) return;
          searchResults.querySelectorAll<HTMLAnchorElement>('a[data-search-link]').forEach(function(anchor) {
            anchor.addEventListener('click', closeSearch);
          });
        }

        function renderResults(query: string) {
          if (!searchResults) return;
          var q = query.trim().toLowerCase();
          if (q.length < 2) {
            searchResults.replaceChildren();
            searchResults.classList.add('hidden');
            return;
          }
          var hits = INDEX.filter(function(item) {
            return item.title.toLowerCase().includes(q) || item.description.toLowerCase().includes(q);
          }).slice(0, 12);
          if (hits.length === 0) {
            searchResults.innerHTML = '<p class="text-white/50 text-sm text-center py-6">No se encontraron resultados para <strong class="text-white">"' + escapeHtml(query) + '"</strong></p>';
            searchResults.classList.remove('hidden');
            return;
          }
          /* Agrupar por categoría */
          var groups: Record<string, typeof hits> = {};
          hits.forEach(function(item) {
            if (!groups[item.category]) groups[item.category] = [];
            groups[item.category].push(item);
          });
          var html = '';
          Object.keys(groups).forEach(function(cat) {
            html += '<div class="mb-4">';
            html += '<div class="px-4 py-1.5 text-[11px] font-bold uppercase tracking-widest text-primary-400 bg-white/5">' + escapeHtml(cat) + '</div>';
            groups[cat].forEach(function(item) {
              html += '<a href="' + sanitizePath(item.href) + '" data-search-link="true" class="flex items-start gap-3 px-4 py-3 hover:bg-white/10 transition-colors group">';
              html += '<svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-primary-400 group-hover:text-primary-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>';
              html += '<div class="min-w-0">';
              html += '<div class="text-white text-sm font-semibold leading-tight">' + highlight(item.title, query) + '</div>';
              if (item.description) html += '<div class="text-white/50 text-xs mt-0.5 truncate">' + highlight(item.description.substring(0, 100), query) + '</div>';
              html += '</div></a>';
            });
            html += '</div>';
          });
          searchResults.innerHTML = html;
          attachSearchResultListeners();
          searchResults.classList.remove('hidden');
        }

        if (searchInput) {
          searchInput.addEventListener('input', function() { renderResults((searchInput as HTMLInputElement).value); });
        }
        var searchForm = document.getElementById('search-form');
        if (searchForm) searchForm.addEventListener('submit', function(e) { e.preventDefault(); });

        var sb1 = document.getElementById('search-toggle');
        var sb2 = document.getElementById('search-toggle-mobile');
        if (sb1) sb1.addEventListener('click', openSearch);
        if (sb2) sb2.addEventListener('click', openSearch);
        if (searchClose) searchClose.addEventListener('click', closeSearch);
        if (searchOverlay) {
          searchOverlay.addEventListener('click', function(e) {
            if (e.target === searchOverlay || (e.target as HTMLElement).classList.contains('absolute')) closeSearch();
          });
        }
        document.addEventListener('keydown', function(e) {
          if (e.key !== 'Escape') return;
          if (searchOpen) { closeSearch(); return; }
          if (authOpen) closeAuth();
        });

        updateAuthToggleState(firebaseCurrentUser);
        renderAuthPanel(firebaseCurrentUser);
        setAuthMode('login');
        if (authToggleDesktop) authToggleDesktop.addEventListener('click', openAuth);
        if (authToggleMobile) authToggleMobile.addEventListener('click', openAuth);
        if (authCloseBtn) authCloseBtn.addEventListener('click', closeAuth);
        if (authModeLoginBtn) authModeLoginBtn.addEventListener('click', function() { setAuthMode('login'); });
        if (authModeRegisterBtn) authModeRegisterBtn.addEventListener('click', function() { setAuthMode('register'); });
        if (authGoogleBtn) authGoogleBtn.addEventListener('click', handleGoogleSignIn);
        if (authEmailForm) authEmailForm.addEventListener('submit', handleEmailAuthSubmit);
        if (authResetPasswordBtn) authResetPasswordBtn.addEventListener('click', handleResetPassword);
        if (authOverlay) {
          authOverlay.addEventListener('click', function(e) {
            var target = e.target as HTMLElement;
            if (target === authOverlay || target.dataset.authClose === 'true') {
              closeAuth();
            }
          });
        }
        if (authSignoutBtn) {
          authSignoutBtn.addEventListener('click', async function() {
            await initializeFirebaseAuth();
            if (!firebaseInitialized || !firebaseAuthApi || !firebaseAuth) return;
            setAuthLoading(true);
            try {
              await firebaseAuthApi.signOut(firebaseAuth);
              setAuthStatus('Sesión cerrada correctamente.', 'success');
            } catch (error) {
              setAuthStatus(normalizeFirebaseError(error), 'error');
            } finally {
              setAuthLoading(false);
            }
          });
        }

        /* Desktop dropdowns — hover + keyboard */
        document.querySelectorAll('[data-dropdown]').forEach(function(wrapper) {
          var btn = wrapper.querySelector('button') as HTMLElement | null;
          var dd = wrapper.querySelector('.nav-dropdown') as HTMLElement | null;
          var chevron = wrapper.querySelector('.dropdown-chevron') as HTMLElement | null;
          if (!btn || !dd) return;
          var hideTimeout: ReturnType<typeof setTimeout>;

          function showDropdown() {
            clearTimeout(hideTimeout);
            btn!.setAttribute('aria-expanded', 'true');
            dd!.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
            dd!.classList.add('opacity-100', 'visible', 'pointer-events-auto');
            if (chevron) chevron.style.transform = 'rotate(180deg)';
          }

          function hideDropdown() {
            hideTimeout = setTimeout(function() {
              btn!.setAttribute('aria-expanded', 'false');
              dd!.classList.add('opacity-0', 'invisible', 'pointer-events-none');
              dd!.classList.remove('opacity-100', 'visible', 'pointer-events-auto');
              if (chevron) chevron.style.transform = '';
            }, 150);
          }

          wrapper.addEventListener('mouseenter', showDropdown);
          wrapper.addEventListener('mouseleave', hideDropdown);
          btn.addEventListener('click', function() {
            var isOpen = btn!.getAttribute('aria-expanded') === 'true';
            if (isOpen) hideDropdown(); else showDropdown();
          });
          btn.addEventListener('keydown', function(e: KeyboardEvent) {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); showDropdown(); }
            if (e.key === 'Escape') { hideDropdown(); btn!.focus(); }
          });
          dd.addEventListener('keydown', function(e: KeyboardEvent) {
            if (e.key === 'Escape') { hideDropdown(); btn!.focus(); }
          });
        });

        /* Close all dropdowns when clicking outside */
        document.addEventListener('click', function(e) {
          document.querySelectorAll('[data-dropdown]').forEach(function(wrapper) {
            if (!wrapper.contains(e.target as Node)) {
              var btn = wrapper.querySelector('button');
              var dd = wrapper.querySelector('.nav-dropdown');
              var chevron = wrapper.querySelector('.dropdown-chevron') as HTMLElement | null;
              if (btn) btn.setAttribute('aria-expanded', 'false');
              if (dd) { dd.classList.add('opacity-0', 'invisible', 'pointer-events-none'); dd.classList.remove('opacity-100', 'visible', 'pointer-events-auto'); }
              if (chevron) chevron.style.transform = '';
            }
          });
        });

        /* Active links */
        var path = location.pathname;
        document.querySelectorAll('.nav-link').forEach(function (el) {
          var href = el.getAttribute('data-href');
          if (!href) return;
          if (href === path || (href !== '/' && path.startsWith(href))) {
            el.classList.add('is-active');
          }
        });

        /* Close mobile on resize */
        var mql = window.matchMedia('(min-width: 1024px)');
        mql.addEventListener('change', function (e) {
          if (e.matches && mobile) {
            mobileOpen = false;
            (mobile as HTMLElement).style.transform = 'translateX(100%)';
            document.body.style.overflow = '';
            toggle?.setAttribute('aria-expanded', 'false');
            if (lines.length === 3) { (lines[0] as HTMLElement).style.transform = ''; (lines[1] as HTMLElement).style.opacity = '1'; (lines[2] as HTMLElement).style.transform = ''; }
            updateNavState();
          }
        });

        /* Spacer for non-hero pages — top bar visible on load, hidden on scroll */
        if (!hasHero) {
          applyContentPadding();
          window.addEventListener('resize', applyContentPadding, { passive: true });
        }
      } catch (e) { console.error(e); }
    })();
  </script>

