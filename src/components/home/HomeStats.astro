---
interface Props {
  servicesCount: number;
  eventsCount: number;
  placesCount: number;
  educationLevelsCount?: number;
}

const {
  servicesCount,
  eventsCount,
  placesCount,
  educationLevelsCount = 3,
} = Astro.props as Props;
---

<div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 text-center">
  {[
    {
      value: educationLevelsCount,
      label: "Niveles Ed.",
      href: "/contacto",
      svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-9 h-9"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" /></svg>`,
    },
    {
      value: servicesCount,
      label: "Servicios",
      href: "/servicios",
      svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-9 h-9"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" /></svg>`,
    },
    {
      value: eventsCount,
      label: "Eventos",
      href: "/eventos",
      svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-9 h-9"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15zm0 2.25h.008v.008H12v-.008zM9.75 15h.008v.008H9.75V15zm0 2.25h.008v.008H9.75v-.008zM7.5 15h.008v.008H7.5V15zm0 2.25h.008v.008H7.5v-.008zm6.75-4.5h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V15zm0 2.25h.008v.008h-.008v-.008zm2.25-4.5h.008v.008H16.5v-.008zm0 2.25h.008v.008H16.5V15z" /></svg>`,
    },
    {
      value: placesCount,
      label: "Destinos",
      href: "/turismo",
      svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-9 h-9"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>`,
    },
  ].map((stat) => (
    <a
      href={stat.href}
      class="stat-card group flex flex-col items-center gap-2 p-5 cursor-pointer no-underline border border-white/15 hover:border-amber-400/70 transition-all duration-300 hover:-translate-y-1 hover:bg-white/8 backdrop-blur-sm"
      aria-label={`Ver ${stat.label}`}
    >
      <span class="text-white/80 transition-colors duration-300 group-hover:text-amber-400" aria-hidden="true">
        <Fragment set:html={stat.svg} />
      </span>
      <span
        class="stat-number text-4xl sm:text-5xl font-black text-white leading-none transition-colors duration-300 group-hover:text-amber-400"
        data-target={stat.value}
      >0</span>
      <span class="text-[11px] sm:text-xs font-bold text-white/60 uppercase tracking-widest transition-colors duration-300 group-hover:text-amber-300">
        {stat.label}
      </span>
      <span class="block h-[2px] w-0 bg-amber-400 transition-all duration-500 group-hover:w-3/4" aria-hidden="true"></span>
    </a>
  ))}
</div>

<script>
  (function () {
    function animateCounter(el: HTMLElement, target: number, duration: number) {
      const start = performance.now();
      const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

      function step(now: number) {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        el.textContent = String(Math.round(easeOut(progress) * target));
        if (progress < 1) requestAnimationFrame(step);
      }

      requestAnimationFrame(step);
    }

    const section = document.getElementById("stats-section");
    if (!section) return;

    let triggered = false;
    const observer = new IntersectionObserver(
      (entries) => {
        if (triggered) return;
        const entry = entries[0];
        if (!entry.isIntersecting) return;

        triggered = true;
        observer.disconnect();
        section.querySelectorAll<HTMLElement>(".stat-number").forEach((el) => {
          const target = parseInt(el.dataset.target ?? "0", 10);
          animateCounter(el, target, 1600);
        });
      },
      { threshold: 0.3 },
    );

    observer.observe(section);
  })();
</script>
