---
import type { News } from "../../types/news";

interface Props {
  news: News[];
}

const { news } = Astro.props as Props;

const formatDate = (value: string) => {
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  return date.toLocaleDateString("es-PE", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
};
---

{news.length > 0 ? (
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {news.slice(0, 3).map((item) => (
      <a
        href={`/noticias/${item.slug}`}
        class="news-home-card group bg-white border border-gray-200 overflow-hidden flex flex-col no-underline transition-all duration-300"
      >
        {item.image ? (
          <div class="overflow-hidden bg-primary-50" style="aspect-ratio:16/9">
            <img
              src={item.image}
              alt={item.title}
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              loading="lazy"
              decoding="async"
            />
          </div>
        ) : (
          <div class="bg-primary-100 flex items-center justify-center" style="aspect-ratio:16/9">
            <svg class="w-8 h-8 text-primary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
          </div>
        )}
        <div class="p-5 flex flex-col flex-1">
          {item.category && (
            <span class="text-[10px] font-bold uppercase tracking-widest text-primary-600 mb-2">{item.category}</span>
          )}
          <h3 class="font-extrabold text-primary-900 text-sm sm:text-base leading-snug group-hover:text-primary-700 transition-colors line-clamp-2 flex-1">
            {item.title}
          </h3>
          <time class="text-xs text-primary-900/40 mt-3 block font-medium" datetime={item.date}>
            {formatDate(item.date)}
          </time>
        </div>
        <div class="h-[3px] bg-primary-600 scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300" aria-hidden="true"></div>
      </a>
    ))}
  </div>
) : (
  <p class="text-sm text-primary-900/50 text-center">No hay noticias disponibles.</p>
)}
