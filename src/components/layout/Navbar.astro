---
import { MAIN_NAVIGATION } from '../../../config/navigation.ts';
import { SITE_CONFIG, SOCIAL_LINKS } from '../../../config/site.config.ts';

interface NavItem {
  href: string;
  label?: string;
  labelText?: string;
}

const navItems = (MAIN_NAVIGATION as unknown) as NavItem[];
const navLinks = navItems.filter((item: NavItem) => (item.label ?? item.labelText) !== 'Contacto');
const ctaItem = navItems.find((item: NavItem) => (item.label ?? item.labelText) === 'Contacto');
const siteTitle = SITE_CONFIG.title ?? 'Ivochote';
---

<!-- Top bar: contacto rápido (solo desktop) -->
<div class="hidden lg:block bg-primary-950 text-primary-100/70 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-8">
    <div class="flex items-center gap-5">
      <a href={`tel:${SITE_CONFIG.phone}`} class="flex items-center gap-1.5 hover:text-primary-300 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        {SITE_CONFIG.phone}
      </a>
      <a href={`mailto:${SITE_CONFIG.email}`} class="flex items-center gap-1.5 hover:text-primary-300 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        {SITE_CONFIG.email}
      </a>
    </div>
    <div class="flex items-center gap-3">
      {SOCIAL_LINKS.facebook && (
        <a href={SOCIAL_LINKS.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="hover:text-primary-300 transition-colors">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/></svg>
        </a>
      )}
      {SOCIAL_LINKS.tiktok && (
        <a href={SOCIAL_LINKS.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="hover:text-primary-300 transition-colors">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1 0-5.78 2.92 2.92 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.64 6.33 6.33 0 0 0 9.37 22a6.33 6.33 0 0 0 6.38-6.36V9.25a8.16 8.16 0 0 0 4.84 1.58V7.38a4.85 4.85 0 0 1-1-.69z"/></svg>
        </a>
      )}
    </div>
  </div>
</div>

<!-- Navbar principal -->
<nav id="main-nav" class="bg-primary-900 sticky top-0 z-50 transition-shadow duration-300" role="navigation" aria-label="Navegación principal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-[72px]">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 flex-shrink-0 group">
        <img
          src="/assets/images/brand/logoivo.png"
          alt={`${siteTitle} logo`}
          class="h-11 lg:h-14 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
          loading="eager"
        />
      </a>

      <!-- Desktop nav -->
      <div class="hidden lg:flex items-center gap-1">
        {navLinks.map((item: NavItem) => (
          <a
            href={item.href}
            data-href={item.href}
            class="nav-link relative px-3 xl:px-4 py-2 text-sm font-medium text-primary-100/80 hover:text-white transition-colors duration-200 rounded-md hover:bg-white/10"
          >
            {item.label ?? item.labelText}
            <span class="nav-indicator absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-primary-300 rounded-full transition-all duration-300"></span>
          </a>
        ))}

        {/* CTA Contáctanos */}
        {ctaItem && (
          <a
            href={ctaItem.href}
            data-href={ctaItem.href}
            class="nav-link ml-3 inline-flex items-center gap-2 px-5 py-2 bg-primary-300 text-primary-900 text-sm font-semibold rounded-full hover:bg-primary-200 transition-all duration-200 hover:shadow-lg hover:shadow-primary-300/20"
          >
            {ctaItem.label ?? ctaItem.labelText}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        )}
      </div>

      <!-- Mobile: hamburger -->
      <button
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="lg:hidden relative w-10 h-10 flex items-center justify-center rounded-lg text-primary-100 hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-primary-300 transition-colors"
      >
        <span class="sr-only">Abrir menú</span>
        <div id="hamburger-icon" class="w-5 h-4 relative flex flex-col justify-between">
          <span class="hamburger-line block h-0.5 w-full bg-current rounded transition-all duration-300 origin-center"></span>
          <span class="hamburger-line block h-0.5 w-full bg-current rounded transition-all duration-300 origin-center"></span>
          <span class="hamburger-line block h-0.5 w-full bg-current rounded transition-all duration-300 origin-center"></span>
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile menu (slide-down) -->
  <div id="mobile-menu" class="lg:hidden overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0">
    <div class="border-t border-primary-800/50 bg-primary-900/98 backdrop-blur-sm px-4 pt-3 pb-5 space-y-1">
      {navItems.map((item: NavItem) => (
        <a
          href={item.href}
          data-href={item.href}
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg text-base font-medium text-primary-100/80 hover:text-white hover:bg-white/10 transition-all duration-200"
        >
          {item.label ?? item.labelText}
        </a>
      ))}

      {/* Info de contacto en mobile */}
      <div class="pt-3 mt-3 border-t border-primary-800/50 space-y-2">
        <a href={`tel:${SITE_CONFIG.phone}`} class="flex items-center gap-3 px-4 py-2 text-sm text-primary-100/60 hover:text-primary-300 transition-colors">
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          {SITE_CONFIG.phone}
        </a>
        <a href={`mailto:${SITE_CONFIG.email}`} class="flex items-center gap-3 px-4 py-2 text-sm text-primary-100/60 hover:text-primary-300 transition-colors">
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          {SITE_CONFIG.email}
        </a>
      </div>
    </div>
  </div>

  <script>
    (function () {
      try {
        const toggle = document.getElementById('nav-toggle');
        const mobile = document.getElementById('mobile-menu');
        const lines = document.querySelectorAll<HTMLElement>('.hamburger-line');

        if (toggle && mobile) {
          toggle.addEventListener('click', function () {
            const expanded = toggle.getAttribute('aria-expanded') === 'true';
            const willOpen = !expanded;
            toggle.setAttribute('aria-expanded', String(willOpen));

            if (willOpen) {
              mobile.style.maxHeight = mobile.scrollHeight + 'px';
              mobile.style.opacity = '1';
            } else {
              mobile.style.maxHeight = '0';
              mobile.style.opacity = '0';
            }

            // Animate hamburger → X
            if (lines.length === 3) {
              lines[0].style.transform = willOpen ? 'translateY(7px) rotate(45deg)' : '';
              lines[1].style.opacity = willOpen ? '0' : '1';
              lines[2].style.transform = willOpen ? 'translateY(-7px) rotate(-45deg)' : '';
            }
          });
        }

        // Shadow on scroll
        const nav = document.getElementById('main-nav');
        if (nav) {
          window.addEventListener('scroll', function () {
            if (window.scrollY > 10) {
              nav.classList.add('shadow-lg', 'shadow-primary-950/20');
            } else {
              nav.classList.remove('shadow-lg', 'shadow-primary-950/20');
            }
          }, { passive: true });
        }

        // Mark active links
        const path = location.pathname;
        document.querySelectorAll('.nav-link').forEach(function (el) {
          const href = el.getAttribute('data-href');
          if (!href) return;
          if (href === path || (href !== '/' && path.startsWith(href))) {
            el.classList.add('text-white');
            el.classList.remove('text-primary-100/80');
            const indicator = el.querySelector('.nav-indicator');
            if (indicator) {
              indicator.classList.remove('w-0');
              indicator.classList.add('w-5');
            }
          }
        });

        // Close mobile menu on resize to desktop
        var mql = window.matchMedia('(min-width: 1024px)');
        mql.addEventListener('change', function (e) {
          if (e.matches && mobile) {
            mobile.style.maxHeight = '0';
            mobile.style.opacity = '0';
            toggle?.setAttribute('aria-expanded', 'false');
            if (lines.length === 3) {
              lines[0].style.transform = '';
              lines[1].style.opacity = '1';
              lines[2].style.transform = '';
            }
          }
        });
      } catch (e) {
        console.error(e);
      }
    })();
  </script>
</nav>
