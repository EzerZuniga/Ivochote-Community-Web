---
import { SITE_CONFIG, SOCIAL_LINKS } from '../../../config/site.config.ts';
import { FOOTER_NAVIGATION } from '../../../config/navigation.ts';

const year = new Date().getFullYear();
const footerNav = FOOTER_NAVIGATION as Record<string, { href: string; label: string }[]>;
---

<footer role="contentinfo" aria-label="Pie de página" class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 mt-12">
  <div class="max-w-7xl mx-auto px-6 py-10">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
      <div>
        <a href="/" class="inline-block text-lg font-semibold text-slate-900 dark:text-slate-100">{SITE_CONFIG.title}</a>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{SITE_CONFIG.description}</p>

        <dl class="mt-4 text-sm text-slate-600 dark:text-slate-300">
          <div><dt class="sr-only">Dirección</dt><dd>{SITE_CONFIG.address}</dd></div>
          <div class="mt-1"><dt class="sr-only">Email</dt><dd><a class="hover:underline" href={`mailto:${SITE_CONFIG.email}`}>{SITE_CONFIG.email}</a></dd></div>
          <div class="mt-1"><dt class="sr-only">Teléfono</dt><dd>{SITE_CONFIG.phone}</dd></div>
        </dl>
      </div>

      <nav aria-label="Enlaces del pie de página" class="sm:col-span-2">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {Object.entries(footerNav).map(([section, links]) => (
            <div>
              <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{section}</h4>
              <ul class="mt-2 space-y-1 text-sm text-slate-600 dark:text-slate-300">
                {links.map((l: { href: string; label: string }) => (
                  <li><a class="hover:underline" href={l.href}>{l.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </nav>
    </div>

    <div class="mt-8 border-t border-slate-100 dark:border-slate-800 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-slate-500 dark:text-slate-400">© {year} {SITE_CONFIG.title}. Todos los derechos reservados.</p>

      <div class="flex items-center space-x-4">
        <div class="flex items-center space-x-3">
          {SOCIAL_LINKS.facebook ? (
            <a href={SOCIAL_LINKS.facebook} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-blue-600" aria-label="Facebook">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12.07C22 6.48 17.52 2 11.93 2S2 6.48 2 12.07c0 4.99 3.66 9.13 8.44 9.93v-7.03H8.08v-2.9h2.36V9.41c0-2.33 1.38-3.62 3.5-3.62. ,"/></svg>
            </a>
          ) : null}

          {SOCIAL_LINKS.twitter ? (
            <a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-sky-500" aria-label="Twitter">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53A4.48 4.48 0 0 0 22.43 1s-1.66 1-3.3 1.3A4.48 4.48 0 0 0 12 5.5v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
            </a>
          ) : null}

          {SOCIAL_LINKS.youtube ? (
            <a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-red-600" aria-label="YouTube">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 7.5a2.8 2.8 0 0 0-1.95-2C18.88 5 12 5 12 5s-6.88 0-9.05.5A2.8 2.8 0 0 0 1 7.5C1 10 1 12 1 12s0 2 1 4.5a2.8 2.8 0 0 0 1.95 2C5.12 19 12 19 12 19s6.88 0 9.05-.5A2.8 2.8 0 0 0 23 16.5C24 14 24 12 24 12s0-2-1-4.5z"/></svg>
            </a>
          ) : null}
        </div>

        <a href="/contacto" class="text-sm text-slate-600 dark:text-slate-300 hover:underline">Contacto</a>
      </div>
    </div>
  </div>
</footer>

