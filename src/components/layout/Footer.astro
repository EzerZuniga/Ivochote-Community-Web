---
import { SITE_CONFIG, SOCIAL_LINKS } from '../../../config/site.config.ts';

const year = new Date().getFullYear();
---

<footer role="contentinfo" aria-label="Pie de página" class="bg-primary-900 text-primary-100">

  <!-- ===== CUERPO PRINCIPAL ===== -->
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-14 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">

      <!-- Columna 1: Logo + descripción + redes -->
      <div class="md:col-span-2 lg:col-span-1">
        <a href="/" class="inline-block group" aria-label="Inicio">
          <img
            src="/assets/images/brand/logofooter.png"
            alt={`Logo ${SITE_CONFIG.shortTitle}`}
            class="h-20 w-auto object-contain transition-opacity duration-200 group-hover:opacity-80"
            loading="lazy"
          />
        </a>
        <p class="mt-5 text-sm leading-7 text-primary-100/60 max-w-sm">
          {SITE_CONFIG.description}
        </p>
        <!-- Redes sociales -->
        <div class="mt-6 flex items-center gap-2.5">
          {SOCIAL_LINKS.facebook && (
            <a href={SOCIAL_LINKS.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook"
              class="flex items-center justify-center w-9 h-9 rounded-full bg-primary-800 hover:bg-[#1877F2] text-primary-100/60 hover:text-white transition-all duration-200">
              <svg class="w-[17px] h-[17px]" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/></svg>
            </a>
          )}
          {SOCIAL_LINKS.tiktok && (
            <a href={SOCIAL_LINKS.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok"
              class="flex items-center justify-center w-9 h-9 rounded-full bg-primary-800 hover:bg-black text-primary-100/60 hover:text-white transition-all duration-200">
              <svg class="w-[16px] h-[16px]" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1 0-5.78 2.92 2.92 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.64 6.33 6.33 0 0 0 9.37 22a6.33 6.33 0 0 0 6.38-6.36V9.25a8.16 8.16 0 0 0 4.84 1.58V7.38a4.85 4.85 0 0 1-1-.69z"/></svg>
            </a>
          )}
        </div>
      </div>

      <!-- Columna 2: Gobierno -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-[0.12em] text-primary-400 mb-5">Gobierno</h4>
        <ul class="space-y-3">
          {[
            { href: '/autoridades', label: 'Autoridades' },
            { href: '/servicios', label: 'Servicios Municipales' },
            { href: '/transparencia', label: 'Transparencia' },
          ].map(l => (
            <li>
              <a href={l.href} class="group flex items-center gap-2 text-sm text-primary-100/60 hover:text-primary-300 transition-colors duration-200">
                <svg class="w-3 h-3 text-primary-600 group-hover:text-primary-400 flex-shrink-0 transition-colors" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 3: Comunidad -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-[0.12em] text-primary-400 mb-5">Comunidad</h4>
        <ul class="space-y-3">
          {[
            { href: '/noticias', label: 'Noticias' },
            { href: '/eventos', label: 'Eventos' },
            { href: '/turismo', label: 'Turismo' },
            { href: '/contacto', label: 'Contáctanos' },
          ].map(l => (
            <li>
              <a href={l.href} class="group flex items-center gap-2 text-sm text-primary-100/60 hover:text-primary-300 transition-colors duration-200">
                <svg class="w-3 h-3 text-primary-600 group-hover:text-primary-400 flex-shrink-0 transition-colors" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 4: Contacto -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-[0.12em] text-primary-400 mb-5">Contacto</h4>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 text-primary-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="text-sm text-primary-100/60 leading-relaxed">{SITE_CONFIG.address}</span>
          </li>
          <li>
            <a href={`mailto:${SITE_CONFIG.email}`} class="flex items-center gap-3 text-sm text-primary-100/60 hover:text-primary-300 transition-colors duration-200 group">
              <svg class="w-4 h-4 text-primary-400 group-hover:text-primary-300 flex-shrink-0 transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              {SITE_CONFIG.email}
            </a>
          </li>
          <li>
            <a href={`tel:${SITE_CONFIG.phone}`} class="flex items-center gap-3 text-sm text-primary-100/60 hover:text-primary-300 transition-colors duration-200 group">
              <svg class="w-4 h-4 text-primary-400 group-hover:text-primary-300 flex-shrink-0 transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              {SITE_CONFIG.phone}
            </a>
          </li>

          <!-- Libro de Reclamaciones -->
          <li class="mt-2">
            <button
              id="btn-libro-reclamaciones"
              type="button"
              aria-haspopup="dialog"
              aria-controls="modal-libro-reclamaciones"
              aria-label="Abrir libro de reclamaciones"
              class="group block w-full focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2 focus-visible:ring-offset-primary-900 rounded-lg overflow-hidden"
            >
              <img
                src="/assets/images/libro.png"
                alt="Libro de Reclamaciones"
                class="w-full h-auto object-contain transition-transform duration-200 group-hover:scale-105"
                loading="lazy"
              />
            </button>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <!-- ===== MODAL LIBRO DE RECLAMACIONES ===== -->
  <div
    id="modal-libro-reclamaciones"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-titulo"
    aria-describedby="modal-step-desc"
    tabindex="-1"
    class="fixed inset-0 z-50 hidden items-end sm:items-center justify-center sm:p-4 bg-black/80 backdrop-blur-sm"
  >
    <!-- Panel -->
    <div
      id="modal-panel"
      class="relative w-full sm:max-w-[500px] bg-white rounded-t-2xl sm:rounded-2xl shadow-2xl flex flex-col max-h-[95dvh] sm:max-h-[88vh] overflow-hidden"
    >
      <!-- BANNER ROJO -->
      <div class="flex-shrink-0 relative bg-gradient-to-br from-red-700 via-red-600 to-red-700 px-5 pt-5 pb-4 rounded-t-2xl overflow-hidden">
        <!-- Círculos decorativos -->
        <div class="absolute -top-8 -right-8 w-36 h-36 rounded-full bg-white/5 pointer-events-none"></div>
        <div class="absolute -bottom-6 -left-4 w-24 h-24 rounded-full bg-black/10 pointer-events-none"></div>

        <!-- Botón cerrar -->
        <button
          id="btn-cerrar-modal"
          type="button"
          aria-label="Cerrar"
          class="absolute top-3 right-3 z-10 flex items-center justify-center w-8 h-8 rounded-full bg-white/20 hover:bg-white/30 active:bg-white/10 text-white transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>

        <!-- Fila título -->
        <div class="relative z-10 flex items-center gap-3 pr-10">
          <img src="/assets/images/libro.png" alt="" aria-hidden="true" class="w-14 h-14 object-contain drop-shadow-lg flex-shrink-0" loading="lazy" />
          <div>
            <p class="text-red-200 text-[10px] font-semibold uppercase tracking-[0.15em]">Municipalidad del C.P. Ivochote</p>
            <h2 id="modal-titulo" class="text-white text-[17px] font-bold leading-tight mt-0.5">Libro de Reclamaciones</h2>
            <p class="text-red-100/70 text-[11px] mt-1">Ley N.° 29571 &middot; Atención en 30 días hábiles</p>
          </div>
        </div>

        <!-- Indicador de pasos -->
        <div role="group" aria-label="Progreso" class="relative z-10 mt-4 flex items-center">
          <div class="flex items-center gap-1.5">
            <span id="step-dot-1" class="w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold bg-white text-red-600 shadow transition-all duration-200">1</span>
            <span id="step-lbl-1" class="text-white text-[11px] font-semibold whitespace-nowrap">Tipo</span>
          </div>
          <div id="step-line-1" class="flex-1 h-0.5 mx-2 rounded-full bg-white/30 transition-all duration-300"></div>
          <div class="flex items-center gap-1.5">
            <span id="step-dot-2" class="w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold bg-white/25 text-white ring-1 ring-white/30 transition-all duration-200">2</span>
            <span id="step-lbl-2" class="text-white/60 text-[11px] font-semibold whitespace-nowrap transition-colors duration-200">Datos</span>
          </div>
          <div id="step-line-2" class="flex-1 h-0.5 mx-2 rounded-full bg-white/30 transition-all duration-300"></div>
          <div class="flex items-center gap-1.5">
            <span id="step-dot-3" class="w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold bg-white/25 text-white ring-1 ring-white/30 transition-all duration-200">3</span>
            <span id="step-lbl-3" class="text-white/60 text-[11px] font-semibold whitespace-nowrap transition-colors duration-200">Detalle</span>
          </div>
        </div>
      </div>

      <!-- CUERPO SCROLLABLE -->
      <div class="flex-1 overflow-y-auto overscroll-contain bg-gray-50">
        <form id="form-reclamaciones" novalidate>

          <!-- ── PASO 1: Tipo ── -->
          <div id="step-body-1" class="p-5 space-y-3">
            <p id="modal-step-desc" class="text-sm text-gray-500">¿Qué tipo de registro deseas presentar?</p>
            <div class="space-y-3">
              <label for="tipo-reclamo"
                class="tipo-card group flex items-start gap-4 p-4 rounded-xl border-2 border-gray-200 bg-white cursor-pointer hover:border-red-300 hover:bg-red-50/40 transition-all duration-150 has-[:checked]:border-red-500 has-[:checked]:bg-red-50 has-[:checked]:shadow-sm">
                <input type="radio" id="tipo-reclamo" name="tipo" value="reclamo" required class="sr-only" />
                <span class="flex-shrink-0 w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center mt-0.5">
                  <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
                  </svg>
                </span>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-gray-800">Reclamo</p>
                  <p class="text-xs text-gray-500 mt-0.5 leading-relaxed">Disconformidad con los bienes o servicios adquiridos o contratados.</p>
                </div>
                <span class="flex-shrink-0 w-5 h-5 rounded-full border-2 border-gray-300 has-not-[:checked]:border-gray-300 mt-1 transition-all duration-150 flex items-center justify-center group-has-[:checked]:border-red-500 group-has-[:checked]:bg-red-500">
                  <svg class="w-2.5 h-2.5 text-white opacity-0 group-has-[:checked]:opacity-100 transition-opacity" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                </span>
              </label>

              <label for="tipo-queja"
                class="tipo-card group flex items-start gap-4 p-4 rounded-xl border-2 border-gray-200 bg-white cursor-pointer hover:border-red-300 hover:bg-red-50/40 transition-all duration-150 has-[:checked]:border-red-500 has-[:checked]:bg-red-50 has-[:checked]:shadow-sm">
                <input type="radio" id="tipo-queja" name="tipo" value="queja" required class="sr-only" />
                <span class="flex-shrink-0 w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center mt-0.5">
                  <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z"/>
                  </svg>
                </span>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-gray-800">Queja</p>
                  <p class="text-xs text-gray-500 mt-0.5 leading-relaxed">Malestar o desacuerdo con la atención brindada por parte del personal.</p>
                </div>
                <span class="flex-shrink-0 w-5 h-5 rounded-full border-2 border-gray-300 mt-1 transition-all duration-150 flex items-center justify-center group-has-[:checked]:border-red-500 group-has-[:checked]:bg-red-500">
                  <svg class="w-2.5 h-2.5 text-white opacity-0 group-has-[:checked]:opacity-100 transition-opacity" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                </span>
              </label>
            </div>
            <p id="error-tipo" role="alert" class="hidden text-xs text-red-600 bg-red-50 border border-red-100 rounded-lg px-3 py-2">Por favor selecciona el tipo de registro.</p>
          </div>

          <!-- ── PASO 2: Datos personales ── -->
          <div id="step-body-2" style="display:none" class="p-5 space-y-4">
            <p class="text-sm text-gray-500">Completa tus datos para identificar el registro.</p>

            <div class="grid grid-cols-2 gap-3">
              <div class="col-span-2 sm:col-span-1 space-y-1.5">
                <label for="nombres" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Nombres <span class="text-red-500" aria-hidden="true">*</span></label>
                <input type="text" id="nombres" name="nombres" autocomplete="given-name" required minlength="2" maxlength="60" placeholder="Juan Carlos"
                  class="rec-input w-full rounded-lg bg-white border border-gray-200 text-sm text-gray-800 placeholder-gray-300 px-3.5 py-2.5 focus:outline-none focus:border-red-400 focus:ring-2 focus:ring-red-100 transition-all duration-150" />
                <p id="error-nombres" role="alert" class="hidden text-xs text-red-600">Ingresa tu nombre (mínimo 2 caracteres).</p>
              </div>
              <div class="col-span-2 sm:col-span-1 space-y-1.5">
                <label for="apellidos" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Apellidos <span class="text-red-500" aria-hidden="true">*</span></label>
                <input type="text" id="apellidos" name="apellidos" autocomplete="family-name" required minlength="2" maxlength="80" placeholder="Pérez López"
                  class="rec-input w-full rounded-lg bg-white border border-gray-200 text-sm text-gray-800 placeholder-gray-300 px-3.5 py-2.5 focus:outline-none focus:border-red-400 focus:ring-2 focus:ring-red-100 transition-all duration-150" />
                <p id="error-apellidos" role="alert" class="hidden text-xs text-red-600">Ingresa tus apellidos.</p>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div class="space-y-1.5">
                <label for="dni" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">DNI <span class="text-red-500" aria-hidden="true">*</span></label>
                <input type="text" id="dni" name="dni" autocomplete="off" required inputmode="numeric" maxlength="8" pattern="\d{8}" placeholder="12345678"
                  class="rec-input w-full rounded-lg bg-white border border-gray-200 text-sm text-gray-800 placeholder-gray-300 px-3.5 py-2.5 font-mono tracking-wider focus:outline-none focus:border-red-400 focus:ring-2 focus:ring-red-100 transition-all duration-150" />
                <p id="error-dni" role="alert" class="hidden text-xs text-red-600">DNI inválido (8 dígitos).</p>
              </div>
              <div class="space-y-1.5">
                <label for="telefono" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Teléfono <span class="text-gray-400 font-normal normal-case tracking-normal text-[10px]">(opc.)</span></label>
                <input type="tel" id="telefono" name="telefono" autocomplete="tel" maxlength="15" inputmode="tel" placeholder="+51 987 654 321"
                  class="rec-input w-full rounded-lg bg-white border border-gray-200 text-sm text-gray-800 placeholder-gray-300 px-3.5 py-2.5 focus:outline-none focus:border-red-400 focus:ring-2 focus:ring-red-100 transition-all duration-150" />
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="email-rec" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Correo electrónico <span class="text-red-500" aria-hidden="true">*</span></label>
              <input type="email" id="email-rec" name="email" autocomplete="email" required maxlength="100" placeholder="tu@correo.com"
                class="rec-input w-full rounded-lg bg-white border border-gray-200 text-sm text-gray-800 placeholder-gray-300 px-3.5 py-2.5 focus:outline-none focus:border-red-400 focus:ring-2 focus:ring-red-100 transition-all duration-150" />
              <p class="text-[11px] text-gray-400">Recibirás la confirmación de tu reclamo en este correo.</p>
              <p id="error-email" role="alert" class="hidden text-xs text-red-600">Ingresa un correo electrónico válido.</p>
            </div>
          </div>

          <!-- ── PASO 3: Detalle ── -->
          <div id="step-body-3" style="display:none" class="p-5 space-y-4">
            <p class="text-sm text-gray-500">Describe con detalle lo ocurrido para una atención más precisa.</p>

            <div class="space-y-1.5">
              <label for="asunto" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Asunto <span class="text-red-500" aria-hidden="true">*</span></label>
              <input type="text" id="asunto" name="asunto" required minlength="5" maxlength="120" placeholder="Ej. Cobro indebido por servicio de agua"
                class="rec-input w-full rounded-lg bg-white border border-gray-200 text-sm text-gray-800 placeholder-gray-300 px-3.5 py-2.5 focus:outline-none focus:border-red-400 focus:ring-2 focus:ring-red-100 transition-all duration-150" />
              <p id="error-asunto" role="alert" class="hidden text-xs text-red-600">Ingresa el asunto (mínimo 5 caracteres).</p>
            </div>

            <div class="space-y-1.5">
              <label for="descripcion" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Descripción <span class="text-red-500" aria-hidden="true">*</span></label>
              <textarea id="descripcion" name="descripcion" required minlength="20" maxlength="1000" rows="5"
                placeholder="Describe detalladamente lo ocurrido: fecha, lugar, personas involucradas y lo que solicitas..."
                class="rec-input w-full rounded-lg bg-white border border-gray-200 text-sm text-gray-800 placeholder-gray-300 px-3.5 py-2.5 focus:outline-none focus:border-red-400 focus:ring-2 focus:ring-red-100 transition-all duration-150 resize-none"></textarea>
              <div class="flex items-center justify-between">
                <p id="error-descripcion" role="alert" class="hidden text-xs text-red-600">Describe el reclamo (mínimo 20 caracteres).</p>
                <span id="contador-desc" class="ml-auto text-xs text-gray-400">0 / 1000</span>
              </div>
            </div>

            <label class="flex items-start gap-3 cursor-pointer group">
              <input type="checkbox" id="acepta-terminos" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-red-600 focus:ring-red-400 cursor-pointer flex-shrink-0 accent-red-600" />
              <span class="text-xs text-gray-500 leading-relaxed group-hover:text-gray-700 transition-colors">
                Autorizo el tratamiento de mis datos personales conforme a la <strong class="text-gray-700">Ley N.° 29733</strong> y acepto que este registro será procesado por la Municipalidad del C.P. Ivochote.
              </span>
            </label>
            <p id="error-terminos" role="alert" class="hidden text-xs text-red-600">Debes aceptar los términos para continuar.</p>
          </div>

        </form>

        <!-- Estado: Enviando -->
        <div id="estado-enviando" style="display:none" class="p-10 flex flex-col items-center gap-5 text-center">
          <div class="relative w-16 h-16">
            <div class="absolute inset-0 rounded-full border-4 border-red-100"></div>
            <div class="absolute inset-0 rounded-full border-4 border-red-500 border-t-transparent animate-spin"></div>
          </div>
          <div>
            <p class="text-base font-semibold text-gray-800">Registrando tu reclamo...</p>
            <p class="text-sm text-gray-400 mt-1">Esto solo tomará un momento.</p>
          </div>
        </div>

        <!-- Estado: Éxito -->
        <div id="estado-exito" style="display:none" class="p-8 flex flex-col items-center gap-5 text-center">
          <div class="flex items-center justify-center w-16 h-16 rounded-full bg-green-100 ring-4 ring-green-50">
            <svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="space-y-2">
            <p class="text-lg font-bold text-gray-800">¡Reclamo registrado!</p>
            <div class="inline-block bg-gray-100 rounded-2xl px-5 py-3">
              <p class="text-xs text-gray-400 uppercase tracking-wider">N.° de expediente</p>
              <p id="numero-expediente" class="text-2xl font-bold text-red-600 font-mono tracking-widest mt-0.5"></p>
            </div>
            <p class="text-sm text-gray-500 max-w-xs mx-auto leading-relaxed">
              Te responderemos al correo registrado en un plazo máximo de <strong class="text-gray-700">30 días hábiles</strong>. Guarda tu número de expediente.
            </p>
          </div>
          <button id="btn-cerrar-exito" type="button"
            class="w-full max-w-[200px] py-2.5 rounded-xl bg-red-600 hover:bg-red-500 active:bg-red-700 text-sm font-semibold text-white shadow-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-red-400">
            Cerrar
          </button>
        </div>
      </div>

      <!-- BOTONES FIJOS -->
      <div id="modal-footer-btns" class="flex-shrink-0 border-t border-gray-100 bg-white px-5 py-3.5 flex gap-2.5">
        <button type="button" id="btn-cancelar"
          class="flex-1 py-2.5 rounded-xl border border-gray-200 text-sm text-gray-500 hover:bg-gray-50 hover:text-gray-700 hover:border-gray-300 transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-300">
          Cancelar
        </button>
        <button type="button" id="btn-anterior" style="display:none"
          class="flex-1 flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-gray-200 text-sm text-gray-600 hover:bg-gray-50 hover:border-gray-300 transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-300">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          Atrás
        </button>
        <button type="button" id="btn-siguiente"
          class="flex-[2] flex items-center justify-center gap-1.5 py-2.5 rounded-xl bg-red-600 hover:bg-red-500 active:bg-red-700 text-sm font-semibold text-white shadow-sm transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-400 focus-visible:ring-offset-2">
          Siguiente
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </button>
        <button type="button" id="btn-enviar" style="display:none"
          class="flex-[2] flex items-center justify-center gap-2 py-2.5 rounded-xl bg-red-600 hover:bg-red-500 active:bg-red-700 text-sm font-semibold text-white shadow-sm transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-400 focus-visible:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"/></svg>
          Enviar reclamo
        </button>
      </div>

    </div>
  </div>
  <!-- /MODAL LIBRO DE RECLAMACIONES -->

  <!-- ===== DIVISOR ===== -->
  <div class="border-t border-primary-800/60"></div>

  <!-- ===== BARRA INFERIOR ===== -->
  <div class="bg-black">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-4 flex flex-col sm:flex-row items-center justify-between gap-2">
      <p class="text-sm text-white/40 text-center sm:text-left">
        © {year} {SITE_CONFIG.title}. Todos los derechos reservados.
      </p>
      <p class="text-sm text-white/40">
        Desarrollado por: <a href="https://www.instagram.com/ezer.zuniga" target="_blank" rel="noopener noreferrer" class="text-primary-400 hover:text-primary-300 font-semibold transition-colors duration-200">Ezer Zuñiga</a>.
      </p>
    </div>
  </div>

</footer>

<script>
(function () {
  'use strict';

  // ── Refs ───────────────────────────────────────────────────────────────────
  const modal        = document.getElementById('modal-libro-reclamaciones') as HTMLElement | null;
  const panel        = document.getElementById('modal-panel') as HTMLElement | null;
  const btnAbrir     = document.getElementById('btn-libro-reclamaciones') as HTMLButtonElement | null;
  const btnCerrar    = document.getElementById('btn-cerrar-modal') as HTMLButtonElement | null;
  const btnCancelar  = document.getElementById('btn-cancelar') as HTMLButtonElement | null;
  const btnAnterior  = document.getElementById('btn-anterior') as HTMLButtonElement | null;
  const btnSiguiente = document.getElementById('btn-siguiente') as HTMLButtonElement | null;
  const btnEnviar    = document.getElementById('btn-enviar') as HTMLButtonElement | null;
  const btnCerrarEx  = document.getElementById('btn-cerrar-exito') as HTMLButtonElement | null;
  const form         = document.getElementById('form-reclamaciones') as HTMLFormElement | null;
  const txtDesc      = document.getElementById('descripcion') as HTMLTextAreaElement | null;
  const contador     = document.getElementById('contador-desc') as HTMLElement | null;
  const dniInput     = document.getElementById('dni') as HTMLInputElement | null;
  const footerBtns   = document.getElementById('modal-footer-btns') as HTMLElement | null;

  if (!modal || !panel || !btnAbrir || !form) return;

  // ── Estado ─────────────────────────────────────────────────────────────────
  let currentStep = 1;
  const TOTAL_STEPS = 3;
  let previousFocus: HTMLElement | null = null;

  // ── Utilidades ─────────────────────────────────────────────────────────────
  function showEl(el: HTMLElement | null) {
    if (!el) return;
    el.style.removeProperty('display');
    el.classList.remove('hidden');
  }
  function hideEl(el: HTMLElement | null) {
    if (!el) return;
    el.style.display = 'none';
    el.classList.add('hidden');
  }
  function showElId(id: string) { showEl(document.getElementById(id)); }
  function hideElId(id: string) { hideEl(document.getElementById(id)); }
  function getInput(id: string) { return document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null; }

  function setFieldError(inputId: string, errorId: string, hasError: boolean) {
    const input = getInput(inputId);
    const err   = document.getElementById(errorId);
    if (input) {
      if (hasError) {
        input.classList.add('border-red-400', 'bg-red-50/30');
        input.setAttribute('aria-invalid', 'true');
        input.setAttribute('aria-describedby', errorId);
      } else {
        input.classList.remove('border-red-400', 'bg-red-50/30');
        input.removeAttribute('aria-invalid');
        input.removeAttribute('aria-describedby');
      }
    }
    if (err) {
      hasError ? err.classList.remove('hidden') : err.classList.add('hidden');
    }
  }

  // ── Indicador de pasos ─────────────────────────────────────────────────────
  function updateStepUI(step: number) {
    for (let i = 1; i <= TOTAL_STEPS; i++) {
      const dot = document.getElementById(`step-dot-${i}`);
      const lbl = document.getElementById(`step-lbl-${i}`);
      const line = document.getElementById(`step-line-${i}`);
      if (!dot || !lbl) continue;

      if (i < step) {
        // Completado
        dot.className = 'w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold bg-white text-green-600 shadow transition-all duration-200';
        dot.innerHTML = `<svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>`;
        lbl.className = 'text-white text-[11px] font-semibold whitespace-nowrap transition-colors duration-200';
        if (line) line.className = 'flex-1 h-0.5 mx-2 rounded-full bg-white/70 transition-all duration-300';
      } else if (i === step) {
        // Activo
        dot.className = 'w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold bg-white text-red-600 shadow transition-all duration-200';
        dot.innerHTML = String(i);
        lbl.className = 'text-white text-[11px] font-semibold whitespace-nowrap transition-colors duration-200';
        if (line) line.className = 'flex-1 h-0.5 mx-2 rounded-full bg-white/30 transition-all duration-300';
      } else {
        // Pendiente
        dot.className = 'w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold bg-white/25 text-white ring-1 ring-white/30 transition-all duration-200';
        dot.innerHTML = String(i);
        lbl.className = 'text-white/60 text-[11px] font-semibold whitespace-nowrap transition-colors duration-200';
        if (line) line.className = 'flex-1 h-0.5 mx-2 rounded-full bg-white/30 transition-all duration-300';
      }
    }
  }

  function goToStep(step: number) {
    // Ocultar paso actual
    hideElId(`step-body-${currentStep}`);
    currentStep = step;
    // Mostrar nuevo paso
    showElId(`step-body-${step}`);
    updateStepUI(step);

    // Actualizar botones
    if (step === 1) {
      hideEl(btnAnterior);
      showEl(btnCancelar);
      showEl(btnSiguiente);
      hideEl(btnEnviar);
    } else if (step < TOTAL_STEPS) {
      showEl(btnAnterior);
      hideEl(btnCancelar);
      showEl(btnSiguiente);
      hideEl(btnEnviar);
    } else {
      showEl(btnAnterior);
      hideEl(btnCancelar);
      hideEl(btnSiguiente);
      showEl(btnEnviar);
    }

    // Scroll al top del body y focus al primer campo
    const body = panel!.querySelector<HTMLElement>('.overflow-y-auto');
    if (body) body.scrollTop = 0;
    setTimeout(() => {
      const first = document.getElementById(`step-body-${step}`)?.querySelector<HTMLElement>('input:not([type="radio"]):not([type="checkbox"]),textarea');
      first?.focus();
    }, 50);
  }

  // ── Validación por paso ─────────────────────────────────────────────────────
  function validateStep(step: number): boolean {
    let ok = true;

    if (step === 1) {
      const tipo = (form!.querySelector('input[name="tipo"]:checked') as HTMLInputElement | null)?.value;
      const errEl = document.getElementById('error-tipo');
      if (!tipo) {
        errEl?.classList.remove('hidden');
        ok = false;
      } else {
        errEl?.classList.add('hidden');
      }
    }

    if (step === 2) {
      const nombres   = (getInput('nombres') as HTMLInputElement)?.value.trim() ?? '';
      const apellidos = (getInput('apellidos') as HTMLInputElement)?.value.trim() ?? '';
      const dni       = (getInput('dni') as HTMLInputElement)?.value.trim() ?? '';
      const email     = (getInput('email-rec') as HTMLInputElement)?.value.trim() ?? '';

      setFieldError('nombres', 'error-nombres', nombres.length < 2);
      if (nombres.length < 2) ok = false;

      setFieldError('apellidos', 'error-apellidos', apellidos.length < 2);
      if (apellidos.length < 2) ok = false;

      setFieldError('dni', 'error-dni', !/^\d{8}$/.test(dni));
      if (!/^\d{8}$/.test(dni)) ok = false;

      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email);
      setFieldError('email-rec', 'error-email', !emailOk);
      if (!emailOk) ok = false;
    }

    if (step === 3) {
      const asunto = (getInput('asunto') as HTMLInputElement)?.value.trim() ?? '';
      const desc   = (getInput('descripcion') as HTMLTextAreaElement)?.value.trim() ?? '';
      const acepta = (document.getElementById('acepta-terminos') as HTMLInputElement)?.checked ?? false;

      setFieldError('asunto', 'error-asunto', asunto.length < 5);
      if (asunto.length < 5) ok = false;

      setFieldError('descripcion', 'error-descripcion', desc.length < 20);
      if (desc.length < 20) ok = false;

      const errTerminos = document.getElementById('error-terminos');
      if (!acepta) {
        errTerminos?.classList.remove('hidden');
        ok = false;
      } else {
        errTerminos?.classList.add('hidden');
      }
    }

    if (!ok) {
      const firstErr = document.getElementById(`step-body-${step}`)?.querySelector<HTMLElement>('[aria-invalid="true"]');
      firstErr?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      firstErr?.focus();
    }
    return ok;
  }

  // ── Contador descripción ───────────────────────────────────────────────────
  txtDesc?.addEventListener('input', () => {
    if (contador) contador.textContent = `${txtDesc.value.length} / 1000`;
  });

  // ── Solo dígitos en DNI ────────────────────────────────────────────────────
  dniInput?.addEventListener('input', () => {
    dniInput.value = dniInput.value.replace(/\D/g, '').slice(0, 8);
  });

  // ── Validación blur en tiempo real ─────────────────────────────────────────
  const blurMap: Record<string, () => boolean> = {
    'nombres':   () => (getInput('nombres') as HTMLInputElement)?.value.trim().length >= 2,
    'apellidos': () => (getInput('apellidos') as HTMLInputElement)?.value.trim().length >= 2,
    'dni':       () => /^\d{8}$/.test((getInput('dni') as HTMLInputElement)?.value.trim() ?? ''),
    'email-rec': () => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test((getInput('email-rec') as HTMLInputElement)?.value.trim() ?? ''),
    'asunto':    () => (getInput('asunto') as HTMLInputElement)?.value.trim().length >= 5,
    'descripcion': () => (getInput('descripcion') as HTMLTextAreaElement)?.value.trim().length >= 20,
  };
  const errorMap: Record<string, string> = {
    'nombres': 'error-nombres', 'apellidos': 'error-apellidos', 'dni': 'error-dni',
    'email-rec': 'error-email', 'asunto': 'error-asunto', 'descripcion': 'error-descripcion',
  };
  Object.entries(blurMap).forEach(([id, valid]) => {
    getInput(id)?.addEventListener('blur', () => setFieldError(id, errorMap[id], !valid()));
  });

  // ── Abrir / Cerrar modal ───────────────────────────────────────────────────
  function openModal() {
    previousFocus = document.activeElement as HTMLElement;
    modal!.classList.remove('hidden');
    modal!.classList.add('flex');
    document.body.style.overflow = 'hidden';
    currentStep = 1;
    requestAnimationFrame(() => {
      panel!.style.opacity = '0';
      panel!.style.transform = window.innerWidth < 640 ? 'translateY(24px)' : 'scale(0.96) translateY(8px)';
      requestAnimationFrame(() => {
        panel!.style.transition = 'opacity 220ms cubic-bezier(.4,0,.2,1), transform 220ms cubic-bezier(.4,0,.2,1)';
        panel!.style.opacity = '1';
        panel!.style.transform = window.innerWidth < 640 ? 'translateY(0)' : 'scale(1) translateY(0)';
      });
    });
    updateStepUI(1);
    setTimeout(() => {
      const first = panel!.querySelector<HTMLElement>('input[type="radio"]');
      first?.focus();
    }, 250);
  }

  function closeModal() {
    panel!.style.transition = 'opacity 180ms ease, transform 180ms ease';
    panel!.style.opacity = '0';
    panel!.style.transform = window.innerWidth < 640 ? 'translateY(16px)' : 'scale(0.97) translateY(4px)';
    setTimeout(() => {
      modal!.classList.add('hidden');
      modal!.classList.remove('flex');
      document.body.style.overflow = '';
      panel!.style.cssText = '';
      resetAll();
      previousFocus?.focus();
    }, 180);
  }

  function resetAll() {
    form!.reset();
    if (contador) contador.textContent = '0 / 1000';
    // Limpiar errores
    ['nombres','apellidos','dni','email-rec','asunto','descripcion'].forEach(id => {
      const inp = getInput(id);
      if (inp) { inp.classList.remove('border-red-400','bg-red-50/30'); inp.removeAttribute('aria-invalid'); inp.removeAttribute('aria-describedby'); }
    });
    ['error-tipo','error-nombres','error-apellidos','error-dni','error-email','error-asunto','error-descripcion','error-terminos'].forEach(id => {
      document.getElementById(id)?.classList.add('hidden');
    });
    // Resetear vista
    [form, footerBtns].forEach(el => { if (el) el.style.removeProperty('display'); });
    hideEl(document.getElementById('estado-enviando'));
    hideEl(document.getElementById('estado-exito'));
    // Volver al paso 1
    for (let i = 2; i <= TOTAL_STEPS; i++) {
      hideElId(`step-body-${i}`);
    }
    showElId('step-body-1');
    hideEl(btnAnterior);
    showEl(btnCancelar);
    showEl(btnSiguiente);
    hideEl(btnEnviar);
    updateStepUI(1);
    currentStep = 1;
  }

  // ── Listeners botones ──────────────────────────────────────────────────────
  btnAbrir?.addEventListener('click', openModal);
  btnCerrar?.addEventListener('click', closeModal);
  btnCancelar?.addEventListener('click', closeModal);
  btnCerrarEx?.addEventListener('click', closeModal);

  btnAnterior?.addEventListener('click', () => {
    if (currentStep > 1) goToStep(currentStep - 1);
  });

  btnSiguiente?.addEventListener('click', () => {
    if (validateStep(currentStep) && currentStep < TOTAL_STEPS) {
      goToStep(currentStep + 1);
    }
  });

  btnEnviar?.addEventListener('click', async () => {
    if (!validateStep(3)) return;
    if (btnEnviar) (btnEnviar as HTMLButtonElement).disabled = true;

    // Ocultar form y footer buttons
    if (form) form.style.display = 'none';
    if (footerBtns) footerBtns.style.display = 'none';

    showEl(document.getElementById('estado-enviando'));

    // Simulación envío (reemplaza con fetch real)
    await new Promise<void>(r => setTimeout(r, 2000));

    hideEl(document.getElementById('estado-enviando'));

    // Generar número de expediente
    const year = new Date().getFullYear();
    const seq  = String(Math.floor(Math.random() * 9000) + 1000);
    const numEl = document.getElementById('numero-expediente');
    if (numEl) numEl.textContent = `REC-${year}-${seq}`;

    showEl(document.getElementById('estado-exito'));
    if (btnEnviar) (btnEnviar as HTMLButtonElement).disabled = false;
  });

  // Clic en backdrop
  modal?.addEventListener('click', e => { if (e.target === modal) closeModal(); });

  // Escape
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !modal!.classList.contains('hidden')) closeModal();
  });

  // Focus trap
  modal?.addEventListener('keydown', e => {
    if (e.key !== 'Tab') return;
    const focusable = Array.from(
      panel!.querySelectorAll<HTMLElement>('a,button:not([disabled]),input:not([disabled]),textarea:not([disabled]),select:not([disabled]),[tabindex]:not([tabindex="-1"])')
    ).filter(el => {
      const s = window.getComputedStyle(el);
      return s.display !== 'none' && s.visibility !== 'hidden' && !el.closest('.hidden');
    });
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last  = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
})();
</script>

