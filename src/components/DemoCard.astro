---
interface DemoItem {
  title: string;
  slug: string;
  excerpt?: string;
  image?: string;
}

export interface Props {
  item: DemoItem;
}

const { item } = Astro.props as Props;
---

<article class="bg-white dark:bg-slate-800 rounded-lg shadow-sm hover:shadow-md transition p-4">
  {item.image ? (
    <img src={item.image} alt={item.title} class="w-full h-40 object-cover rounded-md mb-3" />
  ) : null}

  <h3 class="text-lg font-semibold mb-1">{item.title}</h3>
  {item.excerpt ? <p class="text-sm text-slate-600 dark:text-slate-300 mb-3">{item.excerpt}</p> : null}

  <div class="flex items-center justify-between">
    <a class="text-blue-600 dark:text-blue-400 hover:underline text-sm" href={`/demo/${item.slug}`}>Ver detalle</a>
    <span class="text-xs text-slate-400">{item.slug}</span>
  </div>
</article>
