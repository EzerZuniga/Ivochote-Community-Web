---
import Navbar from '../components/layoutComponents/Navbar.astro';
import Footer from '../components/layoutComponents/Footer.astro';
import Head from '../components/seoComponents/Head.astro';
import JsonLd from '../components/seoComponents/JsonLd.astro';
import { SITE_CONFIG } from '../../config/site.config';
import '../styles/globals.css';

interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  showPreloader?: boolean;
  type?: 'website' | 'article';
  publishedTime?: string;
  author?: string;
  breadcrumbs?: BreadcrumbItem[];
  article?: {
    title: string;
    description?: string;
    image?: string;
    datePublished?: string;
    dateModified?: string;
    author?: string;
  };
  pageType?: 'WebPage' | 'ContactPage' | 'AboutPage' | 'CollectionPage';
  event?: {
    name: string;
    description?: string;
    startDate?: string;
    endDate?: string;
    image?: string;
    locationName?: string;
    locationAddress?: string;
    status?: 'upcoming' | 'ongoing' | 'past' | 'cancelled';
  };
  place?: {
    name: string;
    description?: string;
    image?: string;
    latitude?: number;
    longitude?: number;
    location?: string;
    category?: string;
  };
  service?: {
    name: string;
    description?: string;
    category?: string;
    phone?: string;
    email?: string;
  };
  person?: {
    name: string;
    jobTitle?: string;
    image?: string;
    email?: string;
    phone?: string;
  };
}

const {
  title,
  description,
  image,
  canonical,
  noindex,
  showPreloader = false,
  type = 'website',
  publishedTime,
  author,
  breadcrumbs,
  article,
  pageType,
  event,
  place,
  service,
  person,
} = Astro.props as Props;
---

<!doctype html>
<html lang={SITE_CONFIG.language ?? 'es'}>
  <head>
    <Head
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      noindex={noindex}
      type={type}
      publishedTime={publishedTime}
      author={author}
    />
    <JsonLd
      breadcrumbs={breadcrumbs}
      article={article}
      pageType={pageType}
      event={event}
      place={place}
      service={service}
      person={person}
    />
  </head>

  <body class="min-h-screen flex flex-col bg-white text-primary-900">
    {showPreloader && (
      <div id="preloader" aria-hidden="true">
        <!-- Fondo animado con partículas -->
        <div class="preloader-bg" aria-hidden="true">
          <div class="preloader-particle" style="--x:15%;--y:20%;--s:1.2;--d:6s"></div>
          <div class="preloader-particle" style="--x:80%;--y:15%;--s:0.8;--d:8s"></div>
          <div class="preloader-particle" style="--x:45%;--y:75%;--s:1.5;--d:7s"></div>
          <div class="preloader-particle" style="--x:70%;--y:60%;--s:0.6;--d:9s"></div>
          <div class="preloader-particle" style="--x:25%;--y:55%;--s:1;--d:5s"></div>
          <div class="preloader-particle" style="--x:90%;--y:40%;--s:0.9;--d:10s"></div>
          <div class="preloader-particle" style="--x:10%;--y:80%;--s:1.3;--d:7.5s"></div>
          <div class="preloader-particle" style="--x:60%;--y:85%;--s:0.7;--d:6.5s"></div>
        </div>

        <!-- Botón cerrar -->
        <button id="preloader-close" type="button" aria-label="Cerrar preloader">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1L17 17M17 1L1 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>

        <!-- Contenido central -->
        <div class="preloader-content">
          <!-- Logo con anillo luminoso -->
          <div class="preloader-logo-wrapper">
            <div class="preloader-glow-ring" aria-hidden="true"></div>
            <img src="/assets/images/brand/preloader.png" alt="" class="preloader-img" width="360" height="360" />
          </div>

          <!-- Textos animados -->
          <p class="preloader-subtitle">Municipalidad del Centro Poblado de</p>
          <h2 class="preloader-title" aria-label="IVOCHOTE">
            <span class="preloader-letter" style="--i:0">I</span><span class="preloader-letter" style="--i:1">V</span><span class="preloader-letter" style="--i:2">O</span><span class="preloader-letter" style="--i:3">C</span><span class="preloader-letter" style="--i:4">H</span><span class="preloader-letter" style="--i:5">O</span><span class="preloader-letter" style="--i:6">T</span><span class="preloader-letter" style="--i:7">E</span>
          </h2>

          <!-- Línea decorativa -->
          <div class="preloader-divider" aria-hidden="true"></div>

          <!-- Barra de progreso -->
          <div class="preloader-progress" aria-hidden="true">
            <div class="preloader-progress-bar"></div>
          </div>

          <!-- Hint para saltar -->
          <p class="preloader-hint">Toca para continuar</p>
        </div>
      </div>
    )}
    {showPreloader && (
      <aside
        id="site-disclaimer"
        class="site-disclaimer"
        role="dialog"
        aria-modal="true"
        aria-labelledby="site-disclaimer-title"
        aria-describedby="site-disclaimer-text"
        hidden
      >
        <div id="site-disclaimer-panel" class="site-disclaimer-inner" tabindex="-1">
          <div class="site-disclaimer-header">
            <div class="site-disclaimer-brand">
              <img
                src="/assets/images/brand/logoivo.png"
                alt="Logo de la Municipalidad del Centro Poblado de Ivochote"
                class="site-disclaimer-logo"
                width="140"
                height="140"
                loading="eager"
                decoding="async"
              />
              <p class="site-disclaimer-entity">Municipalidad del Centro Poblado de Ivochote</p>
              <p class="site-disclaimer-entity-sub">Distrito de Echarati · Provincia La Convención · Cusco</p>
            </div>
            <h2 id="site-disclaimer-title" class="site-disclaimer-title">Comunicado</h2>
            <p id="site-disclaimer-text" class="site-disclaimer-lead">
              Este sitio web ha sido desarrollado con fines educativos, académicos y demostrativos, como parte de un
              proyecto personal orientado al fortalecimiento de competencias en la carrera de Ingeniería Informática y
              de Sistemas, específicamente en el curso de Desarrollo de Aplicaciones Web.
            </p>
          </div>
          <div class="site-disclaimer-body">
            <p class="site-disclaimer-text">
              <strong class="site-disclaimer-label">Finalidad:</strong>
              La presente plataforma constituye una propuesta digital institucional, cuyo objetivo es simular y mejorar
              la experiencia de acceso a información municipal mediante herramientas tecnológicas modernas.
            </p>
            <p class="site-disclaimer-text">
              <strong class="site-disclaimer-label">Importante:</strong>
              Este sitio no corresponde a un portal oficial de la Municipalidad del Centro Poblado de Ivochote. Su
              contenido es referencial y ha sido diseñado exclusivamente con fines de aprendizaje y práctica
              profesional.
            </p>
            <p class="site-disclaimer-text">
              <strong class="site-disclaimer-label">Autorización:</strong>
              Este proyecto ha sido desarrollado previa autorización del alcalde de la Municipalidad del Centro Poblado
              de Ivochote, con el propósito de explorar soluciones digitales que puedan aportar valor a la comunidad.
            </p>
            <p class="site-disclaimer-text">
              <strong class="site-disclaimer-label">Responsable:</strong>
              El desarrollo, diseño e implementación de esta plataforma han sido realizados por Ezer Zúñiga Chura, como
              parte de su formación académica y crecimiento profesional en el área de desarrollo de software.
            </p>
            <p class="site-disclaimer-text">
              <strong class="site-disclaimer-label">Alcance:</strong>
              La información publicada, así como los documentos y enlaces disponibles, tienen carácter ilustrativo y no
              sustituyen los canales oficiales de atención municipal.
            </p>
            <p class="site-disclaimer-text">
              Agradecemos su comprensión y valoración de este trabajo académico como parte del proceso de formación
              profesional.
            </p>
          </div>
          <div class="site-disclaimer-actions">
            <a
              href="/downloads/OFICOP.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="site-disclaimer-link"
            >
              Ver permiso
            </a>
            <button id="site-disclaimer-ack" type="button" class="site-disclaimer-secondary-btn">
              Entendido
            </button>
          </div>
        </div>
      </aside>
    )}

    <Navbar />

    <main id="content" class="flex-1">
      <slot />
    </main>

    <Footer />

    <button
      id="scroll-to-top"
      type="button"
      class="fixed bottom-5 right-4 sm:bottom-6 sm:right-6 z-40 flex items-center justify-center w-11 h-11 rounded-none border border-primary-500/60 bg-primary-700 text-white shadow-lg shadow-primary-900/30 hover:bg-primary-800 active:bg-primary-900 opacity-0 translate-y-3 pointer-events-none transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-700 focus-visible:ring-offset-2"
      aria-label="Volver al inicio"
      title="Volver al inicio"
      hidden
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5m0 0-6 6m6-6 6 6" />
      </svg>
    </button>

    <script>
      (function() {
        const preloader = document.getElementById('preloader');
        if (!preloader) return;

        let dismissed = false;
        const el = preloader;
        const closeBtn = document.getElementById('preloader-close');
        const disclaimer = document.getElementById('site-disclaimer');
        const disclaimerAcknowledge = document.getElementById('site-disclaimer-ack');
        const disclaimerPanel = document.getElementById('site-disclaimer-panel');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const alreadySeen = sessionStorage.getItem('preloaderSeen') === '1';
        const disclaimerSeen = sessionStorage.getItem('siteDisclaimerSeen') === '1';
        let previousBodyOverflow = '';

        function showDisclaimer() {
          if (!disclaimer || disclaimerSeen) return;
          previousBodyOverflow = document.body.style.overflow;
          document.body.style.overflow = 'hidden';
          disclaimer.removeAttribute('hidden');
          requestAnimationFrame(() => {
            disclaimer.classList.add('is-visible');
            if (disclaimerPanel instanceof HTMLElement) {
              disclaimerPanel.scrollTop = 0;
              disclaimerPanel.focus({ preventScroll: true });
            }
          });
        }

        function closeDisclaimer() {
          if (!disclaimer) return;
          disclaimer.classList.remove('is-visible');
          sessionStorage.setItem('siteDisclaimerSeen', '1');
          document.body.style.overflow = previousBodyOverflow;
          setTimeout(() => {
            disclaimer.setAttribute('hidden', '');
          }, 220);
        }

        function removeImmediately() {
          dismissed = true;
          el.remove();
        }

        function closePreloader() {
          if (dismissed) return;
          dismissed = true;
          sessionStorage.setItem('preloaderSeen', '1');
          el.classList.add('preloader-exit');
          setTimeout(() => {
            el.remove();
            showDisclaimer();
          }, 800);
        }

        if (reducedMotion || alreadySeen) {
          removeImmediately();
          return;
        }

        if (closeBtn) closeBtn.addEventListener('click', closePreloader);
        if (disclaimerAcknowledge) disclaimerAcknowledge.addEventListener('click', closeDisclaimer);
        if (disclaimer) {
          disclaimer.addEventListener('click', (e) => {
            if (e.target === disclaimer) closeDisclaimer();
          });
        }

        el.addEventListener('click', (e) => {
          if (e.target === closeBtn || closeBtn?.contains(e.target as Node)) return;
          closePreloader();
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && disclaimer?.classList.contains('is-visible')) {
            closeDisclaimer();
            return;
          }
          if (e.key === 'Escape' || e.key === 'Enter') closePreloader();
        });

        // Auto-cierre corto para no bloquear la navegación principal.
        setTimeout(closePreloader, 1800);
      })();
    </script>
    <script>
      (function() {
        const scrollToTopBtn = document.getElementById('scroll-to-top');
        if (!(scrollToTopBtn instanceof HTMLElement)) return;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const showAfter = 320;
        let ticking = false;

        function setVisible(visible) {
          scrollToTopBtn.classList.toggle('opacity-0', !visible);
          scrollToTopBtn.classList.toggle('translate-y-3', !visible);
          scrollToTopBtn.classList.toggle('pointer-events-none', !visible);
          scrollToTopBtn.setAttribute('aria-hidden', visible ? 'false' : 'true');
          if (visible) {
            scrollToTopBtn.removeAttribute('tabindex');
          } else {
            scrollToTopBtn.setAttribute('tabindex', '-1');
          }
        }

        function updateVisibility() {
          setVisible(window.scrollY > showAfter);
        }

        function onScroll() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            updateVisibility();
            ticking = false;
          });
        }

        scrollToTopBtn.hidden = false;
        updateVisibility();

        window.addEventListener('scroll', onScroll, { passive: true });
        scrollToTopBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
          scrollToTopBtn.blur();
        });
      })();
    </script>
  </body>
</html>
