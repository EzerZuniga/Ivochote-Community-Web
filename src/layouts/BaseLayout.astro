---
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Head from '../components/seo/Head.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { SITE_CONFIG } from '../../config/site.config';
import '../styles/globals.css';

interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  showPreloader?: boolean;
  type?: 'website' | 'article';
  publishedTime?: string;
  author?: string;
  breadcrumbs?: BreadcrumbItem[];
  article?: {
    title: string;
    description?: string;
    image?: string;
    datePublished?: string;
    dateModified?: string;
    author?: string;
  };
  pageType?: 'WebPage' | 'ContactPage' | 'AboutPage' | 'CollectionPage';
}

const {
  title,
  description,
  image,
  canonical,
  noindex,
  showPreloader = false,
  type = 'website',
  publishedTime,
  author,
  breadcrumbs,
  article,
  pageType,
} = Astro.props as Props;
---

<!doctype html>
<html lang={SITE_CONFIG.language ?? 'es'}>
  <head>
    <Head
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      noindex={noindex}
      type={type}
      publishedTime={publishedTime}
      author={author}
    />
    <JsonLd breadcrumbs={breadcrumbs} article={article} pageType={pageType} />
  </head>

  <body class="min-h-screen flex flex-col bg-white text-primary-900">
    {showPreloader && (
      <div id="preloader" aria-hidden="true">
        <!-- Fondo animado con partículas -->
        <div class="preloader-bg" aria-hidden="true">
          <div class="preloader-particle" style="--x:15%;--y:20%;--s:1.2;--d:6s"></div>
          <div class="preloader-particle" style="--x:80%;--y:15%;--s:0.8;--d:8s"></div>
          <div class="preloader-particle" style="--x:45%;--y:75%;--s:1.5;--d:7s"></div>
          <div class="preloader-particle" style="--x:70%;--y:60%;--s:0.6;--d:9s"></div>
          <div class="preloader-particle" style="--x:25%;--y:55%;--s:1;--d:5s"></div>
          <div class="preloader-particle" style="--x:90%;--y:40%;--s:0.9;--d:10s"></div>
          <div class="preloader-particle" style="--x:10%;--y:80%;--s:1.3;--d:7.5s"></div>
          <div class="preloader-particle" style="--x:60%;--y:85%;--s:0.7;--d:6.5s"></div>
        </div>

        <!-- Botón cerrar -->
        <button id="preloader-close" type="button" aria-label="Cerrar preloader">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1L17 17M17 1L1 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>

        <!-- Contenido central -->
        <div class="preloader-content">
          <!-- Logo con anillo luminoso -->
          <div class="preloader-logo-wrapper">
            <div class="preloader-glow-ring" aria-hidden="true"></div>
            <img src="/assets/images/brand/preloader.png" alt="" class="preloader-img" width="360" height="360" />
          </div>

          <!-- Textos animados -->
          <p class="preloader-subtitle">Municipalidad del Centro Poblado de</p>
          <h2 class="preloader-title" aria-label="IVOCHOTE">
            <span class="preloader-letter" style="--i:0">I</span><span class="preloader-letter" style="--i:1">V</span><span class="preloader-letter" style="--i:2">O</span><span class="preloader-letter" style="--i:3">C</span><span class="preloader-letter" style="--i:4">H</span><span class="preloader-letter" style="--i:5">O</span><span class="preloader-letter" style="--i:6">T</span><span class="preloader-letter" style="--i:7">E</span>
          </h2>

          <!-- Línea decorativa -->
          <div class="preloader-divider" aria-hidden="true"></div>

          <!-- Barra de progreso -->
          <div class="preloader-progress" aria-hidden="true">
            <div class="preloader-progress-bar"></div>
          </div>

          <!-- Hint para saltar -->
          <p class="preloader-hint">Toca para continuar</p>
        </div>
      </div>
    )}

    <a class="sr-only focus:not-sr-only focus:absolute top-4 left-4 bg-primary-900 text-white px-3 py-2 rounded z-[100]" href="#content">Saltar al contenido</a>

    <Navbar />

    <main id="content" class="flex-1">
      <slot />
    </main>

    <Footer />

    <script>
      (function() {
        const preloader = document.getElementById('preloader');
        if (!preloader) return;

        let dismissed = false;
        const el = preloader;

        function closePreloader() {
          if (dismissed) return;
          dismissed = true;
          el.classList.add('preloader-exit');
          setTimeout(() => {
            el.remove();
          }, 800);
        }

        const closeBtn = document.getElementById('preloader-close');
        if (closeBtn) closeBtn.addEventListener('click', closePreloader);

        el.addEventListener('click', (e) => {
          if (e.target === closeBtn || closeBtn?.contains(e.target as Node)) return;
          closePreloader();
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' || e.key === 'Enter') closePreloader();
        });

        // Auto-cerrar cuando la barra de progreso termina (~3.5s)
        setTimeout(closePreloader, 3600);
      })();
    </script>
  </body>
</html>
