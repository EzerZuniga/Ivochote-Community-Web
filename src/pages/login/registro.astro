---
import { SITE_CONFIG } from "../../../config/site.config";
import AuthLayout from "../../layouts/AuthLayout.astro";
import { buildFirebasePublicConfig } from "../../api/firebaseConfig";

const pageTitle = `Registrarse | ${SITE_CONFIG.shortTitle}`;
const pageDescription = "Crea tu cuenta en el portal ciudadano de Ivochote para realizar tramites y seguimiento en linea.";
const firebasePublicConfig = buildFirebasePublicConfig(import.meta.env);
---

<AuthLayout pageTitle={pageTitle} pageDescription={pageDescription}>
  <div class="auth-card-header">
    <img src="/assets/images/brand/logoivo.png" alt="Escudo institucional de Ivochote" class="auth-card-logo" width="52" height="52" />
    <p class="auth-overline">Registro ciudadano</p>
  </div>
  <h1 class="auth-title">Crea tu cuenta institucional</h1>
  <p class="auth-support-text">
    Registra tus datos para acceder a servicios municipales, tramites y seguimiento en linea.
  </p>
  <p id="auth-status" class="auth-status" role="status" aria-live="polite">
    Completa el formulario para crear tu cuenta.
  </p>

  <form id="auth-register-form" class="auth-form" novalidate>
    <div class="auth-field-wrap">
      <label for="auth-name" class="auth-label">Nombre completo</label>
      <input id="auth-name" name="name" type="text" autocomplete="name" required minlength="3" class="auth-input" placeholder="Ej. Maria Quispe" />
    </div>

    <div class="auth-field-wrap">
      <label for="auth-email" class="auth-label">Correo electronico</label>
      <input id="auth-email" name="email" type="email" autocomplete="email" inputmode="email" spellcheck="false" required class="auth-input" placeholder="correo@ejemplo.com" />
    </div>

    <div class="auth-field-wrap">
      <label for="auth-password" class="auth-label">Contrasena</label>
      <input id="auth-password" name="password" type="password" autocomplete="new-password" required minlength="8" class="auth-input" placeholder="Minimo 8 caracteres" />
    </div>

    <div class="auth-field-wrap">
      <label for="auth-confirm-password" class="auth-label">Confirmar contrasena</label>
      <input id="auth-confirm-password" name="confirmPassword" type="password" autocomplete="new-password" required minlength="8" class="auth-input" placeholder="Repite tu contrasena" />
    </div>

    <button id="auth-submit" type="submit" class="auth-primary-btn">Crear cuenta</button>
  </form>

  <div class="auth-divider" aria-hidden="true">o</div>

  <button id="auth-google-btn" type="button" class="auth-google-btn">
    <svg class="auth-google-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="#4285F4" d="M23.52 12.27c0-.84-.07-1.64-.2-2.42H12v4.58h6.48c-.28 1.48-1.12 2.74-2.39 3.59v2.99h3.87c2.26-2.08 3.56-5.15 3.56-8.74z"/>
      <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.92l-3.87-2.99c-1.08.72-2.45 1.15-4.06 1.15-3.12 0-5.77-2.11-6.72-4.94H1.29v3.09A11.99 11.99 0 0 0 12 24z"/>
      <path fill="#FBBC05" d="M5.28 14.3A7.2 7.2 0 0 1 4.9 12c0-.8.14-1.57.38-2.3V6.61H1.29A12 12 0 0 0 0 12c0 1.94.47 3.77 1.29 5.39l3.99-3.09z"/>
      <path fill="#EA4335" d="M12 4.77c1.76 0 3.34.61 4.59 1.81l3.44-3.44C17.94 1.08 15.24 0 12 0 7.31 0 3.26 2.69 1.29 6.61L5.28 9.7c.95-2.83 3.6-4.93 6.72-4.93z"/>
    </svg>
    <span>Continuar con Google</span>
  </button>

  <p class="auth-footnote">
    Ya tienes cuenta? <a href="/login" class="auth-footnote-link">Inicia sesion</a>.
  </p>

  <Fragment slot="scripts">
    <script id="firebase-config" type="application/json" is:inline set:html={JSON.stringify(firebasePublicConfig)}></script>

    <script>
      // @ts-nocheck
      const firebaseConfigElement = document.getElementById("firebase-config");
      let firebasePublicConfig = {};
      try {
        firebasePublicConfig = firebaseConfigElement?.textContent
          ? JSON.parse(firebaseConfigElement.textContent)
          : {};
      } catch {
        firebasePublicConfig = {};
      }

      const registerForm = document.getElementById("auth-register-form");
      const authNameInput = document.getElementById("auth-name");
      const authEmailInput = document.getElementById("auth-email");
      const authPasswordInput = document.getElementById("auth-password");
      const authConfirmInput = document.getElementById("auth-confirm-password");
      const authSubmitBtn = document.getElementById("auth-submit");
      const authGoogleBtn = document.getElementById("auth-google-btn");
      const authStatus = document.getElementById("auth-status");
      let auth = null;
      let authApi = null;

      function setStatus(message, tone = "neutral") {
        if (!authStatus) return;
        authStatus.textContent = message;
        authStatus.className = "auth-status";
        if (tone === "success") authStatus.classList.add("is-success");
        if (tone === "error") authStatus.classList.add("is-error");
      }

      function setLoading(isLoading) {
        if (authSubmitBtn) {
          authSubmitBtn.disabled = isLoading;
          authSubmitBtn.textContent = isLoading ? "Creando cuenta..." : "Crear cuenta";
        }
        if (authGoogleBtn) {
          authGoogleBtn.disabled = isLoading;
        }
      }

      function extractAuthCode(error) {
        const candidates = [String(error?.code || ""), String(error?.message || "")];
        for (const candidate of candidates) {
          const match = candidate.toLowerCase().match(/auth\/[a-z0-9-]+/);
          if (match?.[0]) return match[0];
        }
        return "";
      }

      function normalizeError(error) {
        const code = extractAuthCode(error);
        switch (code) {
          case "auth/operation-not-allowed":
            return "Correo/contrasena no esta habilitado en Firebase Authentication.";
          case "auth/configuration-not-found":
            return "Firebase Authentication no esta configurado en este proyecto.";
          case "auth/invalid-api-key":
          case "auth/api-key-not-valid":
            return "La API key de Firebase es invalida. Actualiza PUBLIC_FIREBASE_API_KEY.";
          case "auth/app-not-authorized":
          case "auth/unauthorized-domain":
            return "Dominio no autorizado. Agrega localhost en Firebase Authorized domains.";
          case "auth/email-already-in-use":
            return "Este correo ya esta registrado.";
          case "auth/invalid-email":
            return "El correo electronico no es valido.";
          case "auth/weak-password":
            return "La contrasena es muy debil. Usa al menos 8 caracteres.";
          case "auth/popup-closed-by-user":
            return "Cerraste la ventana de Google antes de completar el acceso.";
          case "auth/popup-blocked":
          case "auth/cancelled-popup-request":
            return "El navegador bloqueo la ventana de Google. Habilita pop-ups.";
          case "auth/network-request-failed":
            return "No hay conexion. Verifica internet e intenta otra vez.";
          case "auth/too-many-requests":
            return "Demasiados intentos. Espera unos minutos e intentalo de nuevo.";
          default:
            return `No se pudo completar el registro (${code || "error-desconocido"}).`;
        }
      }

      function hasFirebaseConfig(config) {
        return Boolean(config.apiKey && config.authDomain && config.projectId && config.appId);
      }

      async function initFirebase() {
        if (!hasFirebaseConfig(firebasePublicConfig)) {
          setStatus("Falta configurar Firebase en .env para habilitar el registro real.", "error");
          return false;
        }
        if (auth && authApi) return true;

        try {
          const appMod = await import("firebase/app");
          authApi = await import("firebase/auth");
          const app = appMod.getApps().length ? appMod.getApp() : appMod.initializeApp(firebasePublicConfig);
          auth = authApi.getAuth(app);
          await authApi.setPersistence(auth, authApi.browserLocalPersistence);
          return true;
        } catch (error) {
          setStatus(normalizeError(error), "error");
          return false;
        }
      }

      async function handleGoogleSignIn() {
        const ready = await initFirebase();
        if (!ready || !auth || !authApi) return;
        const provider = new authApi.GoogleAuthProvider();
        provider.setCustomParameters({ prompt: "select_account" });

        setLoading(true);
        setStatus("Abriendo Google...");
        try {
          await authApi.signInWithPopup(auth, provider);
          setStatus("Cuenta iniciada con Google.", "success");
        } catch (error) {
          const code = extractAuthCode(error);
          if (code === "auth/popup-blocked" || code === "auth/cancelled-popup-request") {
            setStatus("Popup bloqueado. Redirigiendo a Google...", "neutral");
            try {
              await authApi.signInWithRedirect(auth, provider);
              return;
            } catch (redirectError) {
              setStatus(normalizeError(redirectError), "error");
              return;
            }
          }
          setStatus(normalizeError(error), "error");
        } finally {
          setLoading(false);
        }
      }

      async function handleRegister(event) {
        event.preventDefault();
        const ready = await initFirebase();
        if (!ready || !auth || !authApi) return;

        const name = String(authNameInput?.value || "").trim();
        const email = String(authEmailInput?.value || "").trim();
        const password = String(authPasswordInput?.value || "");
        const confirmPassword = String(authConfirmInput?.value || "");

        if (name.length < 3) {
          setStatus("Ingresa tu nombre completo (minimo 3 caracteres).", "error");
          return;
        }
        if (!email || !password || !confirmPassword) {
          setStatus("Completa todos los campos.", "error");
          return;
        }
        if (password.length < 8) {
          setStatus("La contrasena debe tener al menos 8 caracteres.", "error");
          return;
        }
        if (password !== confirmPassword) {
          setStatus("Las contrasenas no coinciden.", "error");
          return;
        }

        setLoading(true);
        setStatus("Creando tu cuenta...");

        try {
          const result = await authApi.createUserWithEmailAndPassword(auth, email, password);
          await authApi.updateProfile(result.user, { displayName: name });
          await authApi.sendEmailVerification(result.user).catch(() => {});
          setStatus("Cuenta creada con exito. Revisa tu correo y luego inicia sesion.", "success");

          setTimeout(() => {
            window.location.assign("/login");
          }, 1200);
        } catch (error) {
          setStatus(normalizeError(error), "error");
        } finally {
          setLoading(false);
        }
      }

      authGoogleBtn?.addEventListener("click", handleGoogleSignIn);
      registerForm?.addEventListener("submit", handleRegister);
      initFirebase();
    </script>
  </Fragment>
</AuthLayout>
