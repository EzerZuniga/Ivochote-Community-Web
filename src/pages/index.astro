---
import HomeLayout from '../layouts/HomeLayout.astro';
import { fetchNews } from '../services/newsService';
import { getFeaturedPlaces } from '../services/tourismService';
import { fetchServices } from '../services/servicesService';
import { fetchEvents } from '../services/eventsService';
import { formatDate } from '../utils/formatters';

const news = await fetchNews();
const places = await getFeaturedPlaces();
const services = await fetchServices();
const events = await fetchEvents();

const tourismCategoryLabel: Record<string, string> = {
  naturaleza: 'Naturaleza',
  cultura: 'Cultura',
  aventura: 'Aventura',
  gastronomia: 'Gastronomía',
};
const tourismCategoryColor: Record<string, string> = {
  naturaleza: 'bg-emerald-600',
  cultura: 'bg-amber-500',
  aventura: 'bg-primary-700',
  gastronomia: 'bg-orange-500',
};
---

<HomeLayout
  subtitle="Portal web oficial de la Municipalidad del Centro Poblado de Ivochote. Servicios municipales, noticias, turismo y eventos del distrito de Echarati, La Convención, Cusco, Perú."
  heroSlides={[
    {
      image: "/assets/images/carrusel/foto1.png",
      title: "Bienvenidos a Ivochote",
      subtitle: "Centro Poblado del distrito de Echarati, puerta de ingreso a la selva de La Convención, Cusco."
    },
    {
      image: "/assets/images/carrusel/foto2.png",
      title: "Naturaleza y Cultura Viva",
      subtitle: "Riqueza cultural extraordinaria, comunidades nativas y biodiversidad única en la selva cusqueña."
    },
    {
      image: "/assets/images/carrusel/foto3.png",
      title: "Trabajando por Nuestro Pueblo",
      subtitle: "Gestión municipal comprometida con el desarrollo y bienestar de toda la comunidad."
    }
  ]}
  ctaText="Contáctanos"
  ctaHref="/contacto"
>
  <div slot="news">
    {news.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {news.slice(0, 3).map(n => (
          <a
            href={`/noticias/${n.slug}`}
            class="news-home-card group bg-white border border-gray-200 overflow-hidden flex flex-col no-underline transition-all duration-300"
          >
            {n.image ? (
              <div class="overflow-hidden bg-primary-50" style="aspect-ratio:16/9">
                <img
                  src={n.image}
                  alt={n.title}
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ) : (
              <div class="bg-primary-100 flex items-center justify-center" style="aspect-ratio:16/9">
                <svg class="w-8 h-8 text-primary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                </svg>
              </div>
            )}
            <div class="p-5 flex flex-col flex-1">
              {n.category && (
                <span class="text-[10px] font-bold uppercase tracking-widest text-primary-600 mb-2">{n.category}</span>
              )}
              <h3 class="font-extrabold text-primary-900 text-sm sm:text-base leading-snug group-hover:text-primary-700 transition-colors line-clamp-2 flex-1">
                {n.title}
              </h3>
              <time class="text-xs text-primary-900/40 mt-3 block font-medium" datetime={n.date}>{formatDate(n.date)}</time>
            </div>
            <div class="h-[3px] bg-primary-600 scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300" aria-hidden="true"></div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-sm text-primary-900/50 text-center">No hay noticias disponibles.</p>
    )}
  </div>

  <div slot="tourism">
    {places.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {places.map(p => {
          const badge = tourismCategoryLabel[p.category] ?? p.category;
          const badgeBg = tourismCategoryColor[p.category] ?? 'bg-primary-700';
          return (
            <article class="group bg-white border border-gray-200 overflow-hidden flex flex-col shadow-md shadow-primary-950/10 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-2xl hover:shadow-primary-950/20">
              {/* Imagen */}
              <a href={`/turismo/${p.slug}`} class="relative block overflow-hidden" style="aspect-ratio:4/3">
                {p.images?.[0] ? (
                  <img
                    src={p.images[0]}
                    alt={p.name}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.05]"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="w-full h-full bg-primary-100 flex items-center justify-center">
                    <svg class="w-10 h-10 text-primary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                    </svg>
                  </div>
                )}
                {/* Gradiente inferior */}
                <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-black/30 to-transparent pointer-events-none" aria-hidden="true"></div>
              </a>

              {/* Badge de categoría — en el borde imagen/contenido */}
              <div class="px-5 -mt-4 relative z-10">
                <span class={`inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-widest text-white px-3 py-1 ${badgeBg}`}>
                  <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  {badge}
                </span>
              </div>

              {/* Contenido */}
              <div class="px-5 pt-3 pb-4 flex flex-col flex-1">
                <a href={`/turismo/${p.slug}`} class="no-underline">
                  <h3 class="text-lg font-extrabold text-primary-950 leading-snug group-hover:text-primary-700 transition-colors">
                    {p.name}
                  </h3>
                </a>

                {(p.location || p.duration) && (
                  <p class="text-xs text-primary-900/45 mt-1.5 font-medium">
                    {p.location && <span>{p.location}</span>}
                    {p.location && p.duration && <span class="mx-1.5 opacity-50">·</span>}
                    {p.duration && <span>{p.duration}</span>}
                  </p>
                )}

                {p.description && (
                  <p class="text-sm text-primary-900/60 mt-2 leading-relaxed line-clamp-3 flex-1">
                    {p.description}
                  </p>
                )}

                <a
                  href={`/turismo/${p.slug}`}
                  class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-primary-700 hover:text-primary-500 transition-colors"
                >
                  Conocer más
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                  </svg>
                </a>
              </div>

              {/* Línea de acento inferior */}
              <div class={`h-[3px] ${badgeBg} scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300`} aria-hidden="true"></div>
            </article>
          );
        })}
      </div>
    ) : (
      <p class="text-sm text-primary-900/50 text-center">Atractivos turísticos próximamente.</p>
    )}
  </div>

  <!-- ===== ESTADÍSTICAS ===== -->
  <div slot="stats">
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 text-center">
      {[
        {
          value: 3, label: 'Niveles Ed.', href: '/contacto',
          svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-9 h-9">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
          </svg>`,
        },
        {
          value: services.length, label: 'Servicios', href: '/servicios',
          svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-9 h-9">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" />
          </svg>`,
        },
        {
          value: events.length, label: 'Eventos', href: '/eventos',
          svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-9 h-9">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15zm0 2.25h.008v.008H12v-.008zM9.75 15h.008v.008H9.75V15zm0 2.25h.008v.008H9.75v-.008zM7.5 15h.008v.008H7.5V15zm0 2.25h.008v.008H7.5v-.008zm6.75-4.5h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V15zm0 2.25h.008v.008h-.008v-.008zm2.25-4.5h.008v.008H16.5v-.008zm0 2.25h.008v.008H16.5V15z" />
          </svg>`,
        },
        {
          value: places.length, label: 'Destinos', href: '/turismo',
          svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-9 h-9">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>`,
        },
      ].map((stat) => (
        <a
          href={stat.href}
          class="stat-card group flex flex-col items-center gap-2 p-5 cursor-pointer no-underline
                 border border-white/15 hover:border-amber-400/70
                 transition-all duration-300 hover:-translate-y-1 hover:bg-white/8 backdrop-blur-sm"
          aria-label={`Ver ${stat.label}`}
        >
          <span class="text-white/80 transition-colors duration-300 group-hover:text-amber-400" aria-hidden="true">
            <Fragment set:html={stat.svg} />
          </span>
          <span
            class="stat-number text-4xl sm:text-5xl font-black text-white leading-none
                   transition-colors duration-300 group-hover:text-amber-400"
            data-target={stat.value}
          >0</span>
          <span class="text-[11px] sm:text-xs font-bold text-white/60 uppercase tracking-widest
                       transition-colors duration-300 group-hover:text-amber-300">
            {stat.label}
          </span>
          <span class="block h-[2px] w-0 bg-amber-400 transition-all duration-500 group-hover:w-3/4" aria-hidden="true"></span>
        </a>
      ))}
    </div>

    <script>
      (function () {
        function animateCounter(el: HTMLElement, target: number, duration: number) {
          const start = performance.now();
          const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
          function step(now: number) {
            const elapsed = now - start;
            const progress = Math.min(elapsed / duration, 1);
            el.textContent = String(Math.round(easeOut(progress) * target));
            if (progress < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        }

        const section = document.getElementById('stats-section');
        if (!section) return;

        let triggered = false;
        const observer = new IntersectionObserver(
          (entries) => {
            if (triggered) return;
            const entry = entries[0];
            if (!entry.isIntersecting) return;
            triggered = true;
            observer.disconnect();
            section.querySelectorAll<HTMLElement>('.stat-number').forEach((el) => {
              const target = parseInt(el.dataset.target ?? '0', 10);
              animateCounter(el, target, 1600);
            });
          },
          { threshold: 0.3 }
        );
        observer.observe(section);
      })();
    </script>
  </div>

  <!-- ===== ATENCIÓN AL CIUDADANO ===== -->
  <div slot="citizen-services">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-5 lg:gap-6">
      {[
        {
          title: 'Registro Civil',
          href: '/servicios/registro-civil',
          vb: '0 0 64 64',
          icon: `<rect x="4" y="10" width="56" height="44" rx="4" fill="none"/><rect x="12" y="4" width="40" height="12" rx="3" fill="none"/><circle cx="24" cy="32" r="7"/><path d="M13 50c0-6.075 4.925-11 11-11s11 4.925 11 11"/><line x1="40" y1="28" x2="52" y2="28"/><line x1="40" y1="35" x2="52" y2="35"/><line x1="40" y1="42" x2="48" y2="42"/>`,
        },
        {
          title: 'Mesa de Partes Virtual',
          href: '/contacto',
          vb: '0 0 64 64',
          icon: `<rect x="8" y="12" width="36" height="48" rx="3" fill="none"/><path d="M18 12V7a5 5 0 0110 0v5"/><rect x="20" y="4" width="6" height="6" rx="1" fill="none"/><line x1="16" y1="24" x2="36" y2="24"/><line x1="16" y1="32" x2="36" y2="32"/><line x1="16" y1="40" x2="30" y2="40"/><path d="M44 20l12 10-12 10" fill="none"/><line x1="44" y1="30" x2="56" y2="30"/>`,
        },
        {
          title: 'Licencias y Autorizaciones',
          href: '/servicios/licencias-autorizaciones',
          vb: '0 0 64 64',
          icon: `<path d="M32 4L8 18v14c0 16 10 26 24 28 14-2 24-12 24-28V18L32 4z" fill="none"/><polyline points="20,32 28,40 44,24" fill="none"/>`,
        },
        {
          title: 'Programas Sociales',
          href: '/servicios/programas-sociales',
          vb: '0 0 64 64',
          icon: `<circle cx="32" cy="16" r="8"/><path d="M16 56v-6c0-6.627 7.163-12 16-12s16 5.373 16 12v6"/><circle cx="12" cy="22" r="5.5"/><path d="M4 56v-4c0-4.418 3.582-8 8-8"/><circle cx="52" cy="22" r="5.5"/><path d="M60 56v-4c0-4.418-3.582-8-8-8"/>`,
        },
        {
          title: 'Defensa Civil',
          href: '/servicios/defensa-civil',
          vb: '0 0 64 64',
          icon: `<path d="M32 6L4 56h56L32 6z" fill="none"/><line x1="32" y1="24" x2="32" y2="38"/><circle cx="32" cy="46" r="2.5" fill="currentColor" stroke="none"/>`,
        },
        {
          title: 'Limpieza Pública',
          href: '/servicios/limpieza-publica',
          vb: '0 0 64 64',
          icon: `<path d="M20 8h24v6H20z" fill="none"/><path d="M16 14h32l-4 42H20L16 14z" fill="none"/><line x1="26" y1="22" x2="24" y2="48"/><line x1="32" y1="22" x2="32" y2="48"/><line x1="38" y1="22" x2="40" y2="48"/><path d="M12 14h40"/>`,
        },
        {
          title: 'Biblioteca Municipal',
          href: '/servicios/biblioteca-municipal',
          vb: '0 0 64 64',
          icon: `<path d="M32 12C26 8 18 6 8 6v40c10 0 18 2 24 6" fill="none"/><path d="M32 12c6-4 14-6 24-6v40c-10 0-18 2-24 6" fill="none"/><line x1="32" y1="12" x2="32" y2="52"/><line x1="14" y1="18" x2="26" y2="18"/><line x1="14" y1="26" x2="26" y2="26"/><line x1="14" y1="34" x2="24" y2="34"/><line x1="38" y1="18" x2="50" y2="18"/><line x1="38" y1="26" x2="50" y2="26"/>`,
        },
        {
          title: 'Libro de Reclamaciones',
          href: '/contacto',
          vb: '0 0 64 64',
          icon: `<path d="M12 4h32a4 4 0 014 4v48a4 4 0 01-4 4H12a4 4 0 01-4-4V8a4 4 0 014-4z" fill="none"/><path d="M8 8h6v48H8" fill="none"/><line x1="22" y1="18" x2="40" y2="18"/><line x1="22" y1="26" x2="40" y2="26"/><line x1="22" y1="34" x2="36" y2="34"/><path d="M38 42l10 2-2 10-10-2z" fill="none"/><line x1="38" y1="42" x2="48" y2="44"/>`,
        },
      ].map((svc, i) => (
        <a
          href={svc.href}
          class="citizen-card group relative flex flex-col items-center overflow-hidden bg-primary-100"
          style={`--delay: ${i * 0.06}s`}
        >
          {/* Zona del icono */}
          <div class="citizen-card-icon relative w-full flex items-center justify-center pt-10 pb-8 sm:pt-14 sm:pb-10">
            <svg class="w-20 h-20 sm:w-24 sm:h-24 text-primary-950 transition-all duration-400 group-hover:scale-110 group-hover:text-white relative z-10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox={svc.vb} stroke-linecap="round" stroke-linejoin="round">
              <Fragment set:html={svc.icon} />
            </svg>
            {/* Línea decorativa al borde inferior del icono */}
            <div class="citizen-card-line absolute bottom-0 left-0 right-0 h-[3px] bg-amber-500" aria-hidden="true"></div>
          </div>

          {/* Zona del texto */}
          <div class="citizen-card-text relative w-full text-center px-3 py-4 sm:px-4 sm:py-5">
            <h3 class="font-bold text-sm sm:text-base text-primary-950 leading-snug transition-colors duration-400 group-hover:text-white relative z-10">
              {svc.title}
            </h3>
          </div>

          {/* Overlay verde oscuro que sube desde abajo */}
          <div class="citizen-card-overlay absolute inset-0 bg-primary-900" aria-hidden="true"></div>

          {/* Triángulo dorado en esquina inferior derecha */}
          <div class="citizen-card-corner absolute bottom-0 right-0" aria-hidden="true">
            <svg width="44" height="44" viewBox="0 0 44 44" class="block">
              <polygon points="44,0 44,44 0,44" fill="#C9A227"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- ===== INSTITUCIÓN EDUCATIVA ===== -->
  <div slot="authorities">

    <!-- Tarjetas de niveles educativos -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      {[
        {
          num: '01',
          nivel: 'Inicial',
          headerBg: 'bg-amber-400',
          chipBg: 'bg-amber-50',
          chipText: 'text-amber-700',
          chipBorder: 'border-amber-200',
          barBg: 'bg-amber-400',
          meta: '3 a 5 años',
          desc: 'Formación integral a través del juego, la afectividad y el desarrollo de habilidades cognitivas y sociales en la primera infancia.',
          icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15.182 15.182a4.5 4.5 0 01-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z"/>`,
        },
        {
          num: '02',
          nivel: 'Primaria',
          headerBg: 'bg-emerald-500',
          chipBg: 'bg-emerald-50',
          chipText: 'text-emerald-700',
          chipBorder: 'border-emerald-200',
          barBg: 'bg-emerald-500',
          meta: '6 grados · 1.° al 6.°',
          desc: 'Seis años de formación que desarrollan competencias en comunicación, matemática y ciencias para el crecimiento integral del estudiante.',
          icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/>`,
        },
        {
          num: '03',
          nivel: 'Secundaria',
          headerBg: 'bg-primary-800',
          chipBg: 'bg-primary-50',
          chipText: 'text-primary-700',
          chipBorder: 'border-primary-200',
          barBg: 'bg-primary-800',
          meta: '5 años · 1.° al 5.°',
          desc: 'Educación secundaria completa que prepara a los jóvenes con sólidas bases académicas para la educación superior y la vida profesional.',
          icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/>`,
        },
      ].map(level => (
        <article class="group bg-white border border-gray-200 overflow-hidden transition-shadow duration-200 hover:shadow-md">
          <!-- Cabecera sólida con número e icono -->
          <div class={`${level.headerBg} px-5 py-5 flex items-center gap-4`}>
            <div class="w-11 h-11 bg-white/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <Fragment set:html={level.icon}/>
              </svg>
            </div>
            <div>
              <span class="text-[11px] font-bold text-white/60 uppercase tracking-[0.1em]">Nivel {level.num}</span>
              <h3 class="text-xl font-extrabold text-white leading-none mt-0.5">{level.nivel}</h3>
            </div>
          </div>
          <!-- Cuerpo -->
          <div class="p-5 flex flex-col gap-3">
            <span class={`self-start inline-flex items-center gap-1.5 text-xs font-semibold ${level.chipText} ${level.chipBg} border ${level.chipBorder} px-2.5 py-1`}>
              <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              {level.meta}
            </span>
            <p class="text-sm text-primary-900/65 leading-relaxed">{level.desc}</p>
          </div>
          <!-- Línea de acento inferior que se expande en hover -->
          <div class={`h-[3px] ${level.barBg} scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300`} aria-hidden="true"></div>
        </article>
      ))}
    </div>

    <!-- CTA centrado -->
    <div class="mt-10 text-center">
      <a href="/contacto" class="inline-flex items-center gap-2 px-7 py-3.5 bg-primary-600 hover:bg-primary-700 text-white font-semibold text-sm uppercase tracking-wider transition-colors duration-200">
        Contáctanos para más información
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </div>

  <!-- ===== CTA BANNER ===== -->
  <div slot="cta">
    <section class="py-16 sm:py-20 bg-primary-50 border-t border-primary-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Cabecera centrada -->
        <div class="text-center mb-12">
          <span class="inline-flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-primary-600 mb-4">
            <span class="block w-8 h-px bg-primary-600"></span>
            Portal ciudadano
            <span class="block w-8 h-px bg-primary-600"></span>
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-primary-900 leading-tight">
            Tu voz importa en nuestra comunidad
          </h2>
          <p class="mt-4 text-base text-primary-900/50 max-w-xl mx-auto leading-relaxed">
            Accede a información oficial, consulta documentos y acuerdos municipales. Tu participación activa fortalece Ivochote.
          </p>
        </div>

        <!-- Cards de acceso rápido -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
          {[
            {
              icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>',
              title: 'Documentos oficiales',
              desc: 'Acuerdos, ordenanzas y resoluciones municipales publicadas.',
              href: '/servicios',
            },
            {
              icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>',
              title: 'Presupuesto participativo',
              desc: 'Consulta la ejecución presupuestal y el gasto municipal.',
              href: '/servicios',
            },
            {
              icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>',
              title: 'Mesa de partes virtual',
              desc: 'Envía documentos y realiza trámites sin salir de casa.',
              href: '/contacto',
            },
          ].map(card => (
            <a
              href={card.href}
              class="group relative flex flex-col gap-3 border border-primary-200 bg-primary-50 hover:border-primary-400 hover:bg-primary-100 px-6 py-6 transition-all duration-200 overflow-hidden"
            >
              <div class="w-10 h-10 bg-primary-600 group-hover:bg-primary-500 flex items-center justify-center transition-colors duration-200">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <Fragment set:html={card.icon} />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-primary-900 text-sm leading-snug">{card.title}</h3>
                <p class="text-xs text-primary-900/50 mt-1 leading-relaxed">{card.desc}</p>
              </div>
              <span class="absolute bottom-0 left-0 w-full h-0.5 bg-primary-600 scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300"></span>
            </a>
          ))}
        </div>

        <!-- Botones CTA -->
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href="/contacto"
            class="inline-flex items-center gap-2 px-6 py-3.5 bg-primary-600 hover:bg-primary-700 text-white font-bold text-sm uppercase tracking-wider transition-colors duration-200"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Contáctanos
          </a>
          <a
            href="/servicios"
            class="inline-flex items-center gap-2 px-6 py-3.5 border border-primary-600 text-primary-700 font-bold text-sm uppercase tracking-wider hover:bg-primary-600 hover:text-white transition-colors duration-200"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            Ver servicios
          </a>
        </div>

      </div>
    </section>
  </div>
</HomeLayout>
