---
import HomeLayout from "../layouts/HomeLayout.astro";
import HomeNewsGrid from "../components/home/HomeNewsGrid.astro";
import HomeTourismGrid from "../components/home/HomeTourismGrid.astro";
import HomeStats from "../components/home/HomeStats.astro";
import HomeCitizenServices from "../components/home/HomeCitizenServices.astro";
import HomeEducationLevels from "../components/home/HomeEducationLevels.astro";
import HomeCtaBanner from "../components/home/HomeCtaBanner.astro";
import { fetchNews } from "../services/newsService";
import { fetchPlaces, getFeaturedPlaces } from "../services/tourismService";
import { fetchServices } from "../services/servicesService";
import { fetchEvents } from "../services/eventsService";

const news = await fetchNews();
const services = await fetchServices();
const events = await fetchEvents();
const allPlaces = await fetchPlaces();
const featuredPlaces = await getFeaturedPlaces();
---

<HomeLayout
  subtitle="Portal web oficial de la Municipalidad del Centro Poblado de Ivochote. Servicios municipales, noticias, turismo y eventos del distrito de Echarati, La Convención, Cusco, Perú."
  heroSlides={[
    {
      image: "/assets/images/carrusel/foto1.png",
      title: "Bienvenidos a Ivochote",
      subtitle: "Centro Poblado del distrito de Echarati, puerta de ingreso a la selva de La Convención, Cusco.",
    },
    {
      image: "/assets/images/carrusel/foto2.png",
      title: "Naturaleza y Cultura Viva",
      subtitle: "Riqueza cultural extraordinaria, comunidades nativas y biodiversidad única en la selva cusqueña.",
    },
    {
      image: "/assets/images/carrusel/foto3.png",
      title: "Trabajando por Nuestro Pueblo",
      subtitle: "Gestión municipal comprometida con el desarrollo y bienestar de toda la comunidad.",
    },
  ]}
  ctaText="Contáctanos"
  ctaHref="/contacto"
>
  <div slot="news">
    <HomeNewsGrid news={news} />
  </div>

  <div slot="tourism">
    <HomeTourismGrid places={featuredPlaces.length > 0 ? featuredPlaces : allPlaces} />
  </div>

  <div slot="stats">
    <HomeStats
      servicesCount={services.length}
      eventsCount={events.length}
      placesCount={allPlaces.length}
      educationLevelsCount={3}
    />
  </div>

  <div slot="citizen-services">
    <HomeCitizenServices services={services} />
  </div>

  <div slot="authorities">
    <HomeEducationLevels />
  </div>

  <div slot="cta">
    <HomeCtaBanner />
  </div>
</HomeLayout>
