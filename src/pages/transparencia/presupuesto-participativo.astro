---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/commonComponents/Breadcrumbs.astro";
---

<BaseLayout
  title="Presupuesto Participativo"
  description="Información referencial sobre planificación, ejecución y participación ciudadana del presupuesto municipal de Ivochote."
  breadcrumbs={[
    { name: "Transparencia", href: "/transparencia" },
    { name: "Presupuesto Participativo", href: "/transparencia/presupuesto-participativo" },
  ]}
  pageType="CollectionPage"
>
  <section class="municipal-hero municipal-hero--presupuesto bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <Breadcrumbs
        items={[
          { href: "/", label: "Inicio" },
          { href: "/transparencia", label: "Transparencia" },
          { label: "Presupuesto Participativo" },
        ]}
        className="mb-6"
      />
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 bg-white/10 p-3.5" aria-hidden="true">
          <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7h18M6 11h12M8 15h8m5 4H3V5h18v14z"/>
          </svg>
        </div>
        <div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Presupuesto Participativo</h1>
          <p class="mt-1.5 text-white/65 max-w-3xl">
            Espacio informativo para seguimiento de prioridades ciudadanas, proyectos y ejecución presupuestal municipal.
          </p>
        </div>
      </div>

      <div class="mt-7 flex flex-wrap items-center gap-6 text-sm border-t border-white/10 pt-5">
        <span class="text-white/50"><strong class="text-white font-bold">4</strong> etapas del proceso</span>
        <span class="text-white/20">|</span>
        <span class="text-white/50"><strong class="text-white font-bold">Participación</strong> ciudadana abierta</span>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="grid gap-5 sm:grid-cols-2">
      <article class="bg-white border border-gray-200 shadow-sm p-6">
        <h2 class="text-sm font-extrabold uppercase tracking-widest text-primary-900/50 mb-3">Etapas del proceso</h2>
        <ol class="space-y-2 text-sm text-primary-900/70 list-decimal pl-4">
          <li>Convocatoria a organizaciones y vecinos.</li>
          <li>Priorización de necesidades y proyectos.</li>
          <li>Validación técnica y financiera.</li>
          <li>Seguimiento de ejecución y rendición de cuentas.</li>
        </ol>
      </article>

      <article class="bg-white border border-gray-200 shadow-sm p-6">
        <h2 class="text-sm font-extrabold uppercase tracking-widest text-primary-900/50 mb-3">Participación ciudadana</h2>
        <p class="text-sm text-primary-900/70 leading-relaxed">
          Para participar en talleres de planificación y monitoreo presupuestal, comunícate con la municipalidad.
        </p>
        <a href="/contacto" class="inline-flex mt-5 items-center gap-2 bg-primary-700 hover:bg-primary-600 text-white text-sm font-bold px-5 py-2.5 transition-colors">
          Solicitar información
        </a>
      </article>
    </div>
  </section>
</BaseLayout>
