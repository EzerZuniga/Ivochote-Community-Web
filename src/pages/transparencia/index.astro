---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/commonComponents/Breadcrumbs.astro";
---

<BaseLayout
  title="Portal de Transparencia"
  description="Accede a documentos de transparencia, normativa y formularios de la Municipalidad del Centro Poblado de Ivochote."
  breadcrumbs={[{ name: "Transparencia", href: "/transparencia" }]}
  pageType="CollectionPage"
>
  <section class="municipal-hero municipal-hero--transparencia bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <Breadcrumbs
        items={[
          { href: "/", label: "Inicio" },
          { label: "Transparencia" },
        ]}
        className="mb-6"
      />

      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 bg-white/10 p-3.5" aria-hidden="true">
          <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h6l5 5v11a2 2 0 01-2 2z"/>
          </svg>
        </div>
        <div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Portal de Transparencia Estándar</h1>
          <p class="mt-1.5 text-white/65 max-w-3xl">
            Publicamos información institucional para garantizar una gestión abierta, trazable y accesible para toda la ciudadanía.
          </p>
        </div>
      </div>

      <div class="mt-7 flex flex-wrap items-center gap-6 text-sm border-t border-white/10 pt-5">
        <span class="text-white/50"><strong class="text-white font-bold">3</strong> módulos de consulta</span>
        <span class="text-white/20">|</span>
        <span class="text-white/50"><strong class="text-white font-bold">Acceso</strong> público y gratuito</span>
        <span class="text-white/20">|</span>
        <span class="text-white/50"><strong class="text-white font-bold">Actualización</strong> periódica</span>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <article class="bg-white border border-gray-200 shadow-sm p-6">
        <h2 class="text-sm font-extrabold uppercase tracking-widest text-primary-900/50 mb-3">Normativa y Reglamentos</h2>
        <p class="text-sm text-primary-900/70 mb-5">
          Consulta reglamentos vigentes, lineamientos y documentos de gestión institucional.
        </p>
        <a
          href="/transparencia/documentos-oficiales"
          class="inline-flex items-center gap-2 bg-primary-700 hover:bg-primary-600 text-white text-sm font-bold px-5 py-2.5 transition-colors"
        >
          Ver documentos
        </a>
      </article>

      <article class="bg-white border border-gray-200 shadow-sm p-6">
        <h2 class="text-sm font-extrabold uppercase tracking-widest text-primary-900/50 mb-3">Formularios y Trámites</h2>
        <p class="text-sm text-primary-900/70 mb-5">
          Descarga formatos oficiales para trámites administrativos y atención ciudadana.
        </p>
        <a
          href="/transparencia/documentos-oficiales"
          class="inline-flex items-center gap-2 bg-primary-700 hover:bg-primary-600 text-white text-sm font-bold px-5 py-2.5 transition-colors"
        >
          Ver formularios
        </a>
      </article>

      <article class="bg-white border border-gray-200 shadow-sm p-6">
        <h2 class="text-sm font-extrabold uppercase tracking-widest text-primary-900/50 mb-3">Presupuesto Participativo</h2>
        <p class="text-sm text-primary-900/70 mb-5">
          Consulta las etapas, prioridades y canales de participación en el proceso presupuestal.
        </p>
        <a
          href="/transparencia/presupuesto-participativo"
          class="inline-flex items-center gap-2 bg-primary-700 hover:bg-primary-600 text-white text-sm font-bold px-5 py-2.5 transition-colors"
        >
          Ver presupuesto
        </a>
      </article>
    </div>
  </section>
</BaseLayout>
