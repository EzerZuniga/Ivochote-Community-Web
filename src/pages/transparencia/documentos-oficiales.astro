---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/commonComponents/Breadcrumbs.astro";
---

<BaseLayout
  title="Documentos Oficiales"
  description="Consulta y descarga documentos oficiales de la Municipalidad del Centro Poblado de Ivochote."
  breadcrumbs={[
    { name: "Transparencia", href: "/transparencia" },
    { name: "Documentos Oficiales", href: "/transparencia/documentos-oficiales" },
  ]}
  pageType="CollectionPage"
>
  <section class="municipal-hero municipal-hero--documentos bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <Breadcrumbs
        items={[
          { href: "/", label: "Inicio" },
          { href: "/transparencia", label: "Transparencia" },
          { label: "Documentos Oficiales" },
        ]}
        className="mb-6"
      />
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 bg-white/10 p-3.5" aria-hidden="true">
          <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 8h10M7 12h10M7 16h6m4-13l4 4m-4-4v4h4M7 3h10v4h4v14H7V3z"/>
          </svg>
        </div>
        <div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Documentos Oficiales</h1>
          <p class="mt-1.5 text-white/65 max-w-3xl">
            Repositorio de reglamentos, oficios institucionales y formatos administrativos para consulta pública.
          </p>
        </div>
      </div>

      <div class="mt-7 flex flex-wrap items-center gap-6 text-sm border-t border-white/10 pt-5">
        <span class="text-white/50"><strong class="text-white font-bold">3</strong> categorías principales</span>
        <span class="text-white/20">|</span>
        <span class="text-white/50"><strong class="text-white font-bold">Formato:</strong> PDF</span>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <article class="bg-white border border-gray-200 shadow-sm p-6">
        <h2 class="text-sm font-extrabold uppercase tracking-widest text-primary-900/50 mb-3">Reglamentos</h2>
        <p class="text-sm text-primary-900/70 mb-5">Normativa institucional y lineamientos vigentes.</p>
        <a href="/assets/downloads/reglamentos.pdf" class="inline-flex items-center gap-2 bg-primary-700 hover:bg-primary-600 text-white text-sm font-bold px-5 py-2.5 transition-colors" target="_blank" rel="noopener noreferrer">
          Descargar
        </a>
      </article>

      <article class="bg-white border border-gray-200 shadow-sm p-6">
        <h2 class="text-sm font-extrabold uppercase tracking-widest text-primary-900/50 mb-3">Formularios</h2>
        <p class="text-sm text-primary-900/70 mb-5">Formatos administrativos para trámites ciudadanos.</p>
        <a href="/assets/downloads/formularios.pdf" class="inline-flex items-center gap-2 bg-primary-700 hover:bg-primary-600 text-white text-sm font-bold px-5 py-2.5 transition-colors" target="_blank" rel="noopener noreferrer">
          Descargar
        </a>
      </article>

      <article class="bg-white border border-gray-200 shadow-sm p-6">
        <h2 class="text-sm font-extrabold uppercase tracking-widest text-primary-900/50 mb-3">Oficios</h2>
        <p class="text-sm text-primary-900/70 mb-5">Comunicados y oficios institucionales para consulta.</p>
        <a href="/assets/downloads/OFICOP.pdf" class="inline-flex items-center gap-2 bg-primary-700 hover:bg-primary-600 text-white text-sm font-bold px-5 py-2.5 transition-colors" target="_blank" rel="noopener noreferrer">
          Descargar
        </a>
      </article>
    </div>
  </section>
</BaseLayout>
