---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchServices, fetchServiceBySlug } from '../../services/servicesService';

export async function getStaticPaths() {
  const all = await fetchServices();
  return all.map((s) => ({ params: { servicio: s.slug ?? s.id } }));
}

const { servicio } = Astro.params;
const item = await fetchServiceBySlug(servicio!);
if (!item) {
  throw new Error('Servicio no encontrado');
}
---

<BaseLayout
  title={item.title}
  description={item.description}
  image={item.image}
  breadcrumbs={[
    { name: 'Servicios', href: '/servicios' },
    { name: item.title, href: `/servicios/${servicio}` },
  ]}
  service={{
    name: item.title,
    description: item.description,
    category: item.category,
    phone: item.contact?.phone,
    email: item.contact?.email,
  }}
>
  <div class="max-w-4xl mx-auto px-4 py-10">
    <nav class="text-sm text-primary-900/50 mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-primary-700 transition-colors">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/servicios" class="hover:text-primary-700 transition-colors">Servicios</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-primary-900 font-medium truncate" aria-current="page">{item.title}</li>
      </ol>
    </nav>

    <h1 class="text-3xl font-bold mb-3 text-primary-900">{item.title}</h1>
    <span class="text-xs bg-primary-100 text-primary-900 px-2.5 py-1 rounded-full capitalize">{item.category ?? 'general'}</span>

    <div class="prose dark:prose-invert max-w-none mt-6">
      <p>{item.description}</p>
    </div>

    {item.contact && (
      <div class="mt-8 p-5 bg-primary-50 rounded-lg">
        <h3 class="font-semibold text-sm mb-3">Información de contacto</h3>
        {item.contact.phone && <p class="text-sm text-primary-900/60">Teléfono: {item.contact.phone}</p>}
        {item.contact.email && <p class="text-sm mt-1"><a class="text-primary-700 hover:underline" href={`mailto:${item.contact.email}`}>{item.contact.email}</a></p>}
      </div>
    )}
  </div>
</BaseLayout>
