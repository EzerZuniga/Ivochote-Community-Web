---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/commonComponents/Breadcrumbs.astro";
import { fetchServices } from "../../services/servicesService";
import type { ServiceItem } from "../../types/services";

export async function getStaticPaths() {
  const all = await fetchServices();
  return all.map((service) => {
    const slug = service.slug ?? service.id;
    return {
      params: { slug },
      props: { item: service, slug },
    };
  });
}

interface Props {
  item: ServiceItem;
  slug: string;
}

const { item, slug } = Astro.props as Props;

const ICON_PATHS: Record<string, string> = {
  "id-card": "M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0",
  license: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  social: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z",
  shield: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  clean: "M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z",
  book: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
};

const HERO_GRADIENT: Record<string, string> = {
  administrativo: "from-primary-800 to-primary-950",
  salud:          "from-rose-700 to-primary-950",
  educacion:      "from-emerald-800 to-primary-950",
  otros:          "from-primary-900 to-primary-950",
};

const iconPath = ICON_PATHS[item.icon ?? ""] ?? ICON_PATHS["id-card"];
const category = item.category?.toString().toLowerCase() ?? "otros";
const heroGradient = HERO_GRADIENT[category] ?? HERO_GRADIENT.otros;
const steps: string[] = Array.isArray(item.steps) ? item.steps : [];
const requirements: string[] = Array.isArray(item.requirements) ? item.requirements : [];
---

<BaseLayout
  title={item.title}
  description={item.description}
  breadcrumbs={[
    { name: "Servicios", href: "/servicios" },
    { name: item.title, href: `/servicios/${slug}` },
  ]}
  service={{
    name: item.title,
    description: item.description,
    category: item.category,
    phone: item.contact?.phone,
    email: item.contact?.email,
  }}
>
  <!-- Hero -->
  <div class={`bg-gradient-to-br ${heroGradient} text-white`}>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <Breadcrumbs
        items={[
          { href: "/", label: "Inicio" },
          { href: "/servicios", label: "Servicios" },
          { label: item.title },
        ]}
      />

      <div class="flex flex-col sm:flex-row items-start gap-6">
        <div class="flex-shrink-0 w-16 h-16 bg-white/15 border border-white/20 flex items-center justify-center shadow-md">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d={iconPath}/>
          </svg>
        </div>
        <div>
          <span class="inline-block text-[10px] font-extrabold uppercase tracking-widest px-2.5 py-0.5 bg-white/15 border border-white/20 text-white/90 mb-3">
            {item.category ?? "General"}
          </span>
          <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight tracking-tight">{item.title}</h1>
          {item.hours && (
            <p class="mt-3 flex items-center gap-2 text-sm text-white/60">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              {item.hours}
            </p>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Contenido -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12 space-y-5">

    {item.description && (
      <section class="bg-white border border-gray-200 shadow-sm p-6 sm:p-8">
        <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-3">Descripción del Servicio</h2>
        <p class="text-gray-700 leading-relaxed">{item.description}</p>
      </section>
    )}

    <div class="grid gap-5 sm:grid-cols-2">
      {steps.length > 0 && (
        <section class="bg-white border border-gray-200 shadow-sm p-6">
          <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-4">¿Cómo obtenerlo?</h2>
          <ol class="space-y-3">
            {steps.map((step, i) => (
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 w-6 h-6 bg-primary-700 text-white text-xs font-extrabold flex items-center justify-center">
                  {i + 1}
                </span>
                <span class="text-sm text-gray-600 leading-relaxed pt-0.5">{step}</span>
              </li>
            ))}
          </ol>
        </section>
      )}

      {requirements.length > 0 && (
        <section class="bg-white border border-gray-200 shadow-sm p-6">
          <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-4">Requisitos</h2>
          <ul class="space-y-2.5">
            {requirements.map((req) => (
              <li class="flex items-start gap-3">
                <svg class="w-4 h-4 text-primary-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                <span class="text-sm text-gray-600 leading-relaxed">{req}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    {item.contact && (item.contact.phone || item.contact.email) && (
      <section class="bg-primary-950 text-white p-6 sm:p-8 shadow-sm">
        <h2 class="text-[11px] font-bold uppercase tracking-widest text-white/40 mb-4">Contacto y Consultas</h2>
        <div class="flex flex-col sm:flex-row gap-5">
          {item.contact.phone && (
            <a href={`tel:${item.contact.phone}`} class="flex items-center gap-3 text-sm group">
              <div class="w-9 h-9 bg-white/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <span class="text-white/80 group-hover:text-white transition-colors font-medium">{item.contact.phone}</span>
            </a>
          )}
          {item.contact.email && (
            <a href={`mailto:${item.contact.email}`} class="flex items-center gap-3 text-sm group">
              <div class="w-9 h-9 bg-white/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <span class="text-white/80 group-hover:text-white transition-colors font-medium">{item.contact.email}</span>
            </a>
          )}
        </div>
      </section>
    )}

    <div class="pt-2">
      <a href="/servicios" class="inline-flex items-center gap-2 text-sm font-bold text-primary-700 hover:text-primary-500 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Volver a Servicios
      </a>
    </div>

  </div>
</BaseLayout>
