---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/services/ServiceCard';
import { fetchServices } from '../../services/servicesService';

const services = await fetchServices();
const sorted = services.slice().sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
---

<BaseLayout
  title="Servicios Municipales"
  description="Servicios municipales de la Municipalidad del Centro Poblado de Ivochote: trámites, registros, programas sociales y atención ciudadana en Echarati, La Convención, Cusco, Perú."
  breadcrumbs={[{ name: 'Servicios', href: '/servicios' }]}
  pageType="CollectionPage"
>
  <div class="max-w-6xl mx-auto px-4 py-10">
    <header class="mb-8">
      <nav class="text-sm text-primary-900/50 mb-4" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-primary-700 transition-colors">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-primary-900 font-medium" aria-current="page">Servicios</li>
        </ol>
      </nav>
      <h1 class="text-3xl font-bold text-primary-900">Servicios Municipales</h1>
      <p class="mt-2 text-primary-900/60">Conoce los servicios que brinda la Municipalidad del Centro Poblado de Ivochote a la comunidad.</p>
    </header>

    {sorted.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sorted.map(s => (
          <ServiceCard service={s} href={`/servicios/${s.slug ?? s.id}`} />
        ))}
      </div>
    ) : (
      <div class="p-6 bg-primary-50 rounded-lg text-primary-900/60">Información de servicios próximamente.</div>
    )}
  </div>
</BaseLayout>
