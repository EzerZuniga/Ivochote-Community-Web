---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchServices } from '../../services/servicesService';

const services = await fetchServices();
const sorted = services.slice().sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
---

<BaseLayout title="Servicios" description="Servicios municipales de la Municipalidad del Centro Poblado de Ivochote">
  <div class="max-w-6xl mx-auto px-4 py-10">
    <header class="mb-8">
      <h1 class="text-3xl font-bold">Servicios Municipales</h1>
      <p class="mt-2 text-primary-900/60">Conoce los servicios que brinda la Municipalidad del Centro Poblado de Ivochote a la comunidad.</p>
    </header>

    {sorted.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sorted.map(s => (
          <article class="bg-white border border-primary-100 rounded-lg p-5 hover:shadow-md transition">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs bg-primary-100 text-primary-900 px-2 py-0.5 rounded-full capitalize">{s.category ?? 'general'}</span>
              {s.featured && <span class="text-xs bg-amber-50 text-amber-700 px-2 py-0.5 rounded-full">Destacado</span>}
            </div>
            <h3 class="text-lg font-semibold text-primary-900">{s.title}</h3>
            {s.description && <p class="text-sm text-primary-900/60 mt-2">{s.description}</p>}
            <a href={`/servicios/${s.slug ?? s.id}`} class="text-sm text-primary-900 font-medium hover:underline mt-3 inline-block">Más información →</a>
          </article>
        ))}
      </div>
    ) : (
      <div class="p-6 bg-primary-50 rounded-md text-primary-900/60">Información de servicios próximamente.</div>
    )}
  </div>
</BaseLayout>
