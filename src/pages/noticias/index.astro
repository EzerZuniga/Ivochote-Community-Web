---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/commonComponents/Breadcrumbs.astro";
import { fetchNews, getCategories } from "../../services/newsService";
import NewsSearch from "../../components/newsComponents/NewsSearch";

const news = await fetchNews();
const categories = await getCategories();

const sorted = news.slice().sort((a, b) => {
  const ta = new Date(a.date).getTime() || 0;
  const tb = new Date(b.date).getTime() || 0;
  return tb - ta;
});
---

<BaseLayout
  title="Noticias"
  description="Últimas noticias, comunicados oficiales y avisos de la Municipalidad del Centro Poblado de Ivochote. Entérate de la gestión municipal, obras y eventos en Echarati, La Convención, Cusco."
  breadcrumbs={[{ name: "Noticias", href: "/noticias" }]}
  pageType="CollectionPage"
>
  <!-- Hero -->
  <div class="bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <Breadcrumbs
        items={[
          { href: "/", label: "Inicio" },
          { label: "Noticias" },
        ]}
        className="mb-6"
      />
      <div class="flex items-center gap-4">
        <div class="flex-shrink-0 bg-white/10 p-3.5">
          <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 12h6"/>
          </svg>
        </div>
        <div>
          <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight tracking-tight">Noticias</h1>
          <p class="mt-1.5 text-white/60 text-sm sm:text-base max-w-lg">
            Mantente informado sobre las actividades y novedades de la Municipalidad de Ivochote.
          </p>
        </div>
      </div>
      <div class="mt-7 flex items-center gap-6 text-sm border-t border-white/10 pt-5">
        <span class="text-white/50">
          <strong class="text-white font-bold">{news.length}</strong> publicaciones
        </span>
        {categories.length > 0 && (
          <>
            <span class="text-white/20">|</span>
            <span class="text-white/50">
              <strong class="text-white font-bold">{categories.length}</strong> categorías
            </span>
          </>
        )}
      </div>
    </div>
  </div>

  <!-- Contenido -->
  <div class="bg-gray-50 border-t border-gray-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      {sorted.length > 0 ? (
        <NewsSearch news={sorted} categories={categories} client:load />
      ) : (
      <div class="py-24 flex flex-col items-center gap-4 text-center">
        <svg class="w-16 h-16 text-primary-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 12h6"/>
        </svg>
        <p class="text-primary-900/60 font-medium">No hay noticias disponibles en este momento.</p>
      </div>
    )}
    </div>
  </div>
</BaseLayout>
