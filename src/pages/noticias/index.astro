---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchNews } from '../../services/newsService';
import { formatDate } from '../../utils/formatters';

const news = await fetchNews();
---

<BaseLayout title="Noticias" description="Últimas noticias de la Municipalidad del Centro Poblado de Ivochote">
  <div class="max-w-5xl mx-auto px-4 py-10">
    <header class="mb-8">
      <h1 class="text-3xl font-bold">Noticias</h1>
      <p class="mt-2 text-primary-900/60">Mantente informado sobre las actividades y novedades de nuestra municipalidad.</p>
    </header>

    {news.length > 0 ? (
      <div class="grid gap-6">
        {news.map(n => (
          <article class="bg-white border border-primary-100 rounded-lg p-5 hover:shadow-md transition">
            <div class="flex flex-col sm:flex-row gap-4">
              {n.image && <img src={n.image} alt={n.title} class="w-full sm:w-48 h-32 object-cover rounded-md flex-shrink-0" />}
              <div class="flex-1">
                <a class="text-xl font-semibold text-primary-900 hover:text-primary-700 no-underline" href={`/noticias/${n.slug}`}>{n.title}</a>
                <p class="text-sm text-primary-900/60 mt-2">{n.excerpt}</p>
                <div class="mt-3 flex items-center gap-3 text-xs text-primary-900/50">
                  <time datetime={n.date}>{formatDate(n.date)}</time>
                  {n.category && <span class="bg-primary-100 text-primary-900 px-2 py-0.5 rounded-full">{n.category}</span>}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="p-6 bg-primary-50 rounded-md text-primary-900/60">No hay noticias disponibles en este momento.</div>
    )}
  </div>
</BaseLayout>
