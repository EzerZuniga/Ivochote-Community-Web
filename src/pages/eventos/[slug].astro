---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/common/Breadcrumbs.astro";
import { fetchEvents } from "../../services/eventsService";
import type { EventItem } from "../../types/events";

export async function getStaticPaths() {
  const all = await fetchEvents();
  return all.map((event) => {
    const slug = event.slug ?? event.id;
    return {
      params: { slug },
      props: { item: event, slug },
    };
  });
}

interface Props {
  item: EventItem;
  slug: string;
}

const { item, slug } = Astro.props as Props;

const locationText = typeof item.location === 'string'
  ? item.location
  : (item.location?.name ?? item.location?.address ?? '');

const MONTHS_ES = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];
const MONTHS_SHORT = ["ENE", "FEB", "MAR", "ABR", "MAY", "JUN", "JUL", "AGO", "SEP", "OCT", "NOV", "DIC"];

const eventDate = item.date ? new Date(item.date + "T12:00:00") : null;
const eventEndDate = item.endDate ? new Date(item.endDate + "T12:00:00") : null;

const formatLong = (d: Date) =>
  `${d.getDate()} de ${MONTHS_ES[d.getMonth()]} de ${d.getFullYear()}`;

const HERO_GRADIENT: Record<string, string> = {
  institucional: "from-primary-800 to-primary-950",
  económico: "from-amber-800 to-primary-950",
  cultural: "from-rose-800 to-primary-950",
  ambiental: "from-emerald-800 to-primary-950",
  deportivo: "from-blue-800 to-primary-950",
};

const CATEGORY_ACCENT: Record<string, string> = {
  institucional: "bg-primary-600",
  económico: "bg-amber-500",
  cultural: "bg-rose-500",
  ambiental: "bg-emerald-600",
  deportivo: "bg-blue-600",
};

const STATUS_STYLE: Record<string, { label: string; cls: string }> = {
  upcoming: { label: "Próximamente", cls: "bg-blue-100 text-blue-800" },
  ongoing: { label: "En curso", cls: "bg-emerald-100 text-emerald-800" },
  past: { label: "Finalizado", cls: "bg-gray-100 text-gray-500" },
  cancelled: { label: "Cancelado", cls: "bg-red-100 text-red-700" },
};

const heroGradient = HERO_GRADIENT[item.category ?? ""] ?? HERO_GRADIENT.institucional;
const accentClass = CATEGORY_ACCENT[item.category ?? ""] ?? CATEGORY_ACCENT.institucional;
const status = STATUS_STYLE[item.status ?? ""];
---

<BaseLayout
  title={item.title}
  description={item.description ?? `Evento: ${item.title} en el Centro Poblado de Ivochote`}
  image={item.image}
  breadcrumbs={[
    { name: "Eventos", href: "/eventos" },
    { name: item.title, href: `/eventos/${slug}` },
  ]}
  event={{
    name: item.title,
    description: item.description,
    startDate: item.date,
    endDate: item.endDate,
    image: item.image,
    locationName: typeof item.location === 'string' ? item.location : item.location?.name,
    locationAddress: typeof item.location !== 'string' ? item.location?.address : undefined,
    status: item.status,
  }}
>
  <!-- Hero -->
  <div class={`bg-gradient-to-br ${heroGradient} text-white`}>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <Breadcrumbs
        items={[
          { href: "/", label: "Inicio" },
          { href: "/eventos", label: "Eventos" },
          { label: item.title },
        ]}
      />

      <div class="flex flex-col sm:flex-row items-start gap-6">
        {/* Bloque de fecha */}
        {eventDate && (
          <div class={`flex-shrink-0 w-20 flex flex-col items-center justify-center ${accentClass} text-white shadow-md self-start`}>
            <span class="text-3xl font-extrabold leading-none pt-3">{eventDate.getDate()}</span>
            <span class="text-[11px] font-bold uppercase tracking-widest pb-1">{MONTHS_SHORT[eventDate.getMonth()]}</span>
            <div class="w-full text-center bg-black/20 text-[10px] font-semibold py-1">{eventDate.getFullYear()}</div>
          </div>
        )}

        <div>
          {item.category && (
            <span class="inline-block text-[10px] font-extrabold uppercase tracking-widest px-2.5 py-0.5 bg-white/15 border border-white/20 text-white/90 mb-3">
              {item.category}
            </span>
          )}
          <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight tracking-tight">{item.title}</h1>
          {status && (
            <span class={`inline-block mt-3 text-xs font-bold px-3 py-1 ${status.cls}`}>
              {status.label}
            </span>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Contenido -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12 space-y-5">

    <!-- Ficha rápida -->
    <section class="bg-white border border-gray-200 shadow-sm" aria-labelledby="info-heading">
      <h2 id="info-heading" class="text-[11px] font-bold uppercase tracking-widest text-gray-400 px-6 pt-5 mb-4">Información del evento</h2>
      <div class="grid sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-gray-100">
        {eventDate && (
          <div class="flex items-start gap-4 px-6 pb-5">
            <div class={`w-9 h-9 ${accentClass} flex items-center justify-center flex-shrink-0`} aria-hidden="true">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-0.5">Fecha</p>
              <p class="text-sm font-semibold text-gray-800">{formatLong(eventDate)}</p>
              {eventEndDate && <p class="text-xs text-gray-500 mt-0.5">Hasta: {formatLong(eventEndDate)}</p>}
            </div>
          </div>
        )}
        {item.time && (
          <div class="flex items-start gap-4 px-6 pb-5">
            <div class={`w-9 h-9 ${accentClass} flex items-center justify-center flex-shrink-0`} aria-hidden="true">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-0.5">Hora de inicio</p>
              <p class="text-sm font-semibold text-gray-800">{item.time}</p>
            </div>
          </div>
        )}
        {locationText && (
          <div class="flex items-start gap-4 px-6 pb-5">
            <div class={`w-9 h-9 ${accentClass} flex items-center justify-center flex-shrink-0`} aria-hidden="true">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-0.5">Lugar</p>
              <p class="text-sm font-semibold text-gray-800">{locationText}</p>
            </div>
          </div>
        )}
        {item.organizer && (
          <div class="flex items-start gap-4 px-6 pb-5">
            <div class={`w-9 h-9 ${accentClass} flex items-center justify-center flex-shrink-0`} aria-hidden="true">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-0.5">Organiza</p>
              <p class="text-sm font-semibold text-gray-800">{item.organizer}</p>
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- Descripción -->
    {(item.fullDescription ?? item.description) && (
      <section class="bg-white border border-gray-200 shadow-sm p-6 sm:p-8">
        <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-3">Sobre este evento</h2>
        <p class="text-gray-700 leading-relaxed">{item.fullDescription ?? item.description}</p>
      </section>
    )}

    <!-- Programa -->
    {item.program && item.program.length > 0 && (
      <section class="bg-white border border-gray-200 shadow-sm p-6 sm:p-8" aria-labelledby="programa-heading">
        <h2 id="programa-heading" class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-5">Programa del evento</h2>
        <ol class="relative border-l-2 border-gray-100 space-y-5 list-none ml-2">
          {item.program.map((step, i) => (
            <li class="relative pl-6">
              <div class={`absolute -left-[11px] top-0 w-5 h-5 ${accentClass} flex items-center justify-center`}>
                <span class="text-white text-[9px] font-extrabold">{i + 1}</span>
              </div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-0.5">{step.time}</p>
              <p class="text-sm font-semibold text-gray-800">{step.activity}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- Tags -->
    {item.tags && item.tags.length > 0 && (
      <section class="bg-white border border-gray-200 shadow-sm p-6">
        <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-4">Etiquetas</h2>
        <div class="flex flex-wrap gap-2">
          {item.tags.map((tag: string) => (
            <span class="text-xs font-semibold px-2.5 py-1 border border-gray-200 text-gray-600 capitalize">#{tag}</span>
          ))}
        </div>
      </section>
    )}

    <div class="pt-2">
      <a href="/eventos" class="inline-flex items-center gap-2 text-sm font-bold text-primary-700 hover:text-primary-500 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Volver a Eventos
      </a>
    </div>

  </div>
</BaseLayout>
