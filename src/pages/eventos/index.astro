---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/events/EventCard';
import { fetchEvents } from '../../services/eventsService';
import type { EventItem } from '../../types/events';

const events = (await fetchEvents()) as EventItem[];
const sorted = events.slice().sort((a, b) => {
  const da = new Date(a.date ?? '').getTime() || 0;
  const db = new Date(b.date ?? '').getTime() || 0;
  return db - da;
});
---

<BaseLayout
  title="Eventos y Actividades"
  description="Calendario de eventos, actividades culturales, fiestas patronales y eventos institucionales del Centro Poblado de Ivochote, Echarati, La Convención, Cusco."
  breadcrumbs={[{ name: 'Eventos', href: '/eventos' }]}
  pageType="CollectionPage"
>
  <div class="max-w-6xl mx-auto px-4 py-10">
    <header class="mb-8">
      <nav class="text-sm text-primary-900/50 mb-4" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-primary-700 transition-colors">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-primary-900 font-medium" aria-current="page">Eventos</li>
        </ol>
      </nav>
      <h1 class="text-3xl font-bold text-primary-900">Eventos</h1>
      <p class="mt-2 text-primary-900/60">Calendario de actividades culturales, sociales e institucionales del Centro Poblado de Ivochote.</p>
    </header>

    {sorted.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2">
        {sorted.map((e: EventItem) => (
          <EventCard event={e} />
        ))}
      </div>
    ) : (
      <div class="p-6 bg-primary-50 rounded-md text-primary-900/60">No hay eventos programados en este momento.</div>
    )}
  </div>
</BaseLayout>
