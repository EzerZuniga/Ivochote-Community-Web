---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/common/Breadcrumbs.astro";
import { MUNICIPAL_MANAGEMENT_PERIOD } from "../../../config/content.config";
import { fetchAuthorities } from "../../services/authoritiesService";
import type { Authority } from "../../types/authorities";

export async function getStaticPaths() {
  const all = await fetchAuthorities();
  return all.map((authority) => {
    const slug = authority.slug ?? authority.id;
    return {
      params: { slug },
      props: { item: authority, slug },
    };
  });
}

interface Props {
  item: Authority;
  slug: string;
}

const { item, slug } = Astro.props as Props;

const isAlcalde = item.position === 'Alcalde';
---

<BaseLayout
  title={item.name}
  description={item.bio ?? `Perfil de ${item.name} — ${item.position ?? 'Autoridad'} del Centro Poblado de Ivochote`}
  breadcrumbs={[
    { name: "Autoridades", href: "/autoridades" },
    { name: item.name, href: `/autoridades/${slug}` },
  ]}
  person={{
    name: item.name,
    jobTitle: item.position,
    email: item.email,
    phone: item.phone,
  }}
>
  <!-- Hero -->
  <div class="bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <Breadcrumbs
        items={[
          { href: "/", label: "Inicio" },
          { href: "/autoridades", label: "Autoridades" },
          { label: item.name },
        ]}
      />

      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8">
        <!-- Avatar SVG -->
        <div class="flex-shrink-0 relative">
          <div class="w-32 h-32 sm:w-40 sm:h-40 rounded-2xl bg-white/10 backdrop-blur-sm border border-white/20 shadow-xl flex items-center justify-center">
            <svg
              viewBox="0 0 64 64"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              class="w-20 h-20 sm:w-24 sm:h-24 text-white/70"
              aria-hidden="true"
            >
              <circle cx="32" cy="22" r="12" fill="currentColor" opacity="0.9"/>
              <path d="M8 56c0-13.255 10.745-24 24-24s24 10.745 24 24H8z" fill="currentColor" opacity="0.9"/>
            </svg>
          </div>
          {isAlcalde && (
            <span class="absolute -bottom-3 left-1/2 -translate-x-1/2 whitespace-nowrap text-[10px] font-extrabold uppercase tracking-widest bg-amber-400 text-amber-900 px-3 py-0.5 rounded-full shadow">
              Alcalde
            </span>
          )}
        </div>

        <!-- Name + role -->
        <div class="text-center sm:text-left">
          <span class="inline-block text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-white/15 text-white/90 border border-white/20 mb-3">
            {item.position}
          </span>
          <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight tracking-tight">
            {item.name}
          </h1>
          {item.department && (
            <p class="mt-2 text-white/60 text-sm sm:text-base font-medium">{item.department}</p>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Content -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12 space-y-5">
    {item.bio && (
      <section class="bg-white rounded-2xl border border-primary-100 p-6 sm:p-8 shadow-sm">
        <h2 class="text-[11px] font-bold uppercase tracking-widest text-primary-900/40 mb-3">
          Funciones y responsabilidades
        </h2>
        <p class="text-primary-900/75 leading-relaxed text-base">{item.bio}</p>
      </section>
    )}

    <section class="bg-white rounded-2xl border border-primary-100 p-6 sm:p-8 shadow-sm">
      <h2 class="text-[11px] font-bold uppercase tracking-widest text-primary-900/40 mb-3">Período de gestión</h2>
      <p class="text-primary-900/75 text-base">
        {MUNICIPAL_MANAGEMENT_PERIOD.startYear} – {MUNICIPAL_MANAGEMENT_PERIOD.endYear} &middot; Centro Poblado de Ivochote, Echarati, La Convención, Cusco
      </p>
    </section>

    {(item.email || item.phone) && (
      <section class="bg-white rounded-2xl border border-primary-100 p-6 sm:p-8 shadow-sm">
        <h2 class="text-[11px] font-bold uppercase tracking-widest text-primary-900/40 mb-4">Contacto</h2>
        <div class="space-y-3">
          {item.phone && (
            <div class="flex items-center gap-3 text-sm">
              <div class="w-8 h-8 rounded-lg bg-primary-50 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <a href={`tel:${item.phone}`} class="text-primary-700 hover:text-primary-500 transition-colors font-medium">{item.phone}</a>
            </div>
          )}
          {item.email && (
            <div class="flex items-center gap-3 text-sm">
              <div class="w-8 h-8 rounded-lg bg-primary-50 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <a href={`mailto:${item.email}`} class="text-primary-700 hover:text-primary-500 transition-colors font-medium">{item.email}</a>
            </div>
          )}
        </div>
      </section>
    )}

    <div class="pt-2">
      <a href="/autoridades" class="inline-flex items-center gap-2 text-sm font-bold text-primary-700 hover:text-primary-500 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Volver a Autoridades
      </a>
    </div>
  </div>
</BaseLayout>
