---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorityCard from '../../components/authorities/AuthorityCard';
import { fetchAuthorities } from '../../services/authoritiesService';
import type { Authority } from '../../types/authorities';

const authorities = (await fetchAuthorities()) as Authority[];
const sorted = authorities.slice().sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
---

<BaseLayout
  title="Autoridades Municipales"
  description="Conoce a las autoridades electas de la Municipalidad del Centro Poblado de Ivochote. Alcalde, regidores y funcionarios del gobierno local de Echarati, La Convención, Cusco."
  breadcrumbs={[{ name: 'Autoridades', href: '/autoridades' }]}
  pageType="AboutPage"
>
  <div class="max-w-6xl mx-auto px-4 py-10">
    <header class="mb-8">
      <nav class="text-sm text-primary-900/50 mb-4" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-primary-700 transition-colors">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-primary-900 font-medium" aria-current="page">Autoridades</li>
        </ol>
      </nav>
      <h1 class="text-3xl font-bold text-primary-900">Autoridades Municipales</h1>
      <p class="mt-2 text-primary-900/60">Conoce a las autoridades electas que representan al Centro Poblado de Ivochote.</p>
    </header>

    {sorted && sorted.length > 0 ? (
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 list-none" role="list">
        {sorted.map((a: Authority) => (
          <li>
            <AuthorityCard authority={a} />
          </li>
        ))}
      </ul>
    ) : (
      <div class="p-6 bg-primary-50 rounded-lg text-primary-900/60">Información de autoridades próximamente.</div>
    )}
  </div>
</BaseLayout>
