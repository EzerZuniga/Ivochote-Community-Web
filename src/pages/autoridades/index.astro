---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorityCard from '../../components/authorities/AuthorityCard';
import { fetchAuthorities } from '../../services/authoritiesService';
import type { Authority } from '../../types/authorities';

const authorities = (await fetchAuthorities()) as Authority[];
const sorted = authorities.slice().sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
const [alcalde, ...regidores] = sorted;
---

<BaseLayout
  title="Autoridades Municipales"
  description="Conoce a las autoridades electas del Centro Poblado de Ivochote: Alcalde Gary Leo Huamán Rodríguez y regidores del gobierno local de Echarati, La Convención, Cusco."
  breadcrumbs={[{ name: 'Autoridades', href: '/autoridades' }]}
  pageType="AboutPage"
>
  <!-- Hero -->
  <div class="bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 text-white overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-12 pb-14 sm:pb-16">
      <nav class="flex items-center gap-2 text-sm text-white/50 mb-8" aria-label="Migas de pan">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <svg class="w-3 h-3 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span aria-current="page" class="text-white/80 font-medium">Autoridades</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-stretch">
        <!-- Texto -->
        <div class="flex flex-col justify-center">
          <div class="flex items-center gap-3 mb-5">
            <div class="flex-shrink-0 bg-white/10 rounded-xl p-3" aria-hidden="true">
              <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <span class="text-xs font-bold uppercase tracking-widest text-amber-400/80">Gobierno Local</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold leading-tight tracking-tight">
            Autoridades<br class="hidden sm:block"/> Municipales
          </h1>
          <p class="mt-4 text-white/60 text-sm sm:text-base leading-relaxed">
            Representantes electos del Centro Poblado de Ivochote, Echarati, La Convención, Cusco. Comprometidos con el desarrollo y bienestar de la comunidad.
          </p>

          <div class="mt-8 grid grid-cols-3 gap-4 border-t border-white/10 pt-6">
            <div>
              <p class="text-white/40 text-[10px] uppercase tracking-wider font-semibold mb-0.5">Período</p>
              <p class="text-white font-bold text-sm">2023 – 2026</p>
            </div>
            <div>
              <p class="text-white/40 text-[10px] uppercase tracking-wider font-semibold mb-0.5">Electos</p>
              <p class="text-white font-bold text-sm">{sorted.length} repr.</p>
            </div>
            <div>
              <p class="text-white/40 text-[10px] uppercase tracking-wider font-semibold mb-0.5">Distrito</p>
              <p class="text-white font-bold text-sm">Echarati</p>
            </div>
          </div>
        </div>

        <!-- Imagen -->
        <div class="relative mt-2 lg:mt-0 flex items-center justify-center">
          <div class="absolute inset-0 translate-x-3 translate-y-3 rounded-2xl bg-white/5 border border-white/10" aria-hidden="true"></div>
          <img
            src="/assets/images/autoridades/autoridad.png"
            alt="Autoridades electas del Centro Poblado de Ivochote — Concejo Municipal 2023-2026"
            class="relative w-full rounded-2xl shadow-2xl object-contain border border-white/20"
            loading="eager"
            decoding="async"
            width="560"
            height="420"
          />
          <div class="absolute -bottom-4 left-4 bg-amber-400 text-amber-900 text-[11px] font-extrabold uppercase tracking-widest px-4 py-1.5 rounded-full shadow-lg select-none">
            Concejo 2023–2026
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <!-- Alcalde destacado -->
    {alcalde && (
      <section class="mb-12" aria-labelledby="alcalde-heading">
        <h2 id="alcalde-heading" class="text-[11px] font-bold uppercase tracking-widest text-primary-900/40 mb-5">
          Alcalde
        </h2>
        <AuthorityCard authority={alcalde} featured={true} />
      </section>
    )}

    <!-- Concejo Municipal -->
    {regidores.length > 0 && (
      <section aria-labelledby="concejo-heading">
        <h2 id="concejo-heading" class="text-[11px] font-bold uppercase tracking-widest text-primary-900/40 mb-5">
          Concejo Municipal
        </h2>
        <ul class="grid gap-4 list-none" role="list">
          {regidores.map((a: Authority) => (
            <li>
              <AuthorityCard authority={a} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
