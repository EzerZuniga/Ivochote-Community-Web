---
// Página: Autoridades — listado
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAuthorities } from '../../lib/api';
import type { Authority } from '../../types/authorities';

const authorities = (await getAuthorities()) as Authority[];
---

<BaseLayout title="Autoridades">
  <div class="max-w-7xl mx-auto px-4 py-10">
    <header class="mb-8">
      <h1 class="text-3xl font-bold">Autoridades</h1>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Conoce a las autoridades locales y sus cargos de representación.</p>
    </header>

    {authorities && authorities.length > 0 ? (
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 list-none" role="list">
        {authorities.map((a: Authority) => (
          <li>
            <article class="bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 rounded-lg p-4 shadow-sm hover:shadow-md transition">
              <div class="flex items-start gap-4">
                {a.image ? <img src={a.image} alt={a.name} class="w-16 h-16 rounded-full object-cover" /> : <div class="w-16 h-16 rounded-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center text-slate-500">—</div>}

                <div class="flex-1">
                  <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">{a.name}</h3>
                  <div class="text-sm text-slate-600 dark:text-slate-300">{a.position ?? a.department}</div>
                  {a.email ? <div class="text-sm mt-2"><a class="text-sky-600 hover:underline" href={`mailto:${a.email}`}>{a.email}</a></div> : null}
                  {a.phone ? <div class="text-sm text-slate-600 mt-1">{a.phone}</div> : null}
                </div>
              </div>

              <div class="mt-4 text-right">
                <a href={`/autoridades/${a.id}`} class="text-sm text-slate-700 dark:text-slate-200 hover:underline">Ver perfil</a>
              </div>
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <div class="p-6 bg-yellow-50 rounded-md text-slate-700">No se encontraron autoridades. Intenta más tarde.</div>
    )}
  </div>
</BaseLayout>
