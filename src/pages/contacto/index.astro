---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_CONFIG, SOCIAL_LINKS } from '../../../config/site.config';

const sent = Astro.url.searchParams.get('enviado') === 'true';
---

<BaseLayout
  title="Contacto"
  description="Contáctanos — Municipalidad del Centro Poblado de Ivochote. Teléfono, correo electrónico, formulario de contacto y ubicación. Atención ciudadana en Echarati, La Convención, Cusco."
  breadcrumbs={[{ name: 'Contacto', href: '/contacto' }]}
  pageType="ContactPage"
>

  <!-- ===== HERO ===== -->
  <div class="bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">

      <nav class="flex items-center gap-2 text-sm text-white/50 mb-8" aria-label="Migas de pan">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <svg class="w-3 h-3 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span aria-current="page" class="text-white/80 font-medium">Contacto</span>
      </nav>

      <div class="flex items-start gap-4 mb-8">
        <div class="flex-shrink-0 bg-white/10 rounded-xl p-3.5" aria-hidden="true">
          <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-amber-400/80 mb-2 block">Atención Ciudadana</span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold leading-tight tracking-tight">Contáctanos</h1>
          <p class="mt-3 text-white/60 text-sm sm:text-base leading-relaxed max-w-lg">
            Escríbenos, llámanos o visítanos. Estamos para atender tus consultas, trámites y sugerencias.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-4 border-t border-white/10 pt-6">
        <div>
          <p class="text-white/40 text-[10px] uppercase tracking-wider font-semibold mb-0.5">Atención</p>
          <p class="text-white font-bold text-sm">Lun – Vie · 8 – 16 h</p>
        </div>
        <div>
          <p class="text-white/40 text-[10px] uppercase tracking-wider font-semibold mb-0.5">Teléfono</p>
          <p class="text-white font-bold text-sm">{SITE_CONFIG.phone}</p>
        </div>
        <div>
          <p class="text-white/40 text-[10px] uppercase tracking-wider font-semibold mb-0.5">Respuesta</p>
          <p class="text-white font-bold text-sm">24 – 48 horas</p>
        </div>
      </div>

    </div>
  </div>

  <!-- ===== CONTENIDO PRINCIPAL ===== -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid lg:grid-cols-5 gap-8 lg:gap-10 items-start">

      <!-- ── Columna izquierda: datos de contacto ── -->
      <aside class="lg:col-span-2 space-y-4" aria-label="Datos de contacto">

        <!-- Teléfono -->
        <div class="bg-white border border-gray-200 shadow-sm p-5 flex items-start gap-4">
          <div class="w-9 h-9 bg-primary-600 flex items-center justify-center flex-shrink-0" aria-hidden="true">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-0.5">Teléfono</p>
            <a
              href={`tel:${SITE_CONFIG.phone}`}
              class="text-sm font-semibold text-gray-800 hover:text-primary-700 transition-colors"
            >
              {SITE_CONFIG.phone}
            </a>
          </div>
        </div>

        <!-- Correo -->
        <div class="bg-white border border-gray-200 shadow-sm p-5 flex items-start gap-4">
          <div class="w-9 h-9 bg-primary-600 flex items-center justify-center flex-shrink-0" aria-hidden="true">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-0.5">Correo electrónico</p>
            <a
              href={`mailto:${SITE_CONFIG.email}`}
              class="text-sm font-semibold text-gray-800 hover:text-primary-700 transition-colors break-all"
            >
              {SITE_CONFIG.email}
            </a>
          </div>
        </div>

        <!-- Dirección -->
        <div class="bg-white border border-gray-200 shadow-sm p-5 flex items-start gap-4">
          <div class="w-9 h-9 bg-primary-600 flex items-center justify-center flex-shrink-0" aria-hidden="true">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-0.5">Dirección</p>
            <p class="text-sm font-semibold text-gray-800 leading-relaxed">{SITE_CONFIG.address}</p>
          </div>
        </div>

        <!-- Horario -->
        <div class="bg-white border border-gray-200 shadow-sm p-5">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-9 h-9 bg-amber-500 flex items-center justify-center flex-shrink-0" aria-hidden="true">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Horario de atención</p>
          </div>
          <ul class="space-y-1.5 text-sm">
            <li class="flex justify-between">
              <span class="text-gray-600">Lunes – Viernes</span>
              <span class="font-semibold text-gray-800">8:00 – 16:00</span>
            </li>
            <li class="flex justify-between">
              <span class="text-gray-600">Sábados</span>
              <span class="font-semibold text-gray-500">Cerrado</span>
            </li>
            <li class="flex justify-between">
              <span class="text-gray-600">Domingos</span>
              <span class="font-semibold text-gray-500">Cerrado</span>
            </li>
          </ul>
        </div>

        <!-- Redes sociales -->
        {(SOCIAL_LINKS.facebook || SOCIAL_LINKS.tiktok) && (
          <div class="bg-white border border-gray-200 shadow-sm p-5">
            <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-3">Síguenos en redes</p>
            <div class="flex gap-3">
              {SOCIAL_LINKS.facebook && (
                <a
                  href={SOCIAL_LINKS.facebook}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Facebook de la Municipalidad de Ivochote"
                  class="flex items-center gap-2 px-3 py-2 bg-[#1877F2] text-white text-xs font-bold hover:bg-[#1565d8] transition-colors"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/>
                  </svg>
                  Facebook
                </a>
              )}
              {SOCIAL_LINKS.tiktok && (
                <a
                  href={SOCIAL_LINKS.tiktok}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="TikTok de la Municipalidad de Ivochote"
                  class="flex items-center gap-2 px-3 py-2 bg-black text-white text-xs font-bold hover:bg-gray-800 transition-colors"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1 0-5.78 2.92 2.92 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.64 6.33 6.33 0 0 0 9.37 22a6.33 6.33 0 0 0 6.38-6.36V9.25a8.16 8.16 0 0 0 4.84 1.58V7.38a4.85 4.85 0 0 1-1-.69z"/>
                  </svg>
                  TikTok
                </a>
              )}
            </div>
          </div>
        )}

        <!-- Mapa -->
        <div class="bg-white border border-gray-200 shadow-sm overflow-hidden">
          <iframe
            title="Ubicación del Centro Poblado de Ivochote en Google Maps"
            src="https://maps.google.com/maps?q=Centro+Poblado+de+Ivochote,+Echarati,+La+Convenci%C3%B3n,+Cusco,+Per%C3%BA&output=embed&z=13&t=k"
            width="100%"
            height="200"
            style="border:0; display:block;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            aria-label="Mapa satelital de la ubicación de Ivochote"
          ></iframe>
          <div class="px-4 py-3 border-t border-gray-100">
            <a
              href="https://maps.google.com/maps?q=Centro+Poblado+de+Ivochote,+Echarati,+La+Convenci%C3%B3n,+Cusco,+Per%C3%BA"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-primary-700 hover:text-primary-500 transition-colors"
            >
              <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
              Abrir en Google Maps
            </a>
          </div>
        </div>

      </aside>

      <!-- ── Columna derecha: formulario ── -->
      <main class="lg:col-span-3">

        {sent ? (
          <!-- Estado: mensaje enviado -->
          <div class="bg-white border border-gray-200 shadow-sm p-8 sm:p-10 text-center">
            <div class="w-14 h-14 bg-emerald-100 flex items-center justify-center mx-auto mb-5">
              <svg class="w-7 h-7 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <h2 class="text-xl font-extrabold text-gray-900 mb-2">¡Mensaje enviado!</h2>
            <p class="text-gray-500 text-sm leading-relaxed max-w-sm mx-auto">
              Gracias por contactarnos. Te responderemos al correo indicado en un plazo de 24 a 48 horas hábiles.
            </p>
            <a
              href="/contacto"
              class="mt-6 inline-flex items-center gap-2 bg-primary-900 hover:bg-primary-800 text-white text-sm font-bold px-5 py-2.5 transition-colors"
            >
              Enviar otro mensaje
            </a>
          </div>
        ) : (
          <!-- Formulario -->
          <div class="bg-white border border-gray-200 shadow-sm">
            <div class="border-b border-gray-100 px-6 sm:px-8 py-5">
              <h2 class="text-base font-extrabold text-gray-900">Envíanos un mensaje</h2>
              <p class="text-xs text-gray-400 mt-0.5">Los campos marcados con <span class="text-red-500" aria-hidden="true">*</span> son obligatorios.</p>
            </div>

            <form
              class="px-6 sm:px-8 py-6 space-y-5"
              name="contacto"
              method="POST"
              data-netlify="true"
              netlify-honeypot="bot-field"
              action="/contacto/?enviado=true"
            >
              <input type="hidden" name="form-name" value="contacto" />
              <!-- Honeypot anti-spam -->
              <p class="hidden" aria-hidden="true">
                <label>No completar si eres humano: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
              </p>

              <div class="grid sm:grid-cols-2 gap-5">
                <!-- Nombre -->
                <div class="flex flex-col gap-1">
                  <label for="nombre" class="text-xs font-bold text-gray-700 uppercase tracking-widest">
                    Nombre completo <span class="text-red-500" aria-hidden="true">*</span>
                  </label>
                  <input
                    id="nombre"
                    name="nombre"
                    type="text"
                    required
                    autocomplete="name"
                    placeholder="Ej. Juan Quispe Mamani"
                    class="block w-full border border-gray-200 bg-gray-50 px-3 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-primary-400 focus:bg-white transition-colors"
                  />
                </div>

                <!-- Correo -->
                <div class="flex flex-col gap-1">
                  <label for="correo" class="text-xs font-bold text-gray-700 uppercase tracking-widest">
                    Correo electrónico <span class="text-red-500" aria-hidden="true">*</span>
                  </label>
                  <input
                    id="correo"
                    name="correo"
                    type="email"
                    required
                    autocomplete="email"
                    placeholder="tu@correo.com"
                    class="block w-full border border-gray-200 bg-gray-50 px-3 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-primary-400 focus:bg-white transition-colors"
                  />
                </div>
              </div>

              <div class="grid sm:grid-cols-2 gap-5">
                <!-- Teléfono -->
                <div class="flex flex-col gap-1">
                  <label for="telefono" class="text-xs font-bold text-gray-700 uppercase tracking-widest">
                    Teléfono <span class="text-gray-400 font-normal normal-case">(opcional)</span>
                  </label>
                  <input
                    id="telefono"
                    name="telefono"
                    type="tel"
                    autocomplete="tel"
                    placeholder="+51 900 000 000"
                    class="block w-full border border-gray-200 bg-gray-50 px-3 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-primary-400 focus:bg-white transition-colors"
                  />
                </div>

                <!-- Asunto -->
                <div class="flex flex-col gap-1">
                  <label for="asunto" class="text-xs font-bold text-gray-700 uppercase tracking-widest">
                    Asunto <span class="text-red-500" aria-hidden="true">*</span>
                  </label>
                  <select
                    id="asunto"
                    name="asunto"
                    required
                    class="block w-full border border-gray-200 bg-gray-50 px-3 py-2.5 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-primary-400 focus:bg-white transition-colors appearance-none"
                  >
                    <option value="" disabled selected>Selecciona un asunto…</option>
                    <option value="Trámites y servicios">Trámites y servicios</option>
                    <option value="Información general">Información general</option>
                    <option value="Turismo e información turística">Turismo e información turística</option>
                    <option value="Eventos y actividades">Eventos y actividades</option>
                    <option value="Denuncia o queja">Denuncia o queja</option>
                    <option value="Sugerencia">Sugerencia</option>
                    <option value="Otro">Otro</option>
                  </select>
                </div>
              </div>

              <!-- Mensaje -->
              <div class="flex flex-col gap-1">
                <label for="mensaje" class="text-xs font-bold text-gray-700 uppercase tracking-widest">
                  Mensaje <span class="text-red-500" aria-hidden="true">*</span>
                </label>
                <textarea
                  id="mensaje"
                  name="mensaje"
                  rows="5"
                  required
                  placeholder="Escribe aquí tu consulta, solicitud o comentario…"
                  class="block w-full border border-gray-200 bg-gray-50 px-3 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-primary-400 focus:bg-white transition-colors resize-y"
                ></textarea>
              </div>

              <!-- Acciones -->
              <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-1">
                <p class="text-xs text-gray-400 leading-relaxed max-w-xs">
                  Tu información es confidencial y solo se usará para responderte.
                </p>
                <div class="flex gap-3 flex-shrink-0">
                  <button
                    type="reset"
                    class="px-4 py-2.5 text-xs font-bold uppercase tracking-widest border border-gray-200 text-gray-500 hover:bg-gray-50 hover:text-gray-700 transition-colors"
                  >
                    Limpiar
                  </button>
                  <button
                    type="submit"
                    class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-primary-900 hover:bg-primary-800 text-white text-xs font-bold uppercase tracking-widest transition-colors"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                    </svg>
                    Enviar mensaje
                  </button>
                </div>
              </div>
            </form>
          </div>
        )}

      </main>
    </div>
  </div>

</BaseLayout>
