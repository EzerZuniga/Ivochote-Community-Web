---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_CONFIG, SOCIAL_LINKS } from '../../../config/site.config';
---

<BaseLayout
  title="Contacto"
  description={`Contáctanos — Municipalidad del Centro Poblado de Ivochote, Echarati, La Convención, Cusco. Teléfono, correo y formulario de contacto.`}
  breadcrumbs={[{ name: 'Contacto', href: '/contacto' }]}
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <section class="space-y-4">
        <nav class="text-sm text-primary-900/50 mb-2" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2">
            <li><a href="/" class="hover:text-primary-700 transition-colors">Inicio</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-primary-900 font-medium" aria-current="page">Contacto</li>
          </ol>
        </nav>
        <h1 class="text-3xl font-bold text-primary-900">Contacto</h1>
        <p class="text-primary-900/60">Comunícate con la Municipalidad del Centro Poblado de Ivochote. Estamos para servirte.</p>

        <div class="mt-6 space-y-4 text-primary-900">
          <div class="flex items-start gap-3">
            <span class="text-primary-700 text-lg">📞</span>
            <div>
              <p class="font-medium">Teléfono</p>
              <p class="text-sm">{SITE_CONFIG.phone}</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-primary-700 text-lg">✉️</span>
            <div>
              <p class="font-medium">Correo electrónico</p>
              <p class="text-sm"><a class="text-primary-700 hover:underline" href={`mailto:${SITE_CONFIG.email}`}>{SITE_CONFIG.email}</a></p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-primary-700 text-lg">📍</span>
            <div>
              <p class="font-medium">Dirección</p>
              <p class="text-sm">{SITE_CONFIG.address}</p>
            </div>
          </div>

          {SOCIAL_LINKS.facebook && (
            <div class="pt-4">
              <p class="font-medium">Síguenos</p>
              <div class="flex gap-3 mt-2">
                <a class="text-primary-700 hover:underline" href={SOCIAL_LINKS.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">Facebook</a>
                {SOCIAL_LINKS.tiktok && <a class="text-primary-700 hover:underline" href={SOCIAL_LINKS.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok">TikTok</a>}
              </div>
            </div>
          )}
        </div>
      </section>

      <section>
        <h2 class="text-xl font-semibold mb-4">Envíanos un mensaje</h2>
        <form class="bg-white p-6 rounded-lg shadow-sm border border-primary-100" method="post" action={`mailto:${SITE_CONFIG.email}`} enctype="text/plain">
          <div class="grid grid-cols-1 gap-4">
            <label class="flex flex-col">
              <span class="text-sm font-medium">Nombre completo</span>
              <input name="nombre" type="text" required class="mt-1 block w-full rounded border border-primary-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary-300" />
            </label>

            <label class="flex flex-col">
              <span class="text-sm font-medium">Correo electrónico</span>
              <input name="correo" type="email" required class="mt-1 block w-full rounded border border-primary-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary-300" />
            </label>

            <label class="flex flex-col">
              <span class="text-sm font-medium">Asunto</span>
              <input name="asunto" type="text" class="mt-1 block w-full rounded border border-primary-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary-300" />
            </label>

            <label class="flex flex-col">
              <span class="text-sm font-medium">Mensaje</span>
              <textarea name="mensaje" rows="5" required class="mt-1 block w-full rounded border border-primary-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary-300"></textarea>
            </label>

            <div class="flex items-center justify-end gap-3">
              <button type="reset" class="px-4 py-2 rounded bg-primary-100 text-primary-900 hover:bg-primary-200">Limpiar</button>
              <button type="submit" class="px-4 py-2 rounded bg-primary-900 text-white hover:bg-primary-800">Enviar mensaje</button>
            </div>
          </div>
        </form>
      </section>
    </div>
  </div>
</BaseLayout>
