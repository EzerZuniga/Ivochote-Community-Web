---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlaceCard from '../../components/tourism/PlaceCard';
import { fetchPlaces } from '../../services/tourismService';
import type { TourismPlace } from '../../types/tourism';

const places = await fetchPlaces();
const sorted = places.slice().sort((a: TourismPlace, b: TourismPlace) => (a.order ?? 99) - (b.order ?? 99));
const featured = sorted.filter((p: TourismPlace) => p.featured);
---

<BaseLayout
  title="Turismo en Ivochote"
  description="Descubre los mejores destinos turísticos de Ivochote: Río Urubamba, bosques tropicales, comunidades nativas Matsigenka y plantaciones de café y cacao en la selva alta del Cusco, Perú."
  breadcrumbs={[{ name: 'Turismo', href: '/turismo' }]}
  pageType="CollectionPage"
>
  <!-- Hero -->
  <div class="bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <nav class="flex items-center gap-2 text-sm text-white/50 mb-8" aria-label="Migas de pan">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <svg class="w-3 h-3 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span aria-current="page" class="text-white/80 font-medium">Turismo</span>
      </nav>

      <div class="flex items-start gap-4 mb-8">
        <div class="flex-shrink-0 bg-white/10 rounded-xl p-3.5" aria-hidden="true">
          <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-amber-400/80 mb-2 block">Selva Alta del Cusco</span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold leading-tight tracking-tight">
            Turismo en<br class="hidden sm:block"/> Ivochote
          </h1>
          <p class="mt-3 text-white/60 text-sm sm:text-base leading-relaxed max-w-lg">
            Naturaleza, cultura y gastronomía en la selva alta de La Convención. Un destino auténtico en el corazón del Cusco amazónico.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-4 border-t border-white/10 pt-6">
        <div>
          <p class="text-white/40 text-[10px] uppercase tracking-wider font-semibold mb-0.5">Atractivos</p>
          <p class="text-white font-bold">{sorted.length} destinos</p>
        </div>
        <div>
          <p class="text-white/40 text-[10px] uppercase tracking-wider font-semibold mb-0.5">Altitud</p>
          <p class="text-white font-bold">800 – 2 000 m</p>
        </div>
        <div>
          <p class="text-white/40 text-[10px] uppercase tracking-wider font-semibold mb-0.5">Mejor época</p>
          <p class="text-white font-bold">May – Sep</p>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-14">

    <!-- Destinos Destacados -->
    {featured.length > 0 && (
      <section aria-labelledby="destacados-heading">
        <div class="flex items-center gap-4 mb-6">
          <h2 id="destacados-heading" class="text-[11px] font-bold uppercase tracking-widest text-primary-900/40 whitespace-nowrap">
            Destinos Destacados
          </h2>
          <div class="h-px flex-1 bg-gray-100" aria-hidden="true"></div>
        </div>
        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 list-none" role="list">
          {featured.map((p: TourismPlace) => (
            <li>
              <PlaceCard place={p} href={`/turismo/${p.slug}`} />
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Todos los Destinos -->
    <section aria-labelledby="todos-heading">
      <div class="flex items-center gap-4 mb-6">
        <h2 id="todos-heading" class="text-[11px] font-bold uppercase tracking-widest text-primary-900/40 whitespace-nowrap">
          Todos los Destinos
        </h2>
        <div class="h-px flex-1 bg-gray-100" aria-hidden="true"></div>
      </div>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 list-none" role="list">
        {sorted.map((p: TourismPlace) => (
          <li>
            <PlaceCard place={p} href={`/turismo/${p.slug}`} />
          </li>
        ))}
      </ul>
    </section>

    <!-- Consejos de viaje -->
    <section class="bg-emerald-50 border border-emerald-100 p-6 sm:p-8" aria-labelledby="tips-heading">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 w-9 h-9 bg-emerald-600 flex items-center justify-center" aria-hidden="true">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div>
          <h2 id="tips-heading" class="text-sm font-extrabold text-emerald-900 uppercase tracking-widest mb-3">Consejos para tu visita</h2>
          <ul class="space-y-2 text-sm text-emerald-800">
            <li class="flex gap-2"><span class="text-emerald-500 font-bold mt-0.5">—</span> La mejor época para visitar es de mayo a septiembre, cuando las lluvias son menores.</li>
            <li class="flex gap-2"><span class="text-emerald-500 font-bold mt-0.5">—</span> Lleva siempre repelente de insectos, protector solar y agua potable.</li>
            <li class="flex gap-2"><span class="text-emerald-500 font-bold mt-0.5">—</span> Se recomienda contratar guías locales para el trekking en bosques.</li>
            <li class="flex gap-2"><span class="text-emerald-500 font-bold mt-0.5">—</span> Para visitar comunidades nativas, coordina con anticipación y respeta sus normas y costumbres.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-primary-950 text-white p-8 sm:p-10 flex flex-col sm:flex-row items-start sm:items-center gap-6 justify-between" aria-labelledby="cta-turismo-heading">
      <div>
        <h2 id="cta-turismo-heading" class="text-lg sm:text-xl font-extrabold mb-1">¿Planeas visitar Ivochote?</h2>
        <p class="text-white/60 text-sm max-w-md">Contáctanos para orientarte sobre acceso, alojamiento y guías locales disponibles en la zona.</p>
      </div>
      <a
        href="/contacto"
        class="flex-shrink-0 inline-flex items-center gap-2 bg-amber-400 hover:bg-amber-300 text-amber-900 font-bold text-sm px-6 py-3 transition-colors duration-200"
      >
        Contáctanos
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </section>

  </div>
</BaseLayout>
