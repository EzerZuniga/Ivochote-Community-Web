---
// Lugar individual - dinámico
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPlaces } from '../../lib/api';

export async function getStaticPaths() {
  const all = await getPlaces();
  return all.map((i) => ({ params: { lugar: i.slug } }));
}

const { params } = Astro;
const all = await getPlaces();
const item = all.find(i => i.slug === params.lugar);
if (!item) {
  throw new Error('Lugar no encontrado');
}
---
<BaseLayout>
  <div class="max-w-5xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-4">{item.name}</h1>
    <p class="text-sm text-gray-600 mb-6">{item.description}</p>
  </div>
</BaseLayout>
