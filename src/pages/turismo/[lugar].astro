---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchPlaces, fetchPlaceBySlug } from '../../services/tourismService';

export async function getStaticPaths() {
  const all = await fetchPlaces();
  return all.map((p) => ({ params: { lugar: p.slug } }));
}

const { lugar } = Astro.params;
const item = await fetchPlaceBySlug(lugar!);
if (!item) {
  throw new Error('Lugar no encontrado');
}
---

<BaseLayout
  title={item.name}
  description={item.description}
  image={item.images?.[0]}
  breadcrumbs={[
    { name: 'Turismo', href: '/turismo' },
    { name: item.name, href: `/turismo/${lugar}` },
  ]}
  place={{
    name: item.name,
    description: item.fullDescription ?? item.description,
    image: item.images?.[0],
    latitude: item.coordinates?.lat,
    longitude: item.coordinates?.lng,
    location: item.location,
    category: item.category,
  }}
>
  <div class="max-w-4xl mx-auto px-4 py-10">
    <nav class="text-sm text-primary-900/50 mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-primary-700 transition-colors">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/turismo" class="hover:text-primary-700 transition-colors">Turismo</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-primary-900 font-medium truncate" aria-current="page">{item.name}</li>
      </ol>
    </nav>

    {item.images?.[0] && <img src={item.images[0]} alt={item.name} class="w-full h-72 object-cover rounded-lg mb-6" width="896" height="288" loading="eager" decoding="async" fetchpriority="high" />}

    <h1 class="text-3xl font-bold mb-2">{item.name}</h1>

    <div class="flex flex-wrap gap-2 mb-4">
      <span class="text-xs bg-primary-100 text-primary-900 px-2 py-1 rounded-full capitalize">{item.category}</span>
      {item.difficulty && <span class="text-xs bg-primary-50 text-primary-700 px-2 py-1 rounded-full">Dificultad: {item.difficulty}</span>}
      {item.duration && <span class="text-xs bg-primary-50 text-primary-700 px-2 py-1 rounded-full">Duración: {item.duration}</span>}
    </div>

    {item.location && <p class="text-sm text-primary-900/50 mb-4">📍 {item.location}</p>}

    <div class="prose dark:prose-invert max-w-none">
      <p>{item.fullDescription ?? item.description}</p>
    </div>

    {item.bestSeason && item.bestSeason.length > 0 && (
      <div class="mt-6 p-4 bg-primary-100 rounded-lg">
        <h3 class="font-semibold text-sm mb-2">Mejor época para visitar</h3>
        <p class="text-sm text-primary-900/60 capitalize">{item.bestSeason.join(', ')}</p>
      </div>
    )}

    {item.tags && item.tags.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-2">
        {item.tags.map(tag => (
          <span class="bg-primary-50 text-primary-700 text-xs px-2 py-1 rounded-full">{tag}</span>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
