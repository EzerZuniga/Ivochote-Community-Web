---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/common/Breadcrumbs.astro";
import { fetchPlaces } from "../../services/tourismService";
import type { TourismPlace } from "../../types/tourism";

export async function getStaticPaths() {
  const all = await fetchPlaces();
  return all.map((place) => ({
    params: { slug: place.slug },
    props: { item: place, slug: place.slug },
  }));
}

interface Props {
  item: TourismPlace;
  slug: string;
}

const { item, slug } = Astro.props as Props;

const ICON_PATHS: Record<string, string> = {
  river:     "M3 12c3-4 6-4 9 0s6 4 9 0M3 6c3-4 6-4 9 0s6 4 9 0M3 18c3-4 6-4 9 0s6 4 9 0",
  forest:    "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M9 7h.01M15 11h.01M12 3l3 6H9l3-6z",
  coffee:    "M18 8h1a4 4 0 010 8h-1M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8zm4-7v3m4-3v3m4-3v3",
  community: "M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z",
  thermal:   "M13 10h-2V3l-7 11h6v7l7-11h-4zM9 2a1 1 0 011-1h4a1 1 0 010 2h-4a1 1 0 01-1-1z",
};

const HERO_GRADIENT: Record<string, string> = {
  naturaleza:  "from-emerald-800 to-primary-950",
  gastronomia: "from-amber-800 to-primary-950",
  cultura:     "from-primary-800 to-primary-950",
  aventura:    "from-rose-800 to-primary-950",
};

const CATEGORY_ACCENT: Record<string, string> = {
  naturaleza:  "bg-emerald-600",
  gastronomia: "bg-amber-500",
  cultura:     "bg-primary-600",
  aventura:    "bg-rose-500",
};

const DIFFICULTY_LABEL: Record<string, string> = {
  baja: "Fácil", media: "Media", alta: "Alta",
};

const iconPath = ICON_PATHS[item.icon ?? ""] ?? ICON_PATHS["forest"];
const heroGradient = HERO_GRADIENT[item.category] ?? HERO_GRADIENT.naturaleza;
const accentClass = CATEGORY_ACCENT[item.category] ?? CATEGORY_ACCENT.naturaleza;
---

<BaseLayout
  title={item.name}
  description={item.description}
  image={item.images?.[0]}
  breadcrumbs={[
    { name: "Turismo", href: "/turismo" },
    { name: item.name, href: `/turismo/${slug}` },
  ]}
  place={{
    name: item.name,
    description: item.fullDescription ?? item.description,
    image: item.images?.[0],
    latitude: item.coordinates?.lat,
    longitude: item.coordinates?.lng,
    location: item.location,
    category: item.category,
  }}
>
  <!-- Hero -->
  <div class={`bg-gradient-to-br ${heroGradient} text-white`}>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <Breadcrumbs
        items={[
          { href: "/", label: "Inicio" },
          { href: "/turismo", label: "Turismo" },
          { label: item.name },
        ]}
      />

      <div class="flex flex-col sm:flex-row items-start gap-6">
        <div class="flex-shrink-0 w-16 h-16 bg-white/15 border border-white/20 flex items-center justify-center shadow-md">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d={iconPath}/>
          </svg>
        </div>
        <div>
          <span class="inline-block text-[10px] font-extrabold uppercase tracking-widest px-2.5 py-0.5 bg-white/15 border border-white/20 text-white/90 mb-3">
            {item.category}
          </span>
          <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight tracking-tight">{item.name}</h1>
          {item.location && (
            <p class="mt-3 flex items-center gap-2 text-sm text-white/60">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              {item.location}
            </p>
          )}
        </div>
      </div>

      <!-- Meta chips -->
      <div class="flex flex-wrap gap-3 mt-6">
        {item.difficulty && (
          <div class="flex items-center gap-1.5 text-xs text-white/70 bg-white/10 px-3 py-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            Dificultad: {DIFFICULTY_LABEL[item.difficulty] ?? item.difficulty}
          </div>
        )}
        {item.duration && (
          <div class="flex items-center gap-1.5 text-xs text-white/70 bg-white/10 px-3 py-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            {item.duration}
          </div>
        )}
        {item.bestSeason && item.bestSeason.length > 0 && (
          <div class="flex items-center gap-1.5 text-xs text-white/70 bg-white/10 px-3 py-1.5 capitalize">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Mejor época: {item.bestSeason.join(', ')}
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Contenido -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12 space-y-5">

    <!-- Descripción -->
    {(item.fullDescription ?? item.description) && (
      <section class="bg-white border border-gray-200 shadow-sm p-6 sm:p-8">
        <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-3">Sobre este destino</h2>
        <p class="text-gray-700 leading-relaxed">{item.fullDescription ?? item.description}</p>
      </section>
    )}

    <!-- Consejo + Tags -->
    <div class="grid gap-5 sm:grid-cols-2">
      {item.tips && (
        <section class="bg-white border border-gray-200 shadow-sm p-6">
          <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-4">Consejos del visitante</h2>
          <div class="flex items-start gap-3">
            <div class={`w-7 h-7 ${accentClass} flex items-center justify-center flex-shrink-0 mt-0.5`} aria-hidden="true">
              <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <p class="text-sm text-gray-600 leading-relaxed">{item.tips}</p>
          </div>
        </section>
      )}

      {item.tags && item.tags.length > 0 && (
        <section class="bg-white border border-gray-200 shadow-sm p-6">
          <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-4">Etiquetas</h2>
          <div class="flex flex-wrap gap-2">
            {item.tags.map((tag: string) => (
              <span class={`text-xs font-semibold px-2.5 py-1 border border-gray-200 text-gray-600 capitalize`}>{tag}</span>
            ))}
          </div>
        </section>
      )}
    </div>

    <!-- Contacto -->
    {item.contact?.phone && (
      <section class="bg-primary-950 text-white p-6 sm:p-8 shadow-sm">
        <h2 class="text-[11px] font-bold uppercase tracking-widest text-white/40 mb-4">¿Necesitas información?</h2>
        <a href={`tel:${item.contact.phone}`} class="inline-flex items-center gap-3 text-sm group">
          <div class="w-9 h-9 bg-white/10 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <span class="text-white/80 group-hover:text-white transition-colors font-medium">{item.contact.phone}</span>
        </a>
      </section>
    )}

    <div class="pt-2">
      <a href="/turismo" class="inline-flex items-center gap-2 text-sm font-bold text-primary-700 hover:text-primary-500 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Volver a Turismo
      </a>
    </div>

  </div>
</BaseLayout>
